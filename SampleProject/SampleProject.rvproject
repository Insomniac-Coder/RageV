Project:
  Name: Sample
  AssetDirectory: assets
  StartScene: scenes/showroom.rage
  FixedHz: 60
  RenderSettings:
    AntiAliasing: TAA
    MsaaSamples: 4
    SupersampleFactor: 2
    TemporalFeedback: 0.9
    TemporalJitterScale: 1
    TemporalJitterPhase: 8
    ShadowsEnabled: true
    RayTracing: true
    RayTracedReflections: High
    RayTracedAmbientOcclusion: Full
    RayTracedGlobalIllumination: High
    RayTracedWaterRefraction: true
    RayTracedGiSource: Baked
    RtOptimisation: Quality
    RayCostShadow: 0.4
    RayCostWater: 0.77
    RayCostReflection: 3.62
    RayCostGi: 0
    RayCostAo: 0.12
    RayBudget: Fractional
    RayBudgetMs: 4
    RayBudgetFraction: 0.4
    ShadowDistance: 40
    ShadowSplitLambda: 0.85
    ShadowNormalOffset: 0.9
    ShadowCascades: 4
    ShadowResolution: 2048