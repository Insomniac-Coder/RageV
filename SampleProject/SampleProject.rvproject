Project:
  Name: Sample
  AssetDirectory: assets
  StartScene: scenes/camp.rage
  FixedHz: 60
  RenderSettings:
    AntiAliasing: TAA
    MsaaSamples: 4
    SupersampleFactor: 2
    TemporalFeedback: 0.9
    TemporalJitterScale: 1
    TemporalJitterPhase: 8
    ShadowsEnabled: true
    RayTracing: true
    RayTracedReflections: High
    RayTracedAmbientOcclusion: Half
    RayTracedGlobalIllumination: Medium
    ShadowDistance: 40
    ShadowSplitLambda: 0.85
    ShadowNormalOffset: 0.9
    ShadowCascades: 4
    ShadowResolution: 2048