// One face of a diffuse irradiance cube, convolved from an environment.
//
// There is already a CPU convolution of this integral, in Cubemap.cpp, and it
// stays: it runs when a cubemap asset is loaded, it can be checked by the test
// suite, and it gives both backends the same answer because it reaches
// neither. What it cannot do is a reflection probe. A probe's capture exists
// only on the GPU, and reading six faces back to spend 200 ms convolving them
// would be 200 ms of stall per probe -- so a probe had no irradiance at all,
// and a metal object near one reflected the probe while the diffuse half of
// the same surface was still lit by the sky.
//
// Deliberately the same normalisation as the CPU version: the cosine-weighted
// *average* of the incoming radiance, not the integral. Cosine-importance
// sampling makes that the plain mean of the samples, because the cosine
// weight and the sampling density cancel. Getting this wrong by a factor of pi
// is invisible on a probe seen alone and obvious the moment one sits beside a
// sky-lit surface.

#type vertex
#version 450 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 450 core

const float PI = 3.14159265359;

layout(location = 0) in vec2 v_UV;
layout(location = 0) out vec4 o_Color;

layout(set = 0, binding = 0) uniform samplerCube u_Source;

// The same block the prefilter shader takes, field for field, so one C++
// struct feeds both and the face table cannot drift between them.
layout(push_constant) uniform Params
{
	vec4 Axis;
	vec4 Right;
	vec4 Up;
	// x unused (roughness has no meaning here), y = the source's face size,
	// z = sample count
	vec4 Settings;
} u_Params;

float RadicalInverse(uint bits)
{
	bits = (bits << 16u) | (bits >> 16u);
	bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
	bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
	bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
	bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
	return float(bits) * 2.3283064365386963e-10;
}

// Cosine-distributed about N. Malley's method: a uniform point on the disc
// lifted onto the hemisphere gives exactly the cosine density, with no
// trigonometry beyond one sqrt.
vec3 CosineSample(vec2 random, vec3 N)
{
	float phi = 2.0 * PI * random.x;
	float cosTheta = sqrt(max(1.0 - random.y, 0.0));
	float sinTheta = sqrt(random.y);

	vec3 local = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);

	vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
	vec3 tangent = normalize(cross(up, N));
	vec3 bitangent = cross(N, tangent);

	return normalize(tangent * local.x + bitangent * local.y + N * local.z);
}

void main()
{
	float s = 2.0 * v_UV.x - 1.0;
	float t = 2.0 * v_UV.y - 1.0;

	vec3 N = normalize(u_Params.Axis.xyz + u_Params.Right.xyz * s + u_Params.Up.xyz * t);

	float faceSize = max(u_Params.Settings.y, 1.0);
	int samples = int(max(u_Params.Settings.z, 1.0));

	// An irradiance face is 16 texels a side and each one integrates a whole
	// hemisphere, so there is no detail in the source worth resolving. Reading
	// from a blurred mip removes the fireflies a few hundred samples would
	// otherwise leave, and costs nothing that survives the integral anyway.
	float mip = max(log2(faceSize) - 3.0, 0.0);

	vec3 sum = vec3(0.0);

	for (int i = 0; i < samples; ++i)
	{
		vec2 random = vec2(float(i) / float(samples), RadicalInverse(uint(i)));
		vec3 L = CosineSample(random, N);

		sum += textureLod(u_Source, L, mip).rgb;
	}

	o_Color = vec4(sum / float(samples), 1.0);
}
