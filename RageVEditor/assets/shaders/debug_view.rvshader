// **The debug view: one number per pixel, as a heat map** (WR-16 S0,
// `--debug-view=rays|lights|confidence|importance`).
//
// The owner's multi-light document asks for these before any budget is
// built: rays cast per pixel, lights walked per pixel, the temporal
// resolve's confidence, the budget's importance. A mean over the frame says
// the water costs 146 rays a pixel; this shows *which* pixels, and whether
// the hot band is the glitter or the deck's underside. Drawn over the
// tone-mapped frame at a fifth of its brightness, so the map keeps its
// geography.
//
// The per-pixel counts come from the buffer the lit shaders add into under
// RV_DEBUG_VIEW (pbr_fragment.glsl, DebugCountsStore): a header of width,
// height and pixel count, then one word per pixel of rays and one of lights.
// Confidence and importance read a texture instead -- the temporal
// history's second attachment (validity in .w) and the ray budget's
// tile map, whose .r is the AO rays a tile was given and whose .g is the
// bounce's. **The two lanes are allocated separately and can be restless
// separately** (WR-16 S3), so `importance-gi` exists and the sixty-second
// still test grades one lane at a time; a judge reading only the first
// cannot see half of what it is grading.

#type vertex
#version 450 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 450 core

layout(location = 0) in vec2 v_UV;
layout(location = 0) out vec4 o_Color;

// The tone-mapped frame, dimmed underneath.
layout(set = 0, binding = 0) uniform sampler2D u_Frame;
// The auxiliary texture the texture-backed modes read: the temporal moments
// (confidence) or the ray budget's tile map (importance). Black when the
// mode has none or the source is not running this frame.
layout(set = 0, binding = 1) uniform sampler2D u_Aux;
// **RT-12: the same lane, last frame.** Only the direction-difference
// view reads it; every other view leaves it bound to black. Binding 2
// is Dispatch's velocity slot, which this pass has never used.
layout(set = 0, binding = 2) uniform sampler2D u_AuxPrev;
// The per-pixel counts (rays, lights). Bound at the post-process passes'
// storage slot; read only here.
layout(std430, set = 0, binding = 5) readonly buffer DebugCountBlock
{
	uint Width;
	uint Height;
	uint Pixels;
	uint _pad;
	uint Counts[];
} u_DebugCounts;

layout(push_constant) uniform Params
{
	vec2  TexelSize;
	// Which lane of the counts buffer, when FromCounts says to read it:
	// 0 rays, 1 lights. Meaningless otherwise.
	float Mode;
	// The value that maps to the top of the ramp.
	float Scale;
	// Whether u_Aux holds this frame's source at all.
	float AuxValid;
	float FlipY;
	// **How much of the scene shows through** (`--debug-view-mix`). A fifth
	// by default, because a map with no geography is unreadable by a person.
	// Zero is for a machine: at any other value a pixel's colour moves when
	// the *scene* moves, and a test that counts changed pixels then counts
	// the animation instead of the thing it is grading. The sixty-second
	// still test read 21 changes per tile per second with a dwell that
	// allowed at most 2 before this existed.
	float FrameMix;
	// **RT-12: what to do, rather than which view this is.**
	//
	// This pass used to decide how to display a number by testing the
	// view's ordinal, and the test was wrong for three of fourteen views
	// -- silently, because a heat map has no obviously correct picture to
	// be compared against. An ordinal is not a property of a view; the
	// channel and the display are, and the frame graph knows both.
	//
	// Display: 0 ramp, 1 picture (rgb over the scale, straight out),
	//          2 two colours (kept or refused), 3 a vector in rg,
	//          4 an octahedral normal in rg.
	// Channel: 0 r, 1 g, 2 b, 3 a, 4 the standard deviation the second
	//          and first moments in g and b describe.
	float Display;
	float Channel;
	// Whether the value comes from the counts buffer rather than u_Aux.
	float FromCounts;
	// Whether the ramp is logarithmic (--debug-view-log).
	float LogRamp;
} u_Params;

// The G-buffer's octahedral decode, for the normal display. Local, as
// it is in every other pass that needs two lines of it.
vec3 DecodeOct(vec2 e)
{
	// **The engine's encoding is [0,1]^2, not [-1,1]^2** -- see
	// include/octahedral.glsl, whose OctEncode ends `e * 0.5 + 0.5`. This
	// copy omitted the matching `e * 2 - 1` and read the square through the
	// wrong fold. Kept local rather than included, for the reason the original
	// gives (no lighting header for four lines of arithmetic) -- but now it is
	// the same four lines.
	e = e * 2.0 - 1.0;
	vec3 n = vec3(e.xy, 1.0 - abs(e.x) - abs(e.y));
	if (n.z < 0.0)
		n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0,
										n.y >= 0.0 ? 1.0 : -1.0);
	return normalize(n);
}

// A dark-to-bright ramp with distinct hues per band, so a number is read off
// by colour rather than by brightness alone: black, blue, cyan, green,
// yellow, red, white.
vec3 Ramp(float t)
{
	t = clamp(t, 0.0, 1.0);
	const vec3 stops[7] = vec3[7](
		vec3(0.0, 0.0, 0.0), vec3(0.1, 0.1, 0.8), vec3(0.0, 0.7, 0.9),
		vec3(0.1, 0.8, 0.2), vec3(0.95, 0.9, 0.1), vec3(0.95, 0.2, 0.1),
		vec3(1.0, 1.0, 1.0));
	const float scaled = t * 6.0;
	const int band = int(min(floor(scaled), 5.0));
	return mix(stops[band], stops[band + 1], scaled - float(band));
}

void main()
{
	// The destination row this fragment writes and the source row v_UV
	// names are the same row on OpenGL and opposite rows on Vulkan. See
	// PostProcess::Dispatch.
	const vec2 uv = vec2(v_UV.x, u_Params.FlipY > 0.5 ? 1.0 - v_UV.y : v_UV.y);
	const vec3 frame = texture(u_Frame, uv).rgb;

	const float scale = max(u_Params.Scale, 1.0e-6);
	const int display = int(u_Params.Display + 0.5);
	float value = 0.0;
	bool known = true;

	if (u_Params.FromCounts > 0.5)
	{
		// The counts are at the scene target's size, which under SSAA is
		// not the output's: address by fraction, not by fragment.
		const int lane = int(u_Params.Mode + 0.5);
		const uvec2 px = uvec2(clamp(uv, vec2(0.0), vec2(0.9999))
							   * vec2(u_DebugCounts.Width, u_DebugCounts.Height));
		const uint index = px.y * u_DebugCounts.Width + px.x;
		if (index < u_DebugCounts.Pixels)
			value = float(u_DebugCounts.Counts[(lane == 1 ? u_DebugCounts.Pixels : 0u) + index]);
	}
	else
	{
		known = u_Params.AuxValid > 0.5;
		const vec4 aux = texture(u_Aux, uv);

		// The three displays that write a colour rather than a number, and
		// none of them takes the frame underneath: a picture, a direction and
		// a normal are measurements to be read on their own.
		if (display == 1)
		{
			o_Color = vec4(known ? aux.rgb / scale : vec3(0.0), 1.0);
			return;
		}
		if (display == 3)
		{
			// A signed pair about grey, so zero motion is flat and the two
			// directions of each axis are distinguishable.
			const vec2 v = clamp(aux.rg / scale, vec2(-1.0), vec2(1.0));
			o_Color = vec4(known ? vec3(0.5 + 0.5 * v.x, 0.5 + 0.5 * v.y, 0.5)
								 : vec3(0.0), 1.0);
			return;
		}
		if (display == 4)
		{
			const vec3 n = DecodeOct(aux.rg);
			o_Color = vec4(known ? 0.5 + 0.5 * n : vec3(0.0), 1.0);
			return;
		}
		// **RT-12: the reflection direction** (specification §11), stored
		// octahedrally in zw by the accumulator. About grey, so the three
		// axes are readable and a flat surface reads as one colour.
		if (display == 5)
		{
			const vec3 r = DecodeOct(aux.zw);
			o_Color = vec4(known ? 0.5 + 0.5 * r : vec3(0.0), 1.0);
			return;
		}

		const int channel = int(u_Params.Channel + 0.5);
		value = channel == 0 ? aux.r
			  : channel == 1 ? aux.g
			  : channel == 2 ? aux.b
			  : channel == 3 ? aux.a
				// The moments: E[x^2] - E[x]^2, floored at zero because a
				// half float's rounding can make a converged pixel's variance
				// very slightly negative.
				: sqrt(max(aux.b - aux.g * aux.g, 0.0));

		// **RT-12: how far the reflection direction swung since last
		// frame** -- `1 - dot(R_now, R_prev)`, the specification's
		// `reflectionDifference`, from two stored vectors. This is the
		// quantity RT-6.3 shortens the memory by, and the one no surface
		// test can see: on a mirror the camera orbits, every other test
		// passes and this is the only thing that moved.
		if (display == 6)
			value = 1.0 - dot(DecodeOct(aux.zw),
							  DecodeOct(texture(u_AuxPrev, uv).zw));

		// Two colours: the ramp's top where the history was kept and its red
		// where it was not. Zero means kept, in the accumulator's encoding and
		// now in the resolve's too, so the test is against zero rather than
		// against a validity flag that no longer exists.
		if (display == 2)
			value = value < 0.5 ? scale : scale * (5.0 / 6.0);
	}

	float t = known ? value / scale : 0.0;
	// **The logarithmic ramp** (--debug-view-log). A frame count, a ray count
	// and a radiance all have their interesting range in the bottom decade,
	// and a linear ramp spends six of its seven bands above it. Anchored so
	// zero stays zero and one stays one, which keeps the two ramps readable
	// against each other.
	if (u_Params.LogRamp > 0.5)
		t = log2(1.0 + 31.0 * clamp(t, 0.0, 1.0)) / 5.0;
	// A zero stays the frame, dimmed, so "no rays here" reads as the scene
	// and not as the ramp's black -- unless nothing is mixed in, where a
	// zero has to read as black or it is not a measurement.
	const float mix = clamp(u_Params.FrameMix, 0.0, 1.0);
	const vec3 heat = t > 0.0 ? Ramp(t) : vec3(0.0);
	o_Color = vec4(frame * mix + heat * (1.0 - mix), 1.0);
}
