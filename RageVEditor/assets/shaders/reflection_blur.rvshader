// **The accumulated reflection, blurred by how little history it has.**
//
// The accumulator trusts a history only while there is evidence for it, so
// under motion a pixel holds one to four frames of a few rays: grainy on a
// rough floor, a single jittered sample on chrome. Standing still it holds
// twenty-four and is clean. This pass sits between the accumulator and the
// composite and averages each pixel with its neighbours on the same
// reflector by a radius that shrinks with the frames behind it -- wide at
// one frame, nothing at sixteen -- so the grain is smoothed across space
// exactly while it cannot be smoothed across time, and the picture goes
// sharp again as the history rebuilds. Nothing old is mixed in: it reads
// this frame's accumulated picture only, so it cannot smear. The
// accumulator never sees the blurred picture; its history stays sharp.
//
// RT_Temporal_Reconstruction design (2026-09-06), section 5's spatial
// denoise after the temporal pass, the shape every production reflection
// denoiser has: pre-blur, accumulate, post-blur by history length.
#type vertex
#version 460 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 460 core

#define RV_TRACE_ONLY
#include "include/pbr_fragment.glsl"

layout(location = 0) in vec2 v_UV;

// The accumulator's picture: rgb the radiance, a the frames behind it, zero
// where nothing glossy stood.
layout(set = 3, binding = 0) uniform sampler2D u_Accumulated;
layout(set = 3, binding = 1) uniform sampler2D u_Depth;
// The scene's surface: normal (octahedral, zero to one), roughness in b.
layout(set = 3, binding = 2) uniform sampler2D u_Surface;
// The reflection history's second attachment: its .a is the image
// distance the accumulator placed the picture at (-1 none), the hit
// distance that bounds the blur below.
layout(set = 3, binding = 3) uniform sampler2D u_ImageDistance;
#ifdef RV_SIGNAL_PAIR
layout(set = 3, binding = 4) uniform sampler2D u_Accumulated2;   // the twin, same weights
#endif
#if !defined(RV_SIGNAL_PAIR) && !defined(RV_SIGNAL_DIFFUSE)
// **RT-15: the accumulator's third attachment**, whose alpha carries 8 above its
// choice-and-refusal code where the reflector is curved and moves on its own
// (reflection_accumulate.rvshader, kMovingCurvedMark). Black where none is bound.
layout(set = 3, binding = 5) uniform sampler2D u_Extra;
#if !defined(RV_SIGNAL_PAIR) && !defined(RV_SIGNAL_DIFFUSE)
// The uncertainty the previous pass left; black on the first, which reads the
// accumulator's moments instead (u_Reflection.Tuning.w says which).
layout(set = 3, binding = 6) uniform sampler2D u_VarianceIn;
// **How many frames the picture was actually blended over (2026-09-21).**
//
// Not the same number as the picture's alpha. On the reflections that alpha is
// the lit shader's trust in this picture against its probe, and the accumulator
// deliberately holds it steady through a restart so a light change does not bring
// the old probe capture back. The count the blend really ran on is kept in the id
// lane's green instead -- and this pass was reading the alpha. So a pixel whose
// history had just been cut to a single frame by the anti-lag was handed to the
// filter as fully converged, the young ramp read zero, and the one place that most
// needed smoothing got none. Zero here means the count was never written (the
// measured-change pass was off), and the alpha stands in.
layout(set = 3, binding = 7) uniform sampler2D u_BlendCount;
#endif
#endif

layout(push_constant) uniform ReflectionParams
{
	mat4 InverseViewProjection;
	mat4 PreviousViewProjection;
	// y: the frames at which the blur has faded to nothing. w: one where a
	// texture row runs the other way up from a projected coordinate.
	vec4 History;
	vec4 Probe;
	vec4 Tuning;
	// The young-history blur's tuning (RT-first T4, Renderer3D::SignalParams):
	// x the radius at one frame of history, y the frames at which it has
	// faded to nothing, z how far past the lobe's footprint it may reach
	// while young (specular), w the radius bound in texels (diffuse) -- and on
	// the specular kind, RT-15, the radius at one frame where the texel is marked
	// a curved reflector moving on its own.
	vec4 Blur;
	// **Declared because the block is pushed whole, not because this pass
	// reads them.** `BlurSignal` pushes `sizeof(SignalPushConstants)`, and a
	// layout shorter than what is pushed is a validation error against every
	// draw that follows -- this pass declared six of the eight vectors and had
	// been overrun by sixteen bytes since the eye lane was added, silently
	// unless a run asks for --validation=on. Two dead lanes cost nothing; a
	// short layout costs the command buffer.
	vec4 PreviousEye;
	// Measured change: the accumulate's, pushed whole with the rest.
	vec4 Change;
} u_Reflection;

layout(location = 0) out vec4 o_Blurred;
#ifdef RV_SIGNAL_PAIR
layout(location = 1) out vec4 o_Blurred2;
#elif !defined(RV_SIGNAL_DIFFUSE)
// **The uncertainty this pass leaves behind (2026-09-21).** Filtered with the
// square of the weights the colour was filtered with, which is what an average
// of n values does to their variance, and read by the next pass in place of the
// accumulator's raw moments. Without it the second and third passes judge a
// picture they have already smoothed against the noise of the one they started
// from: every tap then looks like an outlier, the weights collapse, and the two
// wider passes do nothing -- which is half of why widening the blur never
// worked here.
layout(location = 1) out float o_Variance;
#endif

// **WR-16 R12 (2026-09-06): the blur is the short history's partner.** Its
// radius comes from how few frames stand behind the texel -- kYoungRadius
// texels at one frame, nothing at kBlurFrames -- so a picture that just
// started (after a move, or while moving under the smear cap) is soft but
// stable instead of grainy, and sharpens as the frames arrive. The radius
// is bounded per axis by the lobe's footprint on the surface (a chrome
// pole is never blurred past its own lobe; a foreshortened floor blurs
// less across than along) and by the gloss window; three passes at
// strides 1, 2, 4 reach it with seven taps each. The accumulator's own
// history is never blurred: this reads it and writes the composite's
// input, so there is no feedback and nothing here can smear over time.
const int kMaxRadius = 3;
#define kYoungRadius (u_Reflection.Blur.x)
// While the history is young the blur may reach past the lobe's footprint
// by this factor (young squared times it): a moving picture blurred wider
// than its lobe is soft; the same picture at six frames of history is
// noise, and the owner saw the noise (2026-09-06 night, first R12 build:
// the footprint bound and a gloss window kept the floor's blur at two to
// four texels, "very noisy").
#define kYoungOverreach (u_Reflection.Blur.z)
#define kBlurFrames (u_Reflection.Blur.y)
const float kLobeWidth = 2.8;
const float kPassShare = 0.57735;   // three passes share the variance
// **How far a luminance difference may stand from the centre before a tap stops
// counting**, in standard deviations of the centre's own uncertainty (SVGF's
// sigma_l). Four is the paper's figure and the one every implementation since has
// kept: at four sigma a tap that differs by noise still counts, and a tap that
// differs because the picture genuinely changes there does not. This is the weight
// that makes a wide blur safe -- without it, widening the radius is the choice
// between grain and mush that the young blur was retired for.
const float kSigmaL = 4.0;
// The floor under that scale, so a texel whose samples all agree does not divide
// by nothing and reject every neighbour.
const float kSigmaLFloor = 1.0e-3;

// **RT-8: and the same surface from a layer that knows where it is.** The
// contract rebuilds P from the depth buffer, which assumes the signal it is
// filtering sits on a surface the depth buffer describes. The sea does not:
// water writes no depth, and the buffer under it holds the seabed and the
// pier, so every test here would have been asking about the wrong surface.
// That, and not the plane test, was what kept the sea out of the contract.
//
// The sea does know its own position -- it writes it in full floats, because
// a bay is a kilometre across -- so the depth binding takes a second meaning
// rather than a second binding: **Probe.w is one when what is bound at the
// depth slot is a position-and-mask lane, xyz the world point and w the mask.**
// That is not a workaround for the sea; it is the more exact of the two, and
// any future layer with a position of its own can take the same route.
// A bitfield, not a flag: a layer describes itself in one number.
bool PositionLane() { return (int(u_Reflection.Probe.w + 0.5) & 1) != 0; }
bool UpNormalLane() { return (int(u_Reflection.Probe.w + 0.5) & 2) != 0; }

// **RT-8: how this layer encodes a normal.** Octahedral for the G-buffer, and
// two horizontal components with the vertical recovered for the sea -- whose
// normal always points up, so nothing is lost and nothing is quantised. That
// is the better encoding for a sea and a different one from the rest of the
// frame, and reading one as the other is silent: the lobe simply points
// somewhere it should not. Measured when it was: the sea's mid-tones a seventh
// dimmer and its highlight a third narrower.
vec3 DecodeSurfaceNormal(vec2 e)
{
	if (UpNormalLane())
		return vec3(e.x, sqrt(max(1.0 - dot(e, e), 0.0)), e.y);
	return OctDecode(e);
}

bool SurfaceAt(ivec2 texel, ivec2 size, out vec3 P, out vec3 N, out float roughness)
{
	const vec4 surface = texelFetch(u_Surface, texel, 0);
	const vec4 depthLane = texelFetch(u_Depth, texel, 0);
	if (PositionLane())
	{
		// The layer's own point, and its mask where the depth test would be.
		if (surface.b <= 0.0 || depthLane.w <= 0.5)
			return false;
		P = depthLane.xyz;
		N = DecodeSurfaceNormal(surface.rg);
		roughness = clamp(surface.b, 0.0, 1.0);
		return true;
	}
	const float depth = depthLane.r;
	if (surface.b <= 0.0 || depth >= 1.0)
		return false;
	const vec2 uv = (vec2(texel) + 0.5) / vec2(size);
	const float row = u_Reflection.History.w > 0.5 ? 1.0 - uv.y : uv.y;
	const vec4 clip = u_Reflection.InverseViewProjection
					* vec4(uv.x * 2.0 - 1.0, row * 2.0 - 1.0, depth, 1.0);
	P = clip.xyz / clip.w;
	N = DecodeSurfaceNormal(surface.rg);
	roughness = clamp(surface.b, 0.0, 1.0);
	return true;
}

#if !defined(RV_SIGNAL_DIFFUSE) && !defined(RV_SIGNAL_PAIR)
// **What a texel's picture is still uncertain by.** The first pass has only the
// accumulator's two moments: the spread of the samples that made the average, over
// the count behind it. Every pass after reads what the pass before it left, which
// has been filtered along with the colour and so falls as the picture settles --
// which is the point of carrying it at all.
float VarianceAt(ivec2 at, float frames)
{
	if (u_Reflection.Tuning.w > 0.5)
		return max(texelFetch(u_VarianceIn, at, 0).r, 0.0);
	const vec4 e = texelFetch(u_Extra, at, 0);
	return max(e.b - e.g * e.g, 0.0) / max(frames, 1.0);
}
#endif

void main()
{
	const ivec2 texel = ivec2(gl_FragCoord.xy);
	const ivec2 size = textureSize(u_Accumulated, 0);
	const vec4 centre = texelFetch(u_Accumulated, texel, 0);
	o_Blurred = centre;
#ifdef RV_SIGNAL_PAIR
	const vec4 centre2 = texelFetch(u_Accumulated2, texel, 0);
	o_Blurred2 = centre2;
	vec3 sum2 = vec3(0.0);
#endif
	if (centre.a <= 0.0)
		return;

	vec3 P, N;
	float roughness;
	if (!SurfaceAt(texel, size, P, N, roughness))
		return;

#if !defined(RV_SIGNAL_PAIR) && !defined(RV_SIGNAL_DIFFUSE)
	// The real count, and the alpha only where none was written. See u_BlendCount.
	const float carried = texelFetch(u_BlendCount, texel, 0).g;
	const float frames = carried > 0.0 ? carried : centre.a;
#else
	const float frames = centre.a;
#endif
	const float young = 1.0 - clamp((frames - 1.0) / (kBlurFrames - 1.0), 0.0, 1.0);
#if !defined(RV_SIGNAL_DIFFUSE) && !defined(RV_SIGNAL_PAIR)
	// Carried even where this pass returns early, or the next one reads nothing.
	o_Variance = VarianceAt(texel, frames);
#endif
	// No gloss window here: the footprint bound below already says how
	// far a lobe allows; mirrors have no footprint and get no blur.
#if !defined(RV_SIGNAL_PAIR) && !defined(RV_SIGNAL_DIFFUSE)
	// **RT-15: and a radius of its own where the reprojection is approximate** --
	// a curved reflector moving on its own, whose short history is grain no other
	// frame can average away. Every other texel keeps kYoungRadius, which is zero
	// on the reflections, and is copied through untouched.
	const vec4 extra = texelFetch(u_Extra, texel, 0);
	const bool movingCurved = extra.a >= 7.75;
	float radius = max(kYoungRadius, movingCurved ? u_Reflection.Blur.w : 0.0) * young * young;
	// **RT-15: and only as much of it as the texel's own uncertainty asks for.**
	//
	// A young history is not the same thing as a noisy one. The accumulator already keeps the
	// two moments of what arrives (`extra.g`, `extra.b`), so the spread of a texel's samples is
	// known, and the error left in an average of `frames` of them is that spread over the root
	// of the count. Measured on the moving chrome cube at roughness 0.12 (frame 120, its face,
	// 8666 texels): that relative error is 0.011 at the quarter point, 0.030 at the middle,
	// 0.14 at three quarters and 0.24 at nine tenths -- and the bright bumps the owner saw sit
	// at 0.18 and above. So the radius fades in across 0.02 to 0.20: the settled parts of a
	// moving face keep their detail (which is what made the cube read blurry beside the chrome
	// bars), and the unsettled parts still get the whole of it.
	//
	// Not a substitute for the history's own ramp: `young` still gates it, so nothing with a
	// grown history is touched however noisy its samples are.
	// **The texel's own uncertainty, and the radius it asks for (2026-09-21).**
	//
	// The accumulator keeps two luminance moments per texel, so the spread of the
	// samples that made this average is known, and the error left in the average is
	// that spread over the root of the count. Two things were wrong with using it
	// only as a fade on a radius that was itself zero:
	//
	//  * **A short history's moments are not trustworthy.** Two or three samples
	//    tell you almost nothing about their own spread, which is exactly where the
	//    blur is needed. So where the count is low the moments of the 3x3 stand in,
	//    which is the estimate SVGF falls back on for the same reason.
	//  * **A settled texel can still be noisy.** The old radius was gated on `young`
	//    and on the moving-reflector mark, so a parked floor whose every texel had a
	//    full history and visible grain asked for nothing. Uncertainty does not care
	//    how many frames stand behind it.
	//
	// So: the uncertainty decides the radius, the history's own ramp only adds to it.
	float variance = 0.0;
	float relativeError = 0.0;
	{
		float mean = extra.g;
		float meanSq = extra.b;
		// Too few frames to believe the texel's own pair: take the neighbourhood's.
		if (frames < 4.0)
		{
			float sum = 0.0, sumSq = 0.0, count = 0.0;
			for (int y = -1; y <= 1; ++y)
			{
				for (int x = -1; x <= 1; ++x)
				{
					const ivec2 at = clamp(texel + ivec2(x, y), ivec2(0), size - 1);
					if (texelFetch(u_Accumulated, at, 0).a <= 0.0)
						continue;
					const vec4 e = texelFetch(u_Extra, at, 0);
					sum += e.g;
					sumSq += e.b;
					count += 1.0;
				}
			}
			if (count > 0.0)
			{
				mean = sum / count;
				meanSq = sumSq / count;
			}
		}
		// The spread of the samples, then the error left in their average.
		variance = max(meanSq - mean * mean, 0.0) / max(frames, 1.0);
		relativeError = sqrt(variance) / max(mean, 1.0e-3);
	}
	if (u_Reflection.History.z > 0.5)
	{
		// The same fade as before, no longer behind the young ramp or the moving
		// mark: the reach is what the uncertainty asks for, and a settled texel
		// with no spread asks for nothing and is copied through untouched.
		radius = max(radius, u_Reflection.Blur.w * smoothstep(0.02, 0.20, relativeError));
	}
	else if (radius > 0.0)
	{
		const float mean = max(extra.g, 1.0e-3);
		const float spread = sqrt(max(extra.b - extra.g * extra.g, 0.0));
		radius *= smoothstep(0.02, 0.20, spread / (sqrt(max(frames, 1.0)) * mean));
	}
#else
	float radius = kYoungRadius * young * young;
	const float variance = 0.0;
#endif
	if (radius < 0.5)
		return;

	// The lobe's footprint per axis, in texels, as the resolve measures it.
	const float eyeDistance = length(P - u_Scene.CameraPosition.xyz);
	const float imageDistance = max(texelFetch(u_ImageDistance, texel, 0).a, 0.0);
	const float footprint = imageDistance * kLobeWidth * roughness * roughness;
	vec2 texelSize = vec2(eyeDistance * 0.0015);
	{
		vec3 Pn, Nn;
		float rn;
		float best = 1e9;
		if (SurfaceAt(clamp(texel + ivec2(1, 0), ivec2(0), size - 1), size, Pn, Nn, rn)) best = min(best, length(Pn - P));
		if (SurfaceAt(clamp(texel - ivec2(1, 0), ivec2(0), size - 1), size, Pn, Nn, rn)) best = min(best, length(Pn - P));
		if (best < 1e8) texelSize.x = max(best, eyeDistance * 0.0002);
		best = 1e9;
		if (SurfaceAt(clamp(texel + ivec2(0, 1), ivec2(0), size - 1), size, Pn, Nn, rn)) best = min(best, length(Pn - P));
		if (SurfaceAt(clamp(texel - ivec2(0, 1), ivec2(0), size - 1), size, Pn, Nn, rn)) best = min(best, length(Pn - P));
		if (best < 1e8) texelSize.y = max(best, eyeDistance * 0.0002);
	}
#ifdef RV_SIGNAL_DIFFUSE
	// A diffuse signal has no lobe to bound it: a plain radius does.
	const vec2 reach = min(vec2(radius), vec2(u_Reflection.Blur.w));
#else
	const vec2 reach = min(vec2(radius), footprint / texelSize * (1.0 + kYoungOverreach * young * young));
#endif
	// **Radius is two sigmas, and sigma is counted in taps, not in texels
	// (2026-09-21).** The three passes widen by standing their seven taps further
	// apart -- stride 1, then 2, then 4 -- which is the whole of what an a-trous
	// filter is. Dividing sigma by that stride took the widening straight back out
	// again: every pass then covered the same texels as the first, so passes two and
	// three were near copies and the support never grew past seven texels however
	// large the radius. Sigma now stands in tap space, the stride does the widening,
	// and a pass whose stride already reaches past what the radius asks for stops.
	const int stride = max(int(u_Reflection.Probe.z + 0.5), 1);
	if (max(reach.x, reach.y) < float(stride))
		return;
	const vec2 sigma = min(0.5 * reach * kPassShare / float(stride), vec2(1.5));
	if (max(sigma.x, sigma.y) < 0.15)
		return;
	const vec2 invTwoSigmaSq = 0.5 / max(sigma * sigma, vec2(0.0001));
	const float planeTolerance = 0.02 + 0.01 * eyeDistance;

	vec3 sum = vec3(0.0);
	float weightSum = 0.0;
#if !defined(RV_SIGNAL_DIFFUSE)
	// The square of the weights, for the variance this pass leaves behind.
	float varianceSum = 0.0;
	float weightSqSum = 0.0;
#endif
	for (int y = -kMaxRadius; y <= kMaxRadius; ++y)
	{
		for (int x = -kMaxRadius; x <= kMaxRadius; ++x)
		{
			const ivec2 at = clamp(texel + ivec2(x, y) * stride, ivec2(0), size - 1);
			const vec4 f = texelFetch(u_Accumulated, at, 0);
			if (f.a <= 0.0)
				continue;
			vec3 Pn, Nn;
			float rn;
			if (!SurfaceAt(at, size, Pn, Nn, rn))
				continue;
			float w = exp(-(float(x * x) * invTwoSigmaSq.x + float(y * y) * invTwoSigmaSq.y));
			w *= pow(max(dot(N, Nn), 0.0), 8.0);
			w *= exp(-abs(dot(N, Pn - P)) / planeTolerance);
			w *= abs(rn - roughness) < 0.2 ? 1.0 : 0.0;
#if !defined(RV_SIGNAL_DIFFUSE)
			// **And the weight that tells noise from detail (2026-09-21).** The three
			// tests above ask whether the neighbour is the same surface; none of them
			// asks whether its picture differs for a reason. A tap whose luminance sits
			// within the centre's own uncertainty is the same value seen through noise
			// and is averaged in; one that stands far outside it is a different thing --
			// a lamp's reflection ending, an edge in the reflected room -- and is
			// dropped. This is why a wide radius can be spent here without turning the
			// floor to mush, and why every earlier attempt to widen it was refused by
			// eye: the blur could only ever smooth everything equally.
			{
				const float lc = dot(centre.rgb, vec3(0.2126, 0.7152, 0.0722));
				const float ln = dot(f.rgb, vec3(0.2126, 0.7152, 0.0722));
				w *= exp(-abs(lc - ln) / (kSigmaL * sqrt(variance) + kSigmaLFloor));
			}
#endif
			sum += f.rgb * w;
#ifdef RV_SIGNAL_PAIR
			sum2 += texelFetch(u_Accumulated2, at, 0).rgb * w;
#endif
			weightSum += w;
#if !defined(RV_SIGNAL_DIFFUSE) && !defined(RV_SIGNAL_PAIR)
			varianceSum += w * w * VarianceAt(at, frames);
			weightSqSum += w * w;
#endif
		}
	}
#if !defined(RV_SIGNAL_DIFFUSE) && !defined(RV_SIGNAL_PAIR)
	// An average of values with weights w has variance sum(w^2 v) / (sum w)^2.
	o_Variance = weightSum > 0.0 ? varianceSum / (weightSum * weightSum) : variance;
#endif
	if (weightSum > 0.0)
	{
		o_Blurred = vec4(sum / weightSum, centre.a);
#ifdef RV_SIGNAL_PAIR
		o_Blurred2 = vec4(sum2 / weightSum, centre2.a);
#endif
	}
}
