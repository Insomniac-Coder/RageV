// SSGI, pass 4 of 4: the add (ENGINE-NOTES 7at).
//
// On the linear HDR image, in the same place and for the same reason SSAO's
// multiply lands there: indirect light is lighting, and it belongs on the
// sharp image before defocus, smear and bloom -- a red bounce should blur
// like light, not be painted over the finished frame.
//
// `out = lit + lit * gi * intensity` is the design's one stated
// approximation. Indirect diffuse is albedo x irradiance, and a post pass has
// the lit colour but not the albedo, so the pixel's own colour stands in for
// it: a black surface receives nothing and a red one receives red -- the two
// ends of the range that matter -- while a dark surface under a bright light
// reads bright and so receives more than it should. The intensity dial is the
// restraint, exactly as it is for SSAO's own compromise.

#type vertex
#version 450 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 450 core

layout(location = 0) in vec2 v_UV;
layout(location = 0) out vec4 o_Color;

// Half resolution, blurred: irradiance in RGB. Sampled with the linear
// filter as its upsample, for the reason occlusion is -- a bounce is low
// frequency by construction.
//
// **This pass no longer applies anything** (ENGINE-NOTES 7av). It used to add
// `scene + scene * indirect`, standing the lit pixel in for an albedo a post
// pass cannot have. Now it resolves the gather into the frame's Indirect
// buffer and stops; the lit shader reads that buffer next frame and multiplies
// by the surface's own base colour, which is where the multiply belonged.
layout(set = 0, binding = 0) uniform sampler2D u_Indirect;

layout(push_constant) uniform Params
{
	float TexelX;        // PostParams' shared header
	float TexelY;
	float Intensity;     // the header's A
	float B;
	float C;
	float FlipY;
} u_Params;

void main()
{
	const bool flip = u_Params.FlipY > 0.5;
	vec2 uv = vec2(v_UV.x, flip ? 1.0 - v_UV.y : v_UV.y);

	const vec3 indirect = max(texture(u_Indirect, uv).rgb, vec3(0.0));

	// Irradiance in RGB, albedo-free. Alpha is the confidence, and it is 1
	// wherever the gather ran at all: the intensity dial lives in the lit
	// shader now, so a zero here would throw the estimate away rather than
	// scale it.
	o_Color = vec4(indirect, 1.0);
}
