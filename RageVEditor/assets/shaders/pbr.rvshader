// Cook-Torrance PBR with the metallic-roughness parameterisation glTF uses,
// for meshes that do not deform.
//
// Nothing is here: the scene block, the lights, the shadows and the whole
// of the shading live in include/, shared with the skinned variant -- and
// the vertex stage is shared with the layered variant (ENGINE-NOTES 7aq),
// which differs from this one only in what set 1 holds. What the three
// genuinely differ in -- how a vertex reaches world space, and what the
// surface is made of -- is each written once.
//
// Output is linear HDR. Tone mapping and the transfer function belong to the
// tonemap pass, for the reason recorded in HANDOFF section 5.
#type vertex
#version 450 core

#include "include/scene_vertex.glsl"
#include "include/static_vertex.glsl"

#type fragment
// 460, not 450: glslang admits the ray-query keywords only from 460, and the
// fragment stage traces under RV_RAY_SHADOWS (ENGINE-NOTES 7am). Nothing else
// in the stage needs it, and the OpenGL backend cross-compiles to 450 from
// the SPIR-V whatever the source said.
#version 460 core

#include "include/pbr_fragment.glsl"
