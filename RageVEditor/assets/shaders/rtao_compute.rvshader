// Ambient occlusion, ray-traced: SSAO's first pass with the taps cast as rays.
//
// The same shape as ssao_compute.rvshader -- half resolution, the depth and
// surface attachments, one position reconstructed per pixel, twelve taps in
// a golden-angle spiral rotated per pixel by a hash so the frame is
// deterministic -- and one difference: each tap is a short ray into the
// scene's acceleration structure rather than a probe of the depth buffer.
// Occluded is a hit. So there is no depth slope to misjudge, no halo from a
// silhouette in front, and an occluder off-screen counts. The blur and the
// apply after this are SSAO's own, unchanged. ENGINE-NOTES 7ao.
//
// The normal the hemisphere hangs on is chosen by SSAO's rule (7ae): the
// scene's written normal where it agrees with the depth buffer's own slope,
// the slope otherwise -- see main() for why the rays need that rule as much
// as the depth taps did, and the one guard they need beyond it.
//
// 460 and the ray-query extension: compiled only where the device can trace,
// which PostProcess::Init decides; the SSAO twin is what runs elsewhere.

#type vertex
#version 460 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 460 core
#extension GL_EXT_ray_query : require

layout(location = 0) in vec2 v_UV;
layout(location = 0) out vec4 o_Color;

layout(set = 0, binding = 0) uniform sampler2D u_Depth;
// Octahedral world normal in RG, roughness B, metallic A. Point sampled.
layout(set = 0, binding = 1) uniform sampler2D u_Surface;
// The frame's structure, built before the graph (7am).
layout(set = 0, binding = 4) uniform accelerationStructureEXT u_SceneAS;

layout(push_constant) uniform Params
{
	float TexelX;
	float TexelY;
	float A;
	float B;
	float C;
	float FlipY;

	float NearClip;
	float FarClip;
	float InvP0;
	float InvP1;
	// World metres a ray reaches: the profile's AoRadius.
	float Radius;
	// Rays a pixel: four at AoDetail::Full, eight at VeryHigh. See kTaps.
	float Taps;

	// The camera-to-world rotation, as three rows, and the camera's position:
	// what carries a reconstructed point out into the world the rays are
	// cast in. The inverse of what SSAO carries in.
	vec4 CameraRow0;
	vec4 CameraRow1;
	vec4 CameraRow2;
	vec4 CameraPosition;
	// The frame's TAA jitter in NDC, xy. See ViewPositionAt.
	vec4 Jitter;
} u_Params;

#include "include/view_reconstruction.glsl"

// Eight, down from twelve, and the blur is why it holds: the 9x9
// separable pass after this absorbs the extra variance completely --
// measured on the showroom at 2560x1600, the twelve-tap and eight-tap
// frames differ by 0.005 mean levels with an identical local-noise
// metric (0.6638 against 0.6639), while the pass costs a third less
// (3.49 -> 2.41 ms; camp 5.48 -> 3.67). The literature budget for
// denoised RTAO is one or two rays a pixel, so eight is still
// conservative by a factor of four.
// **Four by default, eight at AoDetail::VeryHigh**, and no longer a constant.
//
// The 12 -> 8 note above still holds and the same reasoning carries one step
// further: measured across the showroom in both lighting modes, camp and demo
// at 1280x720, eight against four differs by 0.03 to 0.19 mean levels of 255,
// leaves the local-noise metric unmoved to four decimals -- 10.2143 against
// 10.2150 on camp -- and costs 0.550 ms against 0.286, a 48% cut to the pass
// and 239 us off the frame, faster in six runs of six. The blur is still
// doing the work.
//
// Not free, and the dial exists because of it: 0.1-0.2% of pixels move by
// more than four levels, and the worst single pixel measured 27, which is
// past the 25-level line this engine calls visible. A scene of fine contact
// shadows can ask for the rays back.
const float kGoldenAngle = 2.39996323;
// The origin's lift off the surface along its normal, in metres, scaled by
// distance the way every ray this engine casts is: the same self-intersection
// the shadow ray avoids, at the same size.
const float kLift = 0.004;
const float kLiftPerMetre = 0.0004;

vec2 InvProjection() { return vec2(u_Params.InvP0, u_Params.InvP1); }

// The jitter in sampling-space uv. NDC is twice uv, and this frame's y runs
// along texel rows -- which is the axis FlipY exists for -- so the y component
// turns over on the backend whose row 0 is the top.
vec2 JitterUv()
{
	const bool flip = u_Params.FlipY > 0.5;
	return vec2(u_Params.Jitter.x, flip ? -u_Params.Jitter.y : u_Params.Jitter.y) * 0.5;
}

vec3 ViewPositionAt(vec2 uv)
{
	// Snapped to the depth texel's centre, as SSAO's is (7an): the point the
	// depth actually describes.
	const vec2 depthSize = vec2(textureSize(u_Depth, 0));
	const vec2 snapped = (floor(uv * depthSize) + 0.5) / depthSize;
	const float z = LinearDepth(texture(u_Depth, snapped).r, u_Params.NearClip, u_Params.FarClip);

	// **Minus the jitter, and this is the whole of 7bq.** TAA translates the
	// projection by a sub-pixel offset each frame, so the depth in this texel
	// belongs to the point whose NDC is the texel's *minus* that offset.
	// Reconstructing without it puts the point somewhere it never was, by an
	// error that grows with depth and changes every frame -- which is a ray
	// origin that walks the jitter sequence, and distant geometry that
	// strobes at the sequence's period. SSAO and SSR never saw it: they hand
	// the position straight back to ViewToUv, which is the exact inverse, and
	// a constant offset cancels. A ray leaves for world space and cannot.
	//
	// The normal is unaffected either way -- it is a difference of four of
	// these, and a constant offset cancels there too.
	return ViewPosition(snapped - JitterUv(), z, InvProjection());
}

// The reconstruction frame's point, out to the world: the frame is view
// space with y along texel rows and z as depth, so it becomes view space by
// undoing those two, and view space becomes world through the camera.
vec3 WorldPositionOf(vec3 p, bool flip)
{
	const vec3 view = vec3(p.x, flip ? -p.y : p.y, -p.z);
	return u_Params.CameraPosition.xyz + vec3(dot(u_Params.CameraRow0.xyz, view),
											  dot(u_Params.CameraRow1.xyz, view),
											  dot(u_Params.CameraRow2.xyz, view));
}

// The depth buffer's own slope, carried into the world: the same
// chosen-neighbour reconstruction SSAO uses (7ac, 7an). The geometry the
// rays are cast into is exactly what this depth buffer describes, so this
// is the normal that geometry implies.
// `slack` is how far the surface falls away within one texel -- the depth
// buffer's own slope, in metres -- and it is the ray origin's problem as much
// as the normal's. The reconstructed point is the texel centre's depth, but
// the surface the rays are cast against is wherever the rasteriser sampled
// it, up to a texel away: at a grazing angle that difference is centimetres,
// and it GROWS as the render gets smaller because a texel covers more floor.
// An origin lifted by less than it starts inside the very surface it stands
// on, and every ray hits at t~0 -- which is how the editor's game panel,
// the only surface in the engine that renders shorter than ~500 pixels,
// blacked out its floors while every full-window render was clean.
vec3 ReconstructedWorldNormal(vec2 uv, vec3 centre, vec2 texel, bool flip,
							  out float slack)
{
	const vec3 right = ViewPositionAt(uv + vec2(texel.x, 0.0));
	const vec3 left  = ViewPositionAt(uv - vec2(texel.x, 0.0));
	const vec3 up    = ViewPositionAt(uv + vec2(0.0, texel.y));
	const vec3 down  = ViewPositionAt(uv - vec2(0.0, texel.y));

	const vec3 dx = abs(right.z - centre.z) < abs(centre.z - left.z) ? right - centre : centre - left;
	const vec3 dy = abs(up.z - centre.z) < abs(centre.z - down.z) ? up - centre : centre - down;

	// The chosen neighbours, so a depth edge does not masquerade as a cliff.
	slack = max(abs(dx.z), abs(dy.z));

	vec3 normal = normalize(cross(dy, dx));
	// Against the ray to the point (7an), never the view axis.
	normal = dot(normal, centre) > 0.0 ? -normal : normal;

	// A direction, not a point: no translation.
	const vec3 view = vec3(normal.x, flip ? -normal.y : normal.y, -normal.z);
	return normalize(vec3(dot(u_Params.CameraRow0.xyz, view),
						  dot(u_Params.CameraRow1.xyz, view),
						  dot(u_Params.CameraRow2.xyz, view)));
}

uint Hash(uint x)
{
	x ^= x >> 16; x *= 0x7FEB352Du;
	x ^= x >> 15; x *= 0x846CA68Bu;
	x ^= x >> 16;
	return x;
}

void main()
{
	const bool flip = u_Params.FlipY > 0.5;
	vec2 uv = vec2(v_UV.x, flip ? 1.0 - v_UV.y : v_UV.y);

	const vec2 texel = vec2(u_Params.TexelX, u_Params.TexelY);
	const vec3 centre = ViewPositionAt(uv);

	// Nothing to occlude on the far plane: the sky, or nothing at all.
	if (centre.z >= u_Params.FarClip * 0.999)
	{
		o_Color = vec4(1.0, centre.z, 0.0, 0.0);
		return;
	}

	// The normal, by SSAO's rule (7ae): the depth buffer's slope, replaced by
	// the scene's written normal only where the two agree within the
	// reconstruction's own accuracy.
	//
	// The first draft of this pass took the written normal wherever there was
	// one, on the reasoning that a ray does not care whether the normal
	// agrees with the depth's slope. That was 9.8b's mistake made again: the
	// written normal is the shading normal, after the normal map, and the
	// rays are cast into the geometry -- which is flat where the normal map
	// says it is not. On the fixture that isolates it, a brick wall seen
	// along its length, the hemisphere hung on the map's tilt sent rays into
	// the wall and darkened open texels to an AO factor of 0.972 at the tenth
	// percentile, where the geometric normal holds them at one. So: the
	// slope, unless the written normal is within about sixteen degrees of it,
	// in which case it is the smoother estimate of the same thing.
	const float kAgreement = 0.96;

	const vec4 surface = texture(u_Surface, uv);
	float slack;
	const vec3 geometric = ReconstructedWorldNormal(uv, centre, texel, flip, slack);
	vec3 normal = geometric;
	if (!SurfaceIsEmpty(surface))
	{
		const vec3 written = OctDecode(surface.rg);
		if (dot(written, geometric) > kAgreement)
			normal = written;
	}

	const vec3 world = WorldPositionOf(centre, flip);
	// The constant lift covers depth-buffer precision; the slack covers the
	// slope. Both, because either alone fails at the other's scale.
	const vec3 origin = world + normal * (kLift + kLiftPerMetre * centre.z + slack);

	const vec3 axis = abs(normal.x) < 0.7 ? vec3(1, 0, 0) : vec3(0, 1, 0);
	const vec3 tangent = normalize(cross(axis, normal));
	const vec3 bitangent = cross(normal, tangent);

	const uvec2 pixel = uvec2(uv / texel);
	const float rotation = float(Hash(pixel.x * 0x9E3779B9u ^ pixel.y)) / 4294967296.0 * 6.2831853;

	float occlusion = 0.0;
	const int kTaps = int(u_Params.Taps + 0.5);
	for (int i = 0; i < kTaps; i++)
	{
		// The same spiral SSAO bends into its hemisphere; here the disc is
		// lifted onto the hemisphere cosine-weighted, which is what ambient
		// occlusion integrates against.
		const float t = (float(i) + 0.5) / float(kTaps);
		const float r = sqrt(t);
		const float theta = float(i) * kGoldenAngle + rotation;
		const vec3 direction = tangent * (cos(theta) * r) + bitangent * (sin(theta) * r)
							 + normal * sqrt(max(1.0 - t, 0.0));

		// The guard SSAO's kernel does not need: its lowest tap sits 24
		// degrees above the plane, so a normal inside the tolerance keeps
		// every tap above the geometry. This kernel is cosine-weighted and
		// its lowest ray sits 12 degrees up, so a written normal tilted
		// 12-16 degrees would still send that ray into the wall. A ray under
		// the slope the depth buffer implies is not cast; it counts as open,
		// which is what it would have found had the wall been the bump the
		// map claims.
		if (dot(direction, geometric) < 0.0)
			continue;

		rayQueryEXT q;
		rayQueryInitializeEXT(q, u_SceneAS,
							  gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
							  0xFFu, origin, 0.0, direction, u_Params.Radius);
		while (rayQueryProceedEXT(q)) {}
		if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionNoneEXT)
			occlusion += 1.0;
	}

	const float ao = 1.0 - occlusion / float(kTaps);

	// Occlusion in R, linear depth in G for the blur's edge test -- the same
	// contract as ssao_compute, because the same blur reads it.
	o_Color = vec4(ao, centre.z, 0.0, 0.0);
}
