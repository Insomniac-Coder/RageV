// **The opaque surfaces' glossy reflection, traced in a pass of its own.**
//
// The lit shader used to cast its mirror rays in-line, one exact mirror
// direction per pixel, and blend the answer into its specular in the same
// fragment. Right for a mirror; wrong for everything else, because a rough
// surface reflects a lobe of directions and one ray along its centre is a
// perfect mirror whatever the roughness says. The garage floor showed it:
// its tubes reflected as knife-sharp lines where the reference has wide soft
// bands. Scattering the ray by roughness (GlossyReflection) gives the bands
// and a grain, and the grain has to be averaged over frames -- which the
// frame's own temporal filter cannot do for a term folded into the lit
// pixel, since it clamps every sparkle back to its neighbours.
//
// So the rays move here (RAY-BUDGET-DESIGN Part III 4.3.4: "the separate
// reflection pass once the normal buffer is 16-bit", which it is). One
// fragment per pixel of the picture reads the surface the scene pass wrote
// -- world normal, roughness, metallic -- and the depth, rebuilds the point,
// draws its rays from the lobe, and writes the average radiance. The pass
// after this one averages it with the frames behind it, and the lit shader
// composites the accumulated picture through the same hook screen-space
// reflections use, a frame late and reprojected (ENGINE-NOTES 7af).
//
// **The count is the budget's.** The preset's MirrorRays is the screen
// average (Indirect.w); where the tile allocator ran this frame, the tile's
// GI allocation over its average scales it, so a busy tile draws more and a
// dull one fewer, with the allocator's dead band and dwell keeping the count
// still. That lane is the GI lane standing in for the mirror lane the design
// names (B.g), until the allocator's second texture exists.
//
// **A miss is not a zero.** Alpha below zero marks "nothing glossy here", which
// the accumulate pass must not average in and the hook reads as no share.
#type vertex
#version 460 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 460 core

#define RV_TRACE_ONLY
// This pass's rays count in the reflection lane, not the bounce's.
#define RV_REFLECTION_TRACE
#ifdef RV_REFLECTION_RELIGHT
// **Measured change (docs/RT-MEASURED-CHANGE.md, phase 2): the eye the record
// was taken from**, for the thin-member fade inside traversal. A global,
// because the traversal is in the header below and the push block after it;
// main sets it first.
vec3 g_TraceCamera = vec3(0.0);
#define RV_TRACE_CAMERA g_TraceCamera
#endif
#include "include/pbr_fragment.glsl"
#ifdef RV_REFLECTION_RECORD
#include "include/change_record.glsl"
#endif

layout(location = 0) in vec2 v_UV;

// The scene pass's surface attachment: world normal octahedral in rg,
// roughness in b, metallic in a; `b <= 0` is no surface. Its depth. The tile
// allocator's map, or the surface again when there is none this frame.
#ifdef RV_REFLECTION_RELIGHT
// **Measured change, phase 2: last frame's record, in the first four slots.** One
// texel per 3x3 block: 0 the world position and, in w, the sampled pixel's
// column shifted past three flag bits (1 a traced glossy surface, 4 moving); 1
// and 3 the G-buffer's surface and albedo texels exactly as the trace read
// them; 2 the luminance the trace wrote, and the pixel's row in w.
layout(set = 3, binding = 0) uniform sampler2D u_Record0;
layout(set = 3, binding = 1) uniform sampler2D u_Record1;
layout(set = 3, binding = 2) uniform sampler2D u_Record2;
layout(set = 3, binding = 3) uniform sampler2D u_Record3;
#else
layout(set = 3, binding = 0) uniform sampler2D u_Surface;
layout(set = 3, binding = 1) uniform sampler2D u_Depth;
layout(set = 3, binding = 2) uniform sampler2D u_Budget;
#endif
// **The albedo lane, for the metal's own colour.** rgb is the albedo and
// a is the dielectric specular scalar -- exactly what the lit shader
// builds F0 from, and F0 for a metal *is* the metal's colour. Without it
// this pass hands the compositor an untinted picture and a coloured metal
// reflects the room in grey.
#ifndef RV_REFLECTION_RELIGHT
layout(set = 3, binding = 3) uniform sampler2D u_Albedo;
#endif
#ifdef RV_REFLECTION_RECORD
// **Measured change, phase 2: what the record keeps beside the G-buffer** -- the
// picture the trace just wrote, and the scene's velocity, which with the
// camera's own motion taken out says whether the surface under the sampled
// pixel moved.
layout(set = 3, binding = 4) uniform sampler2D u_Traced;
layout(set = 3, binding = 5) uniform sampler2D u_Velocity;
#endif

layout(push_constant) uniform LampParams
{
	// The inverse of this frame's view-projection: a texel and its depth
	// back to the world. (The slot the lamp passes use for last frame's
	// matrix; this pass has no last frame to look at.)
	mat4 InverseViewProjection;
	// y: the GI lane's screen average, which the tile's allocation is read
	// against. w: one where a texture row runs the other way up from a
	// projected coordinate.
	vec4 History;
	vec4 Probe;
	// x: the probe a traced hit is lit by. yz: the gloss window a surface must
	// sit inside to earn a ray. w: one when u_Budget is the allocator's map.
	vec4 Trace;
} u_Lamps;

#if defined(RV_REFLECTION_RECORD)
layout(location = 0) out vec4 o_Record0;
layout(location = 1) out vec4 o_Record1;
layout(location = 2) out vec4 o_Record2;
layout(location = 3) out vec4 o_Record3;
#elif defined(RV_REFLECTION_RELIGHT)
// The change at the block and its reference, and the guide the filter stops at
// edges with -- the direct light's layout, the highlight lane left empty.
layout(location = 0) out vec4 o_Change;
layout(location = 1) out vec4 o_ChangeGuide;
#else
layout(location = 0) out vec4 o_Reflection;
// The ray's direction (octahedral) and the pdf it was drawn with, for the
// resolve's ratio estimator: a neighbour's hit point re-aimed from another
// texel is a sample of that texel's lobe, weighted by lobe / this pdf.
layout(location = 1) out vec4 o_Hit;
// **RT-17: what the ray struck** -- r its instance's identity (zero for a miss),
// g the struck surface's normal packed into ten bits (five a side of the
// octahedral square, exact in the half float this lane is), plus 1024 where the
// struck instance moved this frame -- so the
// accumulator can ask whether its history still shows the same thing, which the
// hit distance cannot when something crosses the reflection at the distance the
// ray already went.
layout(location = 2) out vec4 o_HitIdentity;
#endif

// The surface attachment's encoding is octahedral.glsl's, in zero to one; the
// lit header already includes that file (guarded), so its decoder is the one
// to call. A second copy that assumed minus one to one folded every normal
// and sent every ray the wrong way (2026-09-05, found by painting the floor
// by N.y).
vec3 SurfaceNormal(vec2 e)
{
	return OctDecode(e);
}

float Halton(uint index, uint base)
{
	float f = 1.0, r = 0.0;
	for (int i = 0; i < 12 && index > 0u; ++i)
	{
		f /= float(base);
		r += f * float(index % base);
		index /= base;
	}
	return r;
}

// The ray's direction from a low-discrepancy sequence rather than a hash
// (2026-09-06, after the roughness-aware design note): Halton (2, 3),
// progressive over the accumulator's 64-frame memory so a parked texel's
// draws stratify its lobe, rotated per texel by the R2 lattice so its
// neighbours cover other parts of the lobe than it does -- which is what
// the resolve's disc then gathers. GGX by its distribution of half
// vectors, as GlossyReflection does; below the horizon, the mirror.
vec3 GlossyReflectionLD(vec3 N, vec3 V, float roughness, ivec2 texel, uint frame)
{
	const vec3 mirror = reflect(-V, N);
	const float alpha = roughness * roughness;
	if (alpha < 1.0e-4)
		return mirror;
	const uint index = (frame & 63u) + 1u;
	const vec2 rotation = fract(vec2(texel) * vec2(0.7548776662, 0.5698402910));
	const float u1 = fract(Halton(index, 2u) + rotation.x);
	const float u2 = fract(Halton(index, 3u) + rotation.y);
	const float cosTheta = sqrt((1.0 - u1) / (1.0 + (alpha * alpha - 1.0) * u1));
	const float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
	const float phi = 6.2831853 * u2;
	const vec3 axis = abs(N.x) < 0.7 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
	const vec3 t = normalize(cross(axis, N));
	const vec3 b = cross(N, t);
	const vec3 H = normalize(t * (sinTheta * cos(phi)) + b * (sinTheta * sin(phi)) + N * cosTheta);
	const vec3 L = reflect(-V, H);
	return dot(L, N) > 0.02 ? L : mirror;
}

void main()
{
#if defined(RV_REFLECTION_RECORD)
	o_Record0 = vec4(0.0);
	o_Record1 = vec4(0.0);
	o_Record2 = vec4(0.0);
	o_Record3 = vec4(0.0);
	// **One pixel of this block, a different one each frame.**
	const ivec2 block = ivec2(gl_FragCoord.xy);
	const ivec2 size = textureSize(u_Surface, 0);
	const uint pick = BudgetHash(uint(block.x) ^ (uint(block.y) << 16u)
								 ^ (uint(u_Scene.GlobalIllumination.y) * 0x27D4EB2Du) ^ 0x5BD1E995u) % 9u;
	const ivec2 texel = min(block * 3 + ivec2(int(pick % 3u), int(pick / 3u)), size - 1);
	const vec4 surface = texelFetch(u_Surface, texel, 0);
	if (surface.b <= 0.0)
		return;
#elif defined(RV_REFLECTION_RELIGHT)
	o_Change = vec4(0.0, -1.0, 0.0, -1.0);
	o_ChangeGuide = vec4(0.0);
	// **Last frame's sampled pixel.** A block with no traced surface, or one that
	// moved, says nothing about the light.
	const ivec2 block = ivec2(gl_FragCoord.xy);
	const vec4 record0 = texelFetch(u_Record0, block, 0);
	const vec4 record2 = texelFetch(u_Record2, block, 0);
	const uint recordFlags = uint(record0.w);
	if ((recordFlags & 1u) == 0u || (recordFlags & 4u) != 0u)
		return;
	const ivec2 texel = ivec2(int(recordFlags >> 3u), int(record2.w));
	const vec4 surface = texelFetch(u_Record1, block, 0);
	g_TraceCamera = u_Lamps.Probe.xyz;
#else
	o_Reflection = vec4(0.0, 0.0, 0.0, -1.0);
	o_Hit = vec4(0.0);
	o_HitIdentity = vec4(0.0);

	const ivec2 texel = ivec2(gl_FragCoord.xy);
	const ivec2 size = textureSize(u_Surface, 0);
	const vec4 surface = texelFetch(u_Surface, texel, 0);
	if (surface.b <= 0.0)
		return;
#endif

	// The same window the lit shader weighs its mirror by: outside it the
	// probe answers alone and no ray is cast.
	const float roughness = clamp(surface.b, 0.0, 1.0);
	const vec2 gloss = u_Lamps.Trace.yz;
	const float mirror = 1.0 - smoothstep(gloss.x, gloss.y, roughness);
	if (mirror <= 0.0)
		return;

#ifdef RV_REFLECTION_RELIGHT
	const vec3 P = record0.xyz;
	const vec3 N = SurfaceNormal(surface.rg);
	const vec3 V = normalize(u_Lamps.Probe.xyz - P);
	const uint frame = uint(u_Lamps.Probe.w);
#else
	const float depth = texelFetch(u_Depth, texel, 0).r;
	if (depth >= 1.0)
		return;

	// Texel to the world: a row is a projected coordinate the other way up
	// on the backend whose rows run down, the same fact the lamp passes carry
	// in History.w. Clip z is the depth as written.
	const vec2 uv = (vec2(texel) + 0.5) / vec2(size);
	const float row = u_Lamps.History.w > 0.5 ? 1.0 - uv.y : uv.y;
	const vec4 clip = u_Lamps.InverseViewProjection
					* vec4(uv.x * 2.0 - 1.0, row * 2.0 - 1.0, depth, 1.0);
	const vec3 P = clip.xyz / clip.w;
	const vec3 N = SurfaceNormal(surface.rg);
	const vec3 V = normalize(u_Scene.CameraPosition.xyz - P);
	const uint frame = uint(u_Scene.GlobalIllumination.y);
#endif
#if defined(RV_REFLECTION_RECORD)
	// **The record, and nothing traced.** The luminance is of what the trace
	// wrote at this pixel -- through its half-float target, as the re-light's
	// comparison allows for.
	{
		// Moved on its own, the camera's motion taken out (include/change_record.glsl).
		const bool moving = RecordMovedOnItsOwn(texelFetch(u_Velocity, texel, 0).xy, P,
												vec2(textureSize(u_Velocity, 0)));
		const vec4 wrote = texelFetch(u_Traced, texel, 0);
		const uint flags = (wrote.a >= 0.0 ? 1u : 0u) | (moving ? 4u : 0u);
		o_Record0 = vec4(P, float((uint(texel.x) << 3u) | flags));
		o_Record1 = surface;
		o_Record2 = vec4(dot(wrote.rgb, vec3(0.2126, 0.7152, 0.0722)), 0.0, 0.0, float(texel.y));
		o_Record3 = texelFetch(u_Albedo, texel, 0);
		return;
	}
#endif

	// One ray a texel. The preset's MirrorRays column, which used to be the
	// count drawn here, sets how many neighbours' rays the resolve gathers
	// instead (WR-16 R3, 2026-09-06); the tile allocator's per-tile scaling
	// of that count went with it and would return as a scaling of the taps.
	const vec3 direction = GlossyReflectionLD(N, V, roughness, texel, frame);
	const TracedSurface hit = TraceSurface(P, N, direction, 1.0e4);
	vec3 radiance = hit.Missed
				  ? hit.Sky
				  : ShadeTraced(hit, ProbeIrradiance(hit.Normal, u_Lamps.Trace.x));
	const float travelled = hit.Missed ? 1.0e4 : length(hit.Position - P);

	// **The surface's own reflectance, in colour.** The same split-sum term
	// the lit shader applies to the probe -- F0 * envBRDF.x + envBRDF.y --
	// built from the same F0: 0.08 * specular for a dielectric, the albedo
	// itself for a metal. Applied here rather than in the composite because
	// the composite has one scalar and no way to know the surface, and this
	// pass already has the normal, the view vector and the roughness.
	//
	// The lit shader used to do this and collapse it to a luminance, because
	// the weight it passes on has one channel. That is what made gold reflect
	// grey. Stored tinted, the picture is what it always should have been.
#ifdef RV_REFLECTION_RELIGHT
	const vec4 albedo = texelFetch(u_Record3, block, 0);
#else
	const vec4 albedo = texelFetch(u_Albedo, texel, 0);
#endif
	const vec3 F0 = mix(vec3(0.08 * clamp(albedo.a, 0.0, 1.0)), albedo.rgb,
						clamp(surface.a, 0.0, 1.0));
	const vec2 envBRDF = EnvBRDF(max(dot(N, V), 0.0), roughness);
	const vec3 reflectance = F0 * envBRDF.x + envBRDF.y;
	// **Only the tint's hue, never its magnitude.**
	//
	// The lit shader already sends the compositor the right *amount* of
	// reflection -- the split-sum term collapsed to a luminance -- and that
	// number is correct. What it cannot send is the *colour*, because it has
	// one channel, and its own comment said so: "one channel, so a coloured
	// metal's tint is not carried". F0 for a metal is the metal's own colour,
	// so gold has been reflecting the room in grey.
	//
	// So this multiplies by the reflectance **divided by its own luminance** --
	// a tint whose brightness is exactly one. The picture's magnitude is
	// therefore bit-for-bit what it was and only its hue changes, which is the
	// whole of the defect. Applying the reflectance raw was tried first and made
	// the garage floor four times brighter: the magnitude this pass computes and
	// the one the lit shader computes do not agree, and finding out why is a
	// separate question from carrying the colour. This fix does not depend on
	// the answer.
	const float tintLuma = dot(reflectance, vec3(0.2126, 0.7152, 0.0722));
	const vec3 tint = tintLuma > 1.0e-5 ? reflectance / tintLuma : vec3(1.0);
#if defined(RV_REFLECTION_RELIGHT)
	// **The change at this block: the same ray, traced into this frame's scene,
	// against what it found last frame.** A difference inside a half-float step
	// and a hair is the write, not the light.
	{
		const float now = dot(min(radiance, vec3(64.0)) * tint, vec3(0.2126, 0.7152, 0.0722));
		float delta = now - record2.x;
		const float reference = max(max(now, record2.x), 0.0);
		if (abs(delta) <= 0.004 * reference + 1.0e-4)
			delta = 0.0;
		o_Change = vec4(delta, reference, 0.0, 0.0);
		o_ChangeGuide = vec4(N, dot(N, P));
	}
#elif !defined(RV_REFLECTION_RECORD)
	o_Reflection = vec4(min(radiance, vec3(64.0)) * tint, travelled);
	// GGX sampled by its distribution of half vectors: pdf(L) = D(H) NoH / (4 VoH).
	const vec3 H = normalize(direction + V);
	const float pdf = DistributionGGX(N, H, roughness) * max(dot(N, H), 1.0e-4)
					/ (4.0 * max(dot(V, H), 1.0e-4));
	o_Hit = vec4(OctEncode(direction), min(pdf, 6.0e4), 0.0);
	// RT-17: the identity, and the struck normal as five bits each way.
	const vec2 struck = hit.Missed ? vec2(0.0) : floor(OctEncode(hit.Normal) * 31.0 + 0.5);
	o_HitIdentity = vec4(float(hit.Missed ? 0u : hit.Identity),
						 struck.x * 32.0 + struck.y + (!hit.Missed && hit.Moving ? 1024.0 : 0.0), 0.0, 0.0);
#endif

	// The ray above and the shadow rays its hit walked: flushed here, since
	// the lit shader's flush is compiled out under RV_TRACE_ONLY. `false`:
	// the lit pass already counted this pixel as a lit fragment.
#ifdef RV_RAY_COUNTERS
	FlushRayCounters(false);
#endif
}
