// **The opaque surfaces' glossy reflection, traced in a pass of its own.**
//
// The lit shader used to cast its mirror rays in-line, one exact mirror
// direction per pixel, and blend the answer into its specular in the same
// fragment. Right for a mirror; wrong for everything else, because a rough
// surface reflects a lobe of directions and one ray along its centre is a
// perfect mirror whatever the roughness says. The garage floor showed it:
// its tubes reflected as knife-sharp lines where the reference has wide soft
// bands. Scattering the ray by roughness (GlossyReflection) gives the bands
// and a grain, and the grain has to be averaged over frames -- which the
// frame's own temporal filter cannot do for a term folded into the lit
// pixel, since it clamps every sparkle back to its neighbours.
//
// So the rays move here (RAY-BUDGET-DESIGN Part III 4.3.4: "the separate
// reflection pass once the normal buffer is 16-bit", which it is). One
// fragment per pixel of the picture reads the surface the scene pass wrote
// -- world normal, roughness, metallic -- and the depth, rebuilds the point,
// draws its rays from the lobe, and writes the average radiance. The pass
// after this one averages it with the frames behind it, and the lit shader
// composites the accumulated picture through the same hook screen-space
// reflections use, a frame late and reprojected (ENGINE-NOTES 7af).
//
// **The count is the budget's.** The preset's MirrorRays is the screen
// average (Indirect.w); where the tile allocator ran this frame, the tile's
// GI allocation over its average scales it, so a busy tile draws more and a
// dull one fewer, with the allocator's dead band and dwell keeping the count
// still. That lane is the GI lane standing in for the mirror lane the design
// names (B.g), until the allocator's second texture exists.
//
// **A miss is not a zero.** Alpha below zero marks "nothing glossy here", which
// the accumulate pass must not average in and the hook reads as no share.
#type vertex
#version 460 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 460 core

#define RV_TRACE_ONLY
// This pass's rays count in the reflection lane, not the bounce's.
#define RV_REFLECTION_TRACE
// **A hit is shaded with its specular half** (2026-09-15, pbr_fragment's
// RV_HIT_SPECULAR). Lambert alone left every metal black in every reflection --
// the garage's box is Metallic 1, so a flat mirror facing the camera showed nothing
// of the wall behind it. All three variants of this pass, so the measured change's
// record and re-light compare the same shading.
#define RV_HIT_SPECULAR
#ifdef RV_REFLECTION_RELIGHT
// **Measured change (docs/RT-MEASURED-CHANGE.md, phase 2): the eye the record
// was taken from**, for the thin-member fade inside traversal. A global,
// because the traversal is in the header below and the push block after it;
// main sets it first.
vec3 g_TraceCamera = vec3(0.0);
#define RV_TRACE_CAMERA g_TraceCamera
// **And the frame and the pixel the record was drawn at (2026-09-22)**, so the
// draws the header makes for a hit -- the one lamp it keeps, the soft-shadow
// point -- are the draws the trace made. Seeded by the current frame, the
// re-light kept a different lamp and read its own resampling as a change.
vec2  g_TracePixel = vec2(0.5);
float g_TraceFrame = 0.0;
#define RV_TRACE_PIXEL g_TracePixel
#define RV_TRACE_FRAME g_TraceFrame
#endif
#include "include/pbr_fragment.glsl"
// RT-15b: RecordMovedOnItsOwn, for the extra rays below as well as the record.
#include "include/change_record.glsl"

layout(location = 0) in vec2 v_UV;

// The scene pass's surface attachment: world normal octahedral in rg,
// roughness in b, metallic in a; `b <= 0` is no surface. Its depth. The tile
// allocator's map, or the surface again when there is none this frame.
#ifdef RV_REFLECTION_RELIGHT
// **Measured change, phase 2: last frame's record, in the first four slots.** One
// texel per 3x3 block: 0 the world position and, in w, the sampled pixel's
// column shifted past three flag bits (1 a traced glossy surface, 4 moving); 1
// and 3 the G-buffer's surface and albedo texels exactly as the trace read
// them; 2 the luminance the trace wrote, and the pixel's row in w.
layout(set = 3, binding = 0) uniform sampler2D u_Record0;
layout(set = 3, binding = 1) uniform sampler2D u_Record1;
layout(set = 3, binding = 2) uniform sampler2D u_Record2;
layout(set = 3, binding = 3) uniform sampler2D u_Record3;
#else
layout(set = 3, binding = 0) uniform sampler2D u_Surface;
layout(set = 3, binding = 1) uniform sampler2D u_Depth;
layout(set = 3, binding = 2) uniform sampler2D u_Budget;
#endif
// **The albedo lane, for the metal's own colour.** rgb is the albedo and
// a is the dielectric specular scalar -- exactly what the lit shader
// builds F0 from, and F0 for a metal *is* the metal's colour. Without it
// this pass hands the compositor an untinted picture and a coloured metal
// reflects the room in grey.
#ifndef RV_REFLECTION_RELIGHT
layout(set = 3, binding = 3) uniform sampler2D u_Albedo;
#endif
#if !defined(RV_REFLECTION_RECORD) && !defined(RV_REFLECTION_RELIGHT)
// **RT-15b: the scene's velocity**, for whether the surface under the texel moved on its
// own this frame -- the texels that cast more than one ray (see main).
layout(set = 3, binding = 4) uniform sampler2D u_Velocity;
// **RT-9: what the accumulator knew at each texel last frame.** Its picture (the frames
// behind it in the alpha), what it learned (the refusal code in the alpha: 0 kept, 1 off
// screen, 2 none there, 3 normal, 4 plane, 5 roughness, 6 another object), the reflector it
// kept (alpha below zero where there was none) and whose it was (r, the object id). Every one
// of these is worked out per texel and thrown away at the end of the accumulate; read here,
// they say where reconstruction could not answer -- which is where a ray is worth casting.
// Black, and History.z zero, where there is no history yet or the allocation is switched off.
layout(set = 3, binding = 5) uniform sampler2D u_PastPicture;
layout(set = 3, binding = 6) uniform sampler2D u_PastExtra;
layout(set = 3, binding = 7) uniform sampler2D u_PastSurface;
layout(set = 3, binding = 8) uniform sampler2D u_PastIdent;
// **RT-9: and the count this tile may spend** (reflection_budget.rvshader): r the rays,
// g the frames it has been held, b the share of the tile that asked for it. One number
// for 16x16 pixels, because a scattered count is paid for by every pixel in the group.
layout(set = 3, binding = 9) uniform sampler2D u_TileRays;
#endif
// **And the rows reach the re-light as well (2026-09-22).** The measured change
// re-casts a recorded ray and compares what comes back with what the trace
// wrote; the trace adds an aimed sample to every ray and the re-light did not,
// so every texel lit through the aimed ray read as "changed" whenever the
// check ran -- the whole floor restarted its average each frame the car moved,
// which is RT-23. The re-light draws what the trace drew, rows included.
#if !defined(RV_REFLECTION_RECORD)

// **RT-11: the scene's area emitters, and where on each one the light is.**
//
// The bounce pass has aimed at these since it was built (rtgi_trace): for every
// ray it casts it *also* picks a point on a ceiling tube and fires one ray
// straight at it, so a tube's light arrives every frame at full strength
// whether or not a hemisphere ray happened to point at one. This pass never
// learned to. A reflection ray found a tube only by luck, and when it did it
// brought back the tube's whole radiance at the weight of one lobe sample --
// two or three hundred display levels against a floor's two. Hit or miss by
// chance, one ray a texel: that is the sparkle measured on the driving car
// (2026-09-21), and it is the estimator, not the filter that comes after it.
//
// Same rows and same aiming tables as the bounce reads, to the byte -- one
// upload, two readers -- so what the two passes call a lamp is one answer.
struct GiEmitter
{
	vec4 CentreArea;
	// The two half-extents; their w lanes, with Radiance.w, are the unit plane
	// normal, built once on the CPU rather than per shadow ray.
	vec4 TangentU;
	vec4 TangentV;
	vec4 Radiance;
	// x where this emitter's table starts in u_EmitterCdf, y cells a side (zero:
	// radiate evenly and the two rows below are unread), z the emissive map's
	// heap slot, w log2(y).
	vec4 Aim;
	// Texture uv to the rectangle's own (su, sv) in [-1, 1].
	vec4 UvToSurface0;
	vec4 UvToSurface1;
};

layout(std430, set = 3, binding = 10) readonly buffer ReflectionEmitterBlock
{
	GiEmitter u_Emitters[];
};

layout(std430, set = 3, binding = 11) readonly buffer ReflectionEmitterCdfBlock
{
	float u_EmitterCdf[];
};
#endif
#ifdef RV_REFLECTION_RECORD
// **Measured change, phase 2: what the record keeps beside the G-buffer** -- the
// picture the trace just wrote, and the scene's velocity, which with the
// camera's own motion taken out says whether the surface under the sampled
// pixel moved.
layout(set = 3, binding = 4) uniform sampler2D u_Traced;
layout(set = 3, binding = 5) uniform sampler2D u_Velocity;
// The trace's travel attachment: its w is how many rays the texel averaged
// (2026-09-22), for the re-light to draw the same number.
layout(set = 3, binding = 6) uniform sampler2D u_HitTravel;
#endif

layout(push_constant) uniform LampParams
{
	// The inverse of this frame's view-projection: a texel and its depth
	// back to the world. (The slot the lamp passes use for last frame's
	// matrix; this pass has no last frame to look at.)
	mat4 InverseViewProjection;
	// y: the GI lane's screen average, which the tile's allocation is read
	// against. w: one where a texture row runs the other way up from a
	// projected coordinate.
	vec4 History;
	vec4 Probe;
	// x: RT-15b, how many rays a texel casts where its surface moves on its own
	// (one elsewhere; the probe a hit is lit by is found at the hit, ProbeSlotAt).
	// yz: the gloss window a surface must sit inside to earn a ray. w: one when
	// u_Budget is the allocator's map.
	vec4 Trace;
	// RT-11: x how many rows of u_Emitters are real (zero: no aimed sample and
	// this pass behaves exactly as it did before RT-11).
	vec4 Nee;
} u_Lamps;

// **RT-23: whether the rays are drawn from the *visible* normals** (Heitz 2018)
// rather than from the whole distribution. A switch rather than the compile
// define this was written behind -- nothing ever set that define, so the path
// had never run in a build and the 630 -> 538 sparkle it was credited with came
// from a hand-staged shader. Off by default: switched on it sprays speckles over
// the whole floor (owner, 2026-09-22). The sampler and the density it is weighed
// by both read this lane, so they cannot disagree.
bool VisibleNormals() { return u_Lamps.Nee.y > 0.5; }

#if defined(RV_REFLECTION_RECORD)
layout(location = 0) out vec4 o_Record0;
layout(location = 1) out vec4 o_Record1;
layout(location = 2) out vec4 o_Record2;
layout(location = 3) out vec4 o_Record3;
#elif defined(RV_REFLECTION_RELIGHT)
// The change at the block and its reference, and the guide the filter stops at
// edges with -- the direct light's layout, the highlight lane left empty.
layout(location = 0) out vec4 o_Change;
layout(location = 1) out vec4 o_ChangeGuide;
#else
layout(location = 0) out vec4 o_Reflection;
// The ray's direction (octahedral) and the pdf it was drawn with, for the
// resolve's ratio estimator: a neighbour's hit point re-aimed from another
// texel is a sample of that texel's lobe, weighted by lobe / this pdf.
layout(location = 1) out vec4 o_Hit;
// **RT-17: what the ray struck** -- r its instance's identity (zero for a miss),
// g the struck surface's normal packed into ten bits (five a side of the
// octahedral square, exact in the half float this lane is), plus 1024 where the
// struck instance moved this frame -- so the
// accumulator can ask whether its history still shows the same thing, which the
// hit distance cannot when something crosses the reflection at the distance the
// ray already went.
layout(location = 2) out vec4 o_HitIdentity;
// **RT-15: and how far what it struck travelled since last frame**, world metres in
// xyz -- zero for a miss and for anything that did not move -- so the accumulator
// can look for the history where the struck point's image stood last frame
// instead of only noticing that the picture changed (RT-17).
layout(location = 3) out vec4 o_HitTravel;
#endif

// The surface attachment's encoding is octahedral.glsl's, in zero to one; the
// lit header already includes that file (guarded), so its decoder is the one
// to call. A second copy that assumed minus one to one folded every normal
// and sent every ray the wrong way (2026-09-05, found by painting the floor
// by N.y).
vec3 SurfaceNormal(vec2 e)
{
	return OctDecode(e);
}

float Halton(uint index, uint base)
{
	float f = 1.0, r = 0.0;
	for (int i = 0; i < 12 && index > 0u; ++i)
	{
		f /= float(base);
		r += f * float(index % base);
		index /= base;
	}
	return r;
}

// The ray's direction from a low-discrepancy sequence rather than a hash
// (2026-09-06, after the roughness-aware design note): Halton (2, 3),
// progressive over the accumulator's 64-frame memory so a parked texel's
// draws stratify its lobe, rotated per texel by the R2 lattice so its
// neighbours cover other parts of the lobe than it does -- which is what
// the resolve's disc then gathers. GGX by its distribution of half
// vectors, as GlossyReflection does; below the horizon, the mirror.
// `ray`: RT-15b, which of a texel's rays this frame -- each takes its own turn of the
// lattice so a texel's rays cover different parts of the lobe; zero is bit-identical
// to the one-ray draw.
vec3 GlossyReflectionLD(vec3 N, vec3 V, float roughness, ivec2 texel, uint frame, uint ray)
{
	const vec3 mirror = reflect(-V, N);
	const float alpha = roughness * roughness;
	if (alpha < 1.0e-4)
		return mirror;
	const uint index = (frame & 63u) + 1u;
	// **RT-15e: the rotation is the R2 sequence at the texel's index, not the R2 constants
	// applied per axis.** It was `fract(vec2(texel) * vec2(a1, a2))`: its x followed the column
	// alone and its y the row alone, and x is how far the ray tilts from the mirror, y which way.
	// So each frame a whole column tilted alike and a whole row turned alike -- and fract(a1 x)
	// comes round nearly every four columns. A still texel averages the 64 frames and the
	// pattern cancels; a texel with a young history keeps part of it, and on the moving chrome
	// cube's flat face that part was a grid of faint bands and lines (2026-09-15). Indexed by
	// x + 1601 y in fixed point (the fract of i * a is the top bits of i * a * 2^32), neighbours
	// still take well-spread offsets and neither component follows a row or a column. Any
	// stride works: two texels share an offset only 1601 columns apart.
	const uint r2Index = uint(texel.x) + uint(texel.y) * 1601u;
	const vec2 rotation = fract(vec2(float((r2Index * 3242174889u) >> 8u), float((r2Index * 2447445413u) >> 8u)) / 16777216.0
							  + vec2(float(ray)) * vec2(0.7548776662, 0.5698402910));
	const float u1 = fract(Halton(index, 2u) + rotation.x);
	const float u2 = fract(Halton(index, 3u) + rotation.y);
	const vec3 axis = abs(N.x) < 0.7 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
	const vec3 t = normalize(cross(axis, N));
	const vec3 b = cross(N, t);
	if (VisibleNormals())
	{
	// **The visible half of the lobe, not the whole of it (2026-09-21, Heitz 2018).**
	//
	// Drawing a half-vector from the distribution alone produces directions that go
	// *into* the surface -- more and more of them as the surface roughens or the view
	// grazes -- and this function used to hand every one of those back as the exact
	// mirror direction instead. That is not a small correction at the edges: it takes
	// every rejected draw across the whole frame and piles it on one direction, and
	// where that direction finds a lamp the pixel comes back many times brighter than
	// its neighbours. It is counted at full weight, so nothing downstream can tell it
	// from light that is really there. Measured on the driving car: twelve thousand
	// pixels a frame jumping more than forty levels, at the same rate with the
	// reflection's history switched off -- the sparkle was never the accumulator's.
	//
	// Sampling the *visible* normals instead draws only half-vectors the eye can
	// actually see, so a below-horizon direction is a numerical edge case rather than
	// a routine outcome, and no direction has to stand in for the rejected ones.
	const vec3 Ve = vec3(dot(V, t), dot(V, b), dot(V, N));
	const vec3 Vh = normalize(vec3(alpha * Ve.x, alpha * Ve.y, Ve.z));
	const float lensq = Vh.x * Vh.x + Vh.y * Vh.y;
	const vec3 T1 = lensq > 0.0 ? vec3(-Vh.y, Vh.x, 0.0) * inversesqrt(lensq) : vec3(1.0, 0.0, 0.0);
	const vec3 T2 = cross(Vh, T1);
	const float rad = sqrt(u1);
	const float phi = 6.2831853 * u2;
	const float p1 = rad * cos(phi);
	float p2 = rad * sin(phi);
	const float s = 0.5 * (1.0 + Vh.z);
	p2 = (1.0 - s) * sqrt(max(1.0 - p1 * p1, 0.0)) + s * p2;
	const vec3 Nh = p1 * T1 + p2 * T2 + sqrt(max(1.0 - p1 * p1 - p2 * p2, 0.0)) * Vh;
	const vec3 He = normalize(vec3(alpha * Nh.x, alpha * Nh.y, max(Nh.z, 0.0)));
	const vec3 H = normalize(t * He.x + b * He.y + N * He.z);
	const vec3 L = reflect(-V, H);
	// Below the horizon here is the numerical edge, not the rule. The mirror is still
	// the only direction available, and it now stands in for a handful of draws
	// rather than for every rejected one.
	return dot(L, N) > 0.0 ? L : mirror;
	}
	{
	const float cosTheta = sqrt((1.0 - u1) / (1.0 + (alpha * alpha - 1.0) * u1));
	const float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
	const float phi = 6.2831853 * u2;
	const vec3 H = normalize(t * (sinTheta * cos(phi)) + b * (sinTheta * sin(phi)) + N * cosTheta);
	const vec3 L = reflect(-V, H);
	return dot(L, N) > 0.02 ? L : mirror;
	}
}

#if !defined(RV_REFLECTION_RECORD)
// **How densely the lobe this pass samples points at `L`** -- the same number
// o_Hit's third lane already carries for the first ray, as a function so the
// aimed samples can ask it about a direction nothing was drawn along.
//
// This is what makes the two estimators below comparable. One draws a direction
// from the lobe and looks at what is there; the other picks a point on a lamp
// and asks how likely the lobe was to have looked at it. Weighing them against
// each other needs both answers in the same units, which is a density per unit
// solid angle.
float LobePdf(vec3 N, vec3 V, vec3 L, float roughness)
{
	const float alpha = roughness * roughness;
	// A mirror has no lobe to speak of: all of its density sits on one
	// direction, and no aimed sample will ever land on it. Reported as
	// enormous, which drives the weighting below to "the mirror ray carries
	// this" -- which is the right answer and the picture it already produces.
	if (alpha < 1.0e-4)
		return 1.0e8;
	const vec3 H = normalize(V + L);
	const float NoH = max(dot(N, H), 0.0);
	const float VoH = max(dot(V, H), 1.0e-4);
	const float D = DistributionGGX(N, H, roughness);
	if (VisibleNormals())
	{
	// Heitz 2018: drawing from the visible normals makes the density
	// G1(V) D(H) / (4 NoV), the masking term and NoH having cancelled.
	// Smith's exact G1 for GGX, not the lit shader's GeometrySchlickGGX --
	// that one carries the direct-lighting k and is a different function.
	const float NoV = max(dot(N, V), 1.0e-4);
	const float a2 = alpha * alpha;
	const float G1 = 2.0 * NoV / (NoV + sqrt(a2 + (1.0 - a2) * NoV * NoV));
	return G1 * D / (4.0 * NoV);
	}
	return D * NoH / (4.0 * VoH);
}

// **Which listed emitter the ray struck, by the entity it belongs to.**
// Returns -1 when the struck instance is in no row, which is every hit in the
// scene but the handful on a fitting.
//
// By identity and not by geometry, and that distinction was worth seventeen
// display levels. The rectangle a row describes sits at the mesh's bounding-box
// centre, so a ray that strikes a tube lands on the tube's *shell* -- a plane
// test against the rectangle finds nothing, the caller below then keeps the
// hit's whole glow, and the aimed sample adds that same light a second time.
// The identity is exact and costs a compare. See GiEmitter::UvToSurface0.w.
int EmitterOf(uint identity, int emitters)
{
	if (identity == 0u)
		return -1;
	for (int i = 0; i < emitters; ++i)
	{
		if (uint(u_Emitters[i].UvToSurface0.w + 0.5) == identity)
			return i;
	}
	return -1;
}

// **How densely the aimed sampler would have drawn the point the ray struck.**
// One for a row that radiates evenly; for one with an aiming table, the cell's
// share of the whole times the number of cells -- the same number the sampler
// used going the other way, so the two weights below still sum to one.
//
// The struck point is projected onto the rectangle's plane first, because it is
// on the fitting's shell rather than on the rectangle: the rectangle is what
// the estimator models the fitting as, and the projection is where on that
// model the light came from.
float EmitterDensityAt(GiEmitter light, vec3 point)
{
	float density = 1.0;
	{
		const vec3 d = point - light.CentreArea.xyz;
		const float uLen2 = max(dot(light.TangentU.xyz, light.TangentU.xyz), 1.0e-9);
		const float vLen2 = max(dot(light.TangentV.xyz, light.TangentV.xyz), 1.0e-9);
		const float su = clamp(dot(d, light.TangentU.xyz) / uLen2, -1.0, 1.0);
		const float sv = clamp(dot(d, light.TangentV.xyz) / vLen2, -1.0, 1.0);

		const int grid = int(light.Aim.y + 0.5);
		if (grid > 0)
		{
			// Back through the uv map to the cell, so the density here is the
			// same number the aimed sampler used going the other way. The map
			// is affine, so its inverse is a two by two.
			const float a = light.UvToSurface0.x, b = light.UvToSurface0.y;
			const float c = light.UvToSurface0.z;
			const float e = light.UvToSurface1.x, f = light.UvToSurface1.y;
			const float g = light.UvToSurface1.z;
			const float det = a * f - b * e;
			if (abs(det) > 1.0e-12)
			{
				const float u = (f * (su - c) - b * (sv - g)) / det;
				const float v = (-e * (su - c) + a * (sv - g)) / det;
				const int shift = int(light.Aim.w + 0.5);
				const int cx = clamp(int(u * float(grid)), 0, grid - 1);
				const int cy = clamp(int(v * float(grid)), 0, grid - 1);
				const int cell = (cy << shift) + cx;
				const int base = int(light.Aim.x + 0.5);
				const float upper = u_EmitterCdf[base + cell];
				const float lower = cell > 0 ? u_EmitterCdf[base + cell - 1] : 0.0;
				density = max(upper - lower, 1e-9) * float(grid * grid);
			}
		}
	}
	return density;
}

// **What one emitter is worth to this texel, before any ray is cast.**
//
// The first build of RT-11 picked one of the sixteen rows uniformly, and that
// is what made it fail: a garage texel sees one tube and fifteen it cannot,
// so fifteen draws in sixteen came back zero and the sixteenth came back at
// sixteen times weight. The aimed sample was a lottery of its own -- and the
// caps downstream, which exist precisely to stop lotteries, ate it. Measured
// on the wet floor: the weighting took 0.72 display levels off and the aim
// gave 0.10 back.
//
// So the pick is by what each row is worth here: its brightness, its size,
// how squarely it faces this point, how far it is, and -- the part that makes
// it a *reflection's* score rather than a surface's -- how much of this
// texel's lobe actually points at it. Three probes along the rectangle, the
// centre and the two ends of its longer side, because a ceiling tube is long
// and thin and its centre alone says nothing about whether the lobe clips an
// end of it.
//
// A bad score costs variance and nothing else: the weights below divide by the
// probability the score produced, so the picture is the same whatever it says.
float EmitterScore(vec3 P, vec3 N, vec3 V, float roughness, GiEmitter light)
{
	const vec3 lightNormal = vec3(light.TangentU.w, light.TangentV.w, light.Radiance.w);
	const float power = dot(light.Radiance.rgb, vec3(0.2126, 0.7152, 0.0722))
					  * max(light.CentreArea.w, 0.0);
	if (power <= 0.0)
		return 0.0;
	const bool longU = dot(light.TangentU.xyz, light.TangentU.xyz)
					 >= dot(light.TangentV.xyz, light.TangentV.xyz);
	const vec3 along = longU ? light.TangentU.xyz : light.TangentV.xyz;
	float best = 0.0;
	for (int p = 0; p < 3; ++p)
	{
		const vec3 point = light.CentreArea.xyz + along * (float(p) - 1.0);
		vec3 toLight = point - P;
		const float distance2 = max(dot(toLight, toLight), 1.0e-4);
		toLight *= inversesqrt(distance2);
		if (dot(N, toLight) <= 0.0)
			continue;
		const float cosLight = abs(dot(lightNormal, toLight));
		best = max(best, cosLight * LobePdf(N, V, toLight, roughness) / distance2);
	}
	return power * best;
}

// **The chance the pick above lands on row `index`.** Zero when nothing here
// is worth aiming at, which the caller reads as "no aimed sample this ray".
float EmitterChance(vec3 P, vec3 N, vec3 V, float roughness, int emitters, int index)
{
	float total = 0.0;
	float mine = 0.0;
	for (int i = 0; i < emitters; ++i)
	{
		const float s = EmitterScore(P, N, V, roughness, u_Emitters[i]);
		total += s;
		if (i == index)
			mine = s;
	}
	return total > 0.0 ? mine / total : 0.0;
}

// **The density the aimed sampler draws a point at, per unit solid angle.**
// `chance` is the row's share of the score above (it was 1/16 while the pick
// was uniform); times the aiming table's density where the row has one; then
// area to solid angle by the usual d^2 / cos.
float EmitterPdf(float area, float density, float chance, float distance2, float cosLight)
{
	if (area <= 0.0 || cosLight <= 1.0e-4 || chance <= 0.0)
		return 0.0;
	return chance * density * distance2 / (area * cosLight);
}

// **RT-11: one aimed sample, weighed against the lobe ray that was cast anyway.**
//
// The two strategies answer the same question -- how much emitter light reaches
// this texel -- and each is hopeless where the other is good. A mirror's lobe is
// a needle: aiming at a lamp almost never lands on it, and the mirror ray finds
// it every frame. A rough floor's lobe is a dish: the lamp is a small part of it
// and the ray finds it once in fifty frames, at fifty times the brightness.
//
// Balance-heuristic weights, so the sum of the two is the same picture and
// neither is counted twice. What that buys here is not just less variance but a
// *bound*: the aimed sample's value is Le * pLobe / (pLobe + pLight), which can
// never exceed the lamp's own radiance however narrow the lobe gets. The lucky
// ray that used to return three hundred levels now returns what it is worth.
vec3 AimedAtEmitters(vec3 P, vec3 N, vec3 V, float roughness, int emitters, inout uint seed)
{
	// The row, by its share of the score. Kept in a register file rather than
	// scored twice: the first build walked the rows once to total them and
	// again to find the draw, and each walk is sixteen rows times three probes
	// times a GGX evaluation -- the single largest thing this pass added, and
	// it was buying the same sixteen numbers twice.
	float score[16];
	float total = 0.0;
	for (int i = 0; i < 16; ++i)
	{
		score[i] = i < emitters ? EmitterScore(P, N, V, roughness, u_Emitters[i]) : 0.0;
		total += score[i];
	}
	if (total <= 0.0)
		return vec3(0.0);

	const float draw = GiRandom(seed) * total;
	int pick = emitters - 1;
	float walked = 0.0;
	for (int i = 0; i < 16; ++i)
	{
		walked += score[i];
		// `score[i] > 0` as well as the sum: a draw of exactly zero would
		// otherwise land on row zero whatever it is worth, and a row worth
		// nothing has a probability of nothing -- dividing by which turns
		// one texel into a white spot.
		if (score[i] > 0.0 && walked >= draw)
		{
			pick = i;
			break;
		}
	}
	const float chance = max(score[pick], 1.0e-9) / total;
	const GiEmitter light = u_Emitters[pick];

	float su = 0.0;
	float sv = 0.0;
	float density = 1.0;
	vec2 aimUv = vec2(0.0);

	const int grid = int(light.Aim.y + 0.5);
	if (grid > 0)
	{
		// The cell, by binary search over the cumulative table -- the bounce's
		// sampler exactly, including its power-of-two shift in place of a
		// runtime integer divide.
		const int base = int(light.Aim.x + 0.5);
		const int cells = grid * grid;
		const float draw = GiRandom(seed);
		const int shift = int(light.Aim.w + 0.5);
		int low = 0;
		int high = cells - 1;
		for (int step = 0; step < 12 && low < high; step++)
		{
			const int mid = (low + high) >> 1;
			if (u_EmitterCdf[base + mid] < draw)
				low = mid + 1;
			else
				high = mid;
		}
		const float upper = u_EmitterCdf[base + low];
		const float lower = low > 0 ? u_EmitterCdf[base + low - 1] : 0.0;
		const float chance = max(upper - lower, 1e-9);
		const vec2 cell = vec2(float(low & (grid - 1)), float(low >> shift));
		aimUv = (cell + vec2(GiRandom(seed), GiRandom(seed))) / float(grid);
		su = light.UvToSurface0.x * aimUv.x + light.UvToSurface0.y * aimUv.y + light.UvToSurface0.z;
		sv = light.UvToSurface1.x * aimUv.x + light.UvToSurface1.y * aimUv.y + light.UvToSurface1.z;
		density = chance * float(cells);
	}
	else
	{
		su = GiRandom(seed) * 2.0 - 1.0;
		sv = GiRandom(seed) * 2.0 - 1.0;
	}

	// **Out to the face the fitting turns toward this texel** (RT-11).
	//
	// The rectangle is built at the mesh's bounding-box centre, so it sits
	// inside the housing and a ray aimed at it is stopped by the housing's own
	// shell -- which is why every aimed sample this engine took came back
	// black. Stepping the point out by half the fitting's thickness, on
	// whichever side this texel is, puts it on the surface the light actually
	// leaves from: the ray then arrives without anything being made
	// transparent, and a texel the fitting genuinely faces away from is still
	// occluded by it, as it should be.
	const vec3 lightNormal = vec3(light.TangentU.w, light.TangentV.w, light.Radiance.w);
	const vec3 flat_ = light.CentreArea.xyz
					 + light.TangentU.xyz * su
					 + light.TangentV.xyz * sv;
	const float side = dot(P - flat_, lightNormal) >= 0.0 ? 1.0 : -1.0;
	const vec3 point = flat_ + lightNormal * (light.UvToSurface1.w * side);
	vec3 toLight = point - P;
	const float distance2 = max(dot(toLight, toLight), 1e-6);
	const float dist = sqrt(distance2);
	toLight /= dist;

	if (dot(N, toLight) <= 0.0)
		return vec3(0.0);
	// Two-sided: a fitting recessed into a ceiling is one plane, and which way
	// its winding runs is not something a scene should have to know.
	const float cosLight = abs(dot(lightNormal, toLight));
	if (cosLight <= 1.0e-4)
		return vec3(0.0);

	const float pLight = EmitterPdf(light.CentreArea.w, density, chance, distance2, cosLight);
	if (pLight <= 0.0)
		return vec3(0.0);
	const float pLobe = LobePdf(N, V, toLight, roughness);
	// The weight and the conversion at once: (pLobe / pLight) * the aimed
	// sample's weight. **The power heuristic, not the balance (RT-22,
	// 2026-09-23)**: the balance left the aimed ray a share on a near-mirror,
	// where the lobe ray is the better estimator, and at a glowing object's edge
	// that share jumped frame to frame -- the grain on the car window's
	// reflection of a moving glowing cube, owner-judged gone with this. Measured
	// inert on the parked floor against the 16-ray truth (2026-09-22).
	// (pLobe / pLight) * (pLight^2 / (pLobe^2 + pLight^2)).
	const float share = pLobe * pLight / max(pLobe * pLobe + pLight * pLight, 1.0e-18);
	if (share <= 0.0)
		return vec3(0.0);

	// Only whether anything blocks -- terminate on the first hit, no attributes
	// and no shading. Shortened by a hair so it ends before the lamp's own
	// surface rather than inside it.
	// Through the fitting's own shell, which the rectangle sits inside of, and
	// nothing else: see g_ShadowThroughEmitters. Cleared straight after, so the
	// rays this pass casts for anything else are unchanged.
	// No pass-through: the point above is on the fitting's own face, so the
	// ray stops just short of it and the shell is no longer in the way. It was
	// needed while the point was the rectangle's centre, and letting a ray
	// through the whole fitting also let a wall see tubes the housing should
	// have hidden -- thirteen display levels, measured at sixteen rays.
	const float visible = TraceShadowFrom(P, N, toLight, dist * 0.999);
	if (visible <= 0.0)
		return vec3(0.0);

	// With a table Radiance is the material's unfolded scalar and the map says
	// what share of it this texel emits; without one it already carries the
	// map's average.
	vec3 radiance = light.Radiance.rgb;
	if (grid > 0)
		radiance *= textureLod(u_Textures[nonuniformEXT(int(light.Aim.z + 0.5))], aimUv, 0.0).rgb;
	return radiance * share * visible;
}

// **And how much of a struck lamp's own glow this ray may still keep**: the
// other half of the same weighting. One where the hit is not on a listed
// emitter, so every ordinary surface is untouched; near one on a mirror, where
// the lobe ray is the better estimator and always was; near zero on a rough
// floor, where the aimed sample above is now carrying that light smoothly and
// counting the lucky ray as well would count it twice.
float StruckEmitterShare(vec3 P, vec3 N, vec3 V, vec3 L, float roughness,
						 vec3 hitPoint, uint identity, int emitters)
{
	const int index = EmitterOf(identity, emitters);
	if (index < 0)
		return 1.0;
	const GiEmitter light = u_Emitters[index];
	const float density = EmitterDensityAt(light, hitPoint);
	const vec3 toLight = hitPoint - P;
	const float distance2 = max(dot(toLight, toLight), 1e-6);
	const vec3 lightNormal = vec3(light.TangentU.w, light.TangentV.w, light.Radiance.w);
	const float cosLight = abs(dot(lightNormal, normalize(toLight)));
	// The same chance the pick would have given this row, so the two weights
	// still sum to one at every point on it.
	const float chance = EmitterChance(P, N, V, roughness, emitters, index);
	const float pLight = EmitterPdf(light.CentreArea.w, density, chance, distance2, cosLight);
	if (pLight <= 0.0)
		return 1.0;
	const float pLobe = LobePdf(N, V, L, roughness);
	// The power heuristic, as the aimed sample's weight above is (RT-22).
	return pLobe * pLobe / max(pLobe * pLobe + pLight * pLight, 1.0e-18);
}
#endif

void main()
{
#if defined(RV_REFLECTION_RECORD)
	o_Record0 = vec4(0.0);
	o_Record1 = vec4(0.0);
	o_Record2 = vec4(0.0);
	o_Record3 = vec4(0.0);
	// **One pixel of this block, a different one each frame.**
	const ivec2 block = ivec2(gl_FragCoord.xy);
	const ivec2 size = textureSize(u_Surface, 0);
	const uint pick = BudgetHash(uint(block.x) ^ (uint(block.y) << 16u)
								 ^ (uint(u_Scene.GlobalIllumination.y) * 0x27D4EB2Du) ^ 0x5BD1E995u) % 9u;
	const ivec2 texel = min(block * 3 + ivec2(int(pick % 3u), int(pick / 3u)), size - 1);
	const vec4 surface = texelFetch(u_Surface, texel, 0);
	if (surface.b <= 0.0)
		return;
#elif defined(RV_REFLECTION_RELIGHT)
	o_Change = vec4(0.0, -1.0, 0.0, -1.0);
	o_ChangeGuide = vec4(0.0);
	// **Last frame's sampled pixel.** A block with no traced surface, or one that
	// moved, says nothing about the light.
	const ivec2 block = ivec2(gl_FragCoord.xy);
	const vec4 record0 = texelFetch(u_Record0, block, 0);
	const vec4 record2 = texelFetch(u_Record2, block, 0);
	const uint recordFlags = uint(record0.w);
	if ((recordFlags & 1u) == 0u || (recordFlags & 4u) != 0u)
		return;
	const ivec2 texel = ivec2(int(recordFlags >> 3u), int(record2.w));
	const vec4 surface = texelFetch(u_Record1, block, 0);
	g_TraceCamera = u_Lamps.Probe.xyz;
	g_TracePixel = vec2(texel) + 0.5;
	g_TraceFrame = mod(u_Lamps.Probe.w, 1024.0);
#else
	o_Reflection = vec4(0.0, 0.0, 0.0, -1.0);
	o_Hit = vec4(0.0);
	o_HitIdentity = vec4(0.0);
	o_HitTravel = vec4(0.0);

	const ivec2 texel = ivec2(gl_FragCoord.xy);
	const ivec2 size = textureSize(u_Surface, 0);
	const vec4 surface = texelFetch(u_Surface, texel, 0);
	if (surface.b <= 0.0)
		return;
#endif

	// The same window the lit shader weighs its mirror by: outside it the
	// probe answers alone and no ray is cast.
	const float roughness = clamp(surface.b, 0.0, 1.0);
	const vec2 gloss = u_Lamps.Trace.yz;
	const float mirror = 1.0 - smoothstep(gloss.x, gloss.y, roughness);
	if (mirror <= 0.0)
		return;

#ifdef RV_REFLECTION_RELIGHT
	const vec3 P = record0.xyz;
	const vec3 N = SurfaceNormal(surface.rg);
	const vec3 V = normalize(u_Lamps.Probe.xyz - P);
	const uint frame = uint(u_Lamps.Probe.w);
#else
	const float depth = texelFetch(u_Depth, texel, 0).r;
	if (depth >= 1.0)
		return;

	// Texel to the world: a row is a projected coordinate the other way up
	// on the backend whose rows run down, the same fact the lamp passes carry
	// in History.w. Clip z is the depth as written.
	const vec2 uv = (vec2(texel) + 0.5) / vec2(size);
	const float row = u_Lamps.History.w > 0.5 ? 1.0 - uv.y : uv.y;
	const vec4 clip = u_Lamps.InverseViewProjection
					* vec4(uv.x * 2.0 - 1.0, row * 2.0 - 1.0, depth, 1.0);
	const vec3 P = clip.xyz / clip.w;
	const vec3 N = SurfaceNormal(surface.rg);
	const vec3 V = normalize(u_Scene.CameraPosition.xyz - P);
	const uint frame = uint(u_Scene.GlobalIllumination.y);
#endif
#if defined(RV_REFLECTION_RECORD)
	// **The record, and nothing traced.** The luminance is of what the trace
	// wrote at this pixel -- through its half-float target, as the re-light's
	// comparison allows for.
	{
		// Moved on its own, the camera's motion taken out (include/change_record.glsl).
		const bool moving = RecordMovedOnItsOwn(texelFetch(u_Velocity, texel, 0).xy, P,
												vec2(textureSize(u_Velocity, 0)));
		const vec4 wrote = texelFetch(u_Traced, texel, 0);
		const uint flags = (wrote.a >= 0.0 ? 1u : 0u) | (moving ? 4u : 0u);
		o_Record0 = vec4(P, float((uint(texel.x) << 3u) | flags));
		o_Record1 = surface;
		o_Record2 = vec4(dot(wrote.rgb, vec3(0.2126, 0.7152, 0.0722)),
					  texelFetch(u_HitTravel, texel, 0).w, 0.0, float(texel.y));
		o_Record3 = texelFetch(u_Albedo, texel, 0);
		return;
	}
#endif

	// One ray a texel. The preset's MirrorRays column, which used to be the
	// count drawn here, sets how many neighbours' rays the resolve gathers
	// instead (WR-16 R3, 2026-09-06); the tile allocator's per-tile scaling
	// of that count went with it and would return as a scaling of the taps.
	const vec3 direction = GlossyReflectionLD(N, V, roughness, texel, frame, 0u);
	const TracedSurface hit = TraceSurface(P, N, direction, 1.0e4);
	// **The probe at the hit, not slot zero** (2026-09-15). Trace.x is documented as
	// "the probe a traced hit is lit by" and has always been zero -- the sky, black
	// inside a closed room. The lit shader's in-line ray lit its hit with the
	// reflector's probe and the bounce lights its hits with the probe at the hit;
	// this pass now does the latter, for the hit's diffuse and its specular alike.
	const float hitProbe = ProbeSlotAt(hit.Position);
	vec3 radiance = hit.Missed
				  ? hit.Sky
				  : ShadeTraced(hit, ProbeIrradiance(hit.Normal, hitProbe), hitProbe);
	const float travelled = hit.Missed ? 1.0e4 : length(hit.Position - P);
	// **How much of what came back is the thing itself glowing (2026-09-21).**
	// Declared for every variant, because the attachment is written by all of them.
	float emissiveSum = hit.Missed ? 0.0 : dot(hit.Emissive, vec3(0.2126, 0.7152, 0.0722));
#if !defined(RV_REFLECTION_RECORD)
	// **RT-11: and one ray aimed straight at a lamp, for every ray drawn from
	// the lobe.** See AimedAtEmitters. Zero emitters leaves every line below
	// inert and this pass bit-identical to what it was.
	const int emitters = clamp(int(u_Lamps.Nee.x + 0.5), 0, 16);
	// Its own stream, seeded by the texel and the frame -- not the lattice the
	// directions are drawn from, which is a fixed sequence a texel walks and
	// would tie where the sample lands on the lamp to which way the ray went.
	uint neeSeed = GiHash(uint(texel.x) * 73856093u ^ uint(texel.y) * 19349663u
						  ^ frame * 83492791u);
	if (emitters > 0)
	{
		// What is left of a struck lamp's own glow once the aimed sample is
		// carrying that light, and the whole of it where the ray struck
		// anything else. `IsEmitter` first so an ordinary hit -- which is
		// almost every hit -- never walks the rows.
		const float share = (hit.Missed || !hit.IsEmitter) ? 1.0
						  : StruckEmitterShare(P, N, V, direction, roughness,
											   hit.Position, hit.Identity, emitters);
		const vec3 kept = hit.Missed ? vec3(0.0) : hit.Emissive * share;
		if (!hit.Missed)
			radiance = max(radiance - (hit.Emissive - kept), vec3(0.0));
		const vec3 aimed = AimedAtEmitters(P, N, V, roughness, emitters, neeSeed);
		radiance += aimed;
		// The clamp downstream reads this lane to tell a ray that found a lamp
		// from a ray that got lucky (2026-09-21). With the aimed sample most of
		// a lamp's light no longer arrives as a hit, so the lane now carries
		// both halves -- what the ray kept and what the aim brought.
		emissiveSum = dot(kept + aimed, vec3(0.2126, 0.7152, 0.0722));
	}
#endif
#if !defined(RV_REFLECTION_RECORD)
#if defined(RV_REFLECTION_RELIGHT)
	// **The count the trace drew here, from the record (2026-09-22).** A re-light
	// casting one ray against a record that averaged several read the difference
	// as the light changing, wherever the count was raised -- the young tiles
	// while something moves, which is exactly when the check runs.
	const int rays = clamp(int(record2.y + 0.5), 1, 16);
#else
	// **RT-15b: more rays where the surface moves on its own.** A flat mirror sliding
	// in its own plane shows a still picture, so a screen texel's history is only as
	// old as the frames the mirror has covered it: the strip at its leading edge is
	// new reflected content every frame, and one ray a texel at roughness 0.12 needs
	// tens of frames to settle -- the chrome cube's face was speckle and 4-texel bands
	// (2026-09-15). A curved mover's image history is young for the same reason. So a
	// texel whose surface moved on its own this frame (the velocity lane with the
	// camera's motion taken out, as the change record asks it) casts Trace.x rays and
	// writes their mean; every other texel casts its one, bit for bit as before. The
	// cost is the moving texels' alone: a few thousand extra rays a frame for the cube,
	// against the million and a half this pass casts.
	// **RT-9: the rays follow what the accumulator knew here last frame.**
	//
	// Every filter in this engine works out how much it trusts its memory and throws the answer
	// away; the four lanes above are that answer, kept. Where the history was refused, or has
	// only just begun, or there was none at all, reconstruction cannot answer and a ray can;
	// where it has settled, one ray is all a texel needs and the average carries the rest. The
	// specification's constraint is that the budget is *spent* differently, not raised: this
	// replaces RT-15b's flat "four rays on anything moving on its own", which paid for a whole
	// moving face to fix the strip at its leading edge.
	//
	// Last frame's texel is found by the velocity lane, which carries the camera's motion and
	// the object's together -- the same arm the accumulator reprojects by, in the same units
	// (`byMotion = nowNdc - 2 * velocity`). Off screen, or where the reflector kept there was
	// another object's or none, the texel is new: it gets the most.
	int rays = 1;
	if (u_Lamps.History.z > 0.5)
	{
		// The tile's count, decided before this pass ran from the share of the tile whose
		// history had just begun, and held there by the ray budget's dead band and dwell.
		const vec2 tileUv = (vec2(texel) + 0.5) / vec2(size);
		const float allocated = texture(u_TileRays, vec2(tileUv.x,
															  u_Lamps.History.w > 0.5 ? 1.0 - tileUv.y : tileUv.y)).r;
		rays = clamp(int(allocated + 0.5), 1, clamp(int(u_Lamps.Trace.x + 0.5), 1, 16));
	}
	else
	{
		// RT-15b's rule, kept behind `--reflection-confidence-rays=off`: four rays wherever
		// the surface moves on its own, one everywhere else.
		const int movingRays = clamp(int(u_Lamps.Trace.x + 0.5), 1, 16);
		if (movingRays > 1 && RecordMovedOnItsOwn(texelFetch(u_Velocity, texel, 0).xy, P, vec2(size)))
			rays = movingRays;
	}
#endif
	vec3 radianceSum = radiance;
	// The clamp downstream has to tell a ray that found a lamp from a ray that got
	// lucky, and by the time it sees them they are both just a bright number. The hit
	// knows: a surface that emits carries it here, and nothing has ever written it
	// down -- `o_Hit`'s fourth lane has been a literal zero since the pass was built.
	float travelledSum = travelled;
	vec3 directionSum = direction;
	vec3 travelSum = hit.Missed ? vec3(0.0) : hit.Travel;
	float moversStruck = (!hit.Missed && dot(hit.Travel, hit.Travel) > 0.0) ? 1.0 : 0.0;
	for (int r = 1; r < rays; ++r)
	{
		const vec3 more = GlossyReflectionLD(N, V, roughness, texel, frame, uint(r));
		const TracedSurface hitMore = TraceSurface(P, N, more, 1.0e4);
		const float probeMore = ProbeSlotAt(hitMore.Position);
		vec3 arrived = hitMore.Missed
					 ? hitMore.Sky
					 : ShadeTraced(hitMore, ProbeIrradiance(hitMore.Normal, probeMore), probeMore);
		float glow = hitMore.Missed ? 0.0
				   : dot(hitMore.Emissive, vec3(0.2126, 0.7152, 0.0722));
		// RT-11: this ray's own aimed sample, on its own turn of the stream.
		if (emitters > 0)
		{
			neeSeed = GiHash(neeSeed ^ (uint(r) * 0x9E3779B9u));
			const float shareMore = (hitMore.Missed || !hitMore.IsEmitter) ? 1.0
								  : StruckEmitterShare(P, N, V, more, roughness,
													   hitMore.Position, hitMore.Identity,
													   emitters);
			const vec3 keptMore = hitMore.Missed ? vec3(0.0) : hitMore.Emissive * shareMore;
			if (!hitMore.Missed)
				arrived = max(arrived - (hitMore.Emissive - keptMore), vec3(0.0));
			const vec3 aimedMore = AimedAtEmitters(P, N, V, roughness, emitters, neeSeed);
			arrived += aimedMore;
			glow = dot(keptMore + aimedMore, vec3(0.2126, 0.7152, 0.0722));
		}
		radianceSum += arrived;
		emissiveSum += glow;
		travelledSum += hitMore.Missed ? 1.0e4 : length(hitMore.Position - P);
		directionSum += more;
		if (!hitMore.Missed && dot(hitMore.Travel, hitMore.Travel) > 0.0)
		{
			travelSum += hitMore.Travel;
			moversStruck += 1.0;
		}
	}
	radiance = radianceSum / float(rays);
	emissiveSum /= float(rays);
#endif

	// **The surface's own reflectance, in colour.** The same split-sum term
	// the lit shader applies to the probe -- F0 * envBRDF.x + envBRDF.y --
	// built from the same F0: 0.08 * specular for a dielectric, the albedo
	// itself for a metal. Applied here rather than in the composite because
	// the composite has one scalar and no way to know the surface, and this
	// pass already has the normal, the view vector and the roughness.
	//
	// The lit shader used to do this and collapse it to a luminance, because
	// the weight it passes on has one channel. That is what made gold reflect
	// grey. Stored tinted, the picture is what it always should have been.
#ifdef RV_REFLECTION_RELIGHT
	const vec4 albedo = texelFetch(u_Record3, block, 0);
#else
	const vec4 albedo = texelFetch(u_Albedo, texel, 0);
#endif
	const vec3 F0 = mix(vec3(0.08 * clamp(albedo.a, 0.0, 1.0)), albedo.rgb,
						clamp(surface.a, 0.0, 1.0));
	const vec2 envBRDF = EnvBRDF(max(dot(N, V), 0.0), roughness);
	const vec3 reflectance = F0 * envBRDF.x + envBRDF.y;
	// **Only the tint's hue, never its magnitude.**
	//
	// The lit shader already sends the compositor the right *amount* of
	// reflection -- the split-sum term collapsed to a luminance -- and that
	// number is correct. What it cannot send is the *colour*, because it has
	// one channel, and its own comment said so: "one channel, so a coloured
	// metal's tint is not carried". F0 for a metal is the metal's own colour,
	// so gold has been reflecting the room in grey.
	//
	// So this multiplies by the reflectance **divided by its own luminance** --
	// a tint whose brightness is exactly one. The picture's magnitude is
	// therefore bit-for-bit what it was and only its hue changes, which is the
	// whole of the defect. Applying the reflectance raw was tried first and made
	// the garage floor four times brighter: the magnitude this pass computes and
	// the one the lit shader computes do not agree, and finding out why is a
	// separate question from carrying the colour. This fix does not depend on
	// the answer.
	const float tintLuma = dot(reflectance, vec3(0.2126, 0.7152, 0.0722));
	const vec3 tint = tintLuma > 1.0e-5 ? reflectance / tintLuma : vec3(1.0);
#if defined(RV_REFLECTION_RELIGHT)
	// **The change at this block: the same ray, traced into this frame's scene,
	// against what it found last frame.** A difference inside a half-float step
	// and a hair is the write, not the light.
	{
		const float now = dot(min(radiance, vec3(64.0)) * tint, vec3(0.2126, 0.7152, 0.0722));
		float delta = now - record2.x;
		const float reference = max(max(now, record2.x), 0.0);
		if (abs(delta) <= 0.004 * reference + 1.0e-4)
			delta = 0.0;
		o_Change = vec4(delta, reference, 0.0, 0.0);
		o_ChangeGuide = vec4(N, dot(N, P));
	}
#elif !defined(RV_REFLECTION_RECORD)
	o_Reflection = vec4(min(radiance, vec3(64.0)) * tint, travelledSum / float(rays));
	// GGX sampled by its distribution of half vectors: pdf(L) = D(H) NoH / (4 VoH).
	const vec3 H = normalize(direction + V);
	const float pdf = DistributionGGX(N, H, roughness) * max(dot(N, H), 1.0e-4)
					/ (4.0 * max(dot(V, H), 1.0e-4));
	// RT-15b: the rays' mean direction where there were several -- the resolve re-aims
	// the texel's hit point from it; the pdf is the first ray's, as unread as it was.
	o_Hit = vec4(OctEncode(rays > 1 ? normalize(directionSum) : direction), min(pdf, 6.0e4),
				 min(emissiveSum, 6.0e4));
	// RT-17: the identity, and the struck normal as five bits each way.
	const vec2 struck = hit.Missed ? vec2(0.0) : floor(OctEncode(hit.Normal) * 31.0 + 0.5);
	o_HitIdentity = vec4(float(hit.Missed ? 0u : hit.Identity),
						 struck.x * 32.0 + struck.y + (!hit.Missed && hit.Moving ? 1024.0 : 0.0), 0.0, 0.0);
	// RT-15: bounded well inside the half float, so a teleport reads as a long way
	// rather than as infinity.
	// RT-15b: over several rays, the mean travel of those that struck a mover (as the
	// accumulator's MoverTravel averages a 3x3); the texel then counts as a mover's.
	o_HitTravel = rays > 1
				? vec4(moversStruck > 0.0 ? clamp(travelSum / moversStruck, vec3(-1.0e4), vec3(1.0e4)) : vec3(0.0), float(rays))
				: vec4(hit.Missed ? vec3(0.0) : clamp(hit.Travel, vec3(-1.0e4), vec3(1.0e4)), float(rays));
#endif

	// The ray above and the shadow rays its hit walked: flushed here, since
	// the lit shader's flush is compiled out under RV_TRACE_ONLY. `false`:
	// the lit pass already counted this pixel as a lit fragment.
#ifdef RV_RAY_COUNTERS
	FlushRayCounters(false);
#endif
}
