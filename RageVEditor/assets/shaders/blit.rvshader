// A straight copy.
//
// Exists because the chain has to land in the target the caller asked for even
// when anti-aliasing is off -- without it, turning FXAA off would leave the
// image in an intermediate nobody presents.

#type vertex
#version 450 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 450 core

layout(location = 0) in vec2 v_UV;
layout(location = 0) out vec4 o_Color;

layout(set = 0, binding = 0) uniform sampler2D u_Source;

layout(push_constant) uniform Params
{
	vec2  TexelSize;
	float Unused0;
	float Unused1;
	float Unused2;
	float FlipY;
} u_Params;

void main()
{
	// The destination row this fragment writes and the source row v_UV
	// names are the same row on OpenGL and opposite rows on Vulkan. See
	// PostProcess::Dispatch.
	vec2 uv = vec2(v_UV.x, u_Params.FlipY > 0.5 ? 1.0 - v_UV.y : v_UV.y);

	o_Color = vec4(texture(u_Source, uv).rgb, 1.0);
}
