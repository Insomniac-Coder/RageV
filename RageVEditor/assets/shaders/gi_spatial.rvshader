// **The indirect buffer's spatial stage, rebuilt strict.**
//
// The first version of this shader was deleted the same day it shipped, and
// the post-mortem is the specification here. It loosened its edge-stopping
// tests wherever a pixel's neighbourhood disagreed with itself -- SVGF's
// variance idea -- and both halves of that went wrong: the ratio it measured
// disagreement with exploded wherever the scene was dark, and the slack it
// bought was spent loosening the one test that keeps two surfaces apart.
// Blotches at every tail light, measured and confirmed by switching the pass
// off.
//
// So this version adapts NOTHING. Three a-trous iterations at stride 1, 2, 4,
// guided by depth and normal with fixed tolerances:
//
// - **The normal test is never relaxed.** pow(dot, 8) decides whether two
//   points are the same surface, and a noisy pixel is not evidence that its
//   neighbour is on its plane. Where a crease starves the filter of
//   neighbours, the crease stays a little noisy -- noisy-but-honest, which
//   the temporal stage behind this can still work on, instead of
//   smooth-but-wrong, which nothing downstream can undo.
// - **Reach capped at stride 4.** The first version's widest ring sampled a
//   sparse regular lattice and drew a periodic scallop along every crease;
//   periodic structure cannot come from a ray tracer, and that was the tell.
// - **No brightness-relative anything.** Every tolerance is absolute, so a
//   dark region behaves exactly like a bright one.
//
// Indirect light is the lowest-frequency thing in the frame -- two points a
// few pixels apart on the same surface receive very nearly the same bounce,
// which is the assumption the whole irradiance-field feature already stands
// on at metre scale. That is why borrowing from neighbours is sound, and why
// the guides' only job is "same surface", asked strictly.

#type vertex
#version 450 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 450 core

#include "include/view_reconstruction.glsl"

layout(location = 0) in vec2 v_UV;
layout(location = 0) out vec4 o_Color;

layout(set = 0, binding = 0) uniform sampler2D u_Indirect;
layout(set = 0, binding = 1) uniform sampler2D u_Depth;
layout(set = 0, binding = 2) uniform sampler2D u_Surface;

layout(push_constant) uniform Params
{
	float TexelX;          // PostParams' shared header
	float TexelY;
	float Stride;          // A: 1, 2, 4 across the three passes
	float DepthSigma;      // B: metres that still count as the same surface
	float NormalPower;     // C: how sharply the normal test falls off
	float FlipY;

	float NearClip;
	float FarClip;
	float InvP0;
	float InvP1;
} u_Gi;

void main()
{
	const bool flip = u_Gi.FlipY > 0.5;
	const vec2 uv = vec2(v_UV.x, flip ? 1.0 - v_UV.y : v_UV.y);
	const vec2 texel = vec2(u_Gi.TexelX, u_Gi.TexelY);

	const vec4 centre = texture(u_Indirect, uv);

	// Sky, or something the scene pass never drew: nothing to filter, and
	// smearing the surfaces around it into it is worse than leaving it.
	const vec4 centreSurface = texture(u_Surface, uv);
	if (SurfaceIsEmpty(centreSurface))
	{
		o_Color = centre;
		return;
	}

	const float centreDepth = LinearDepth(texture(u_Depth, uv).r,
										  u_Gi.NearClip, u_Gi.FarClip);
	const vec3 centreNormal = OctDecode(centreSurface.rg);

	// The separable 1-4-6-4-1 tent every a-trous implementation uses: a good
	// enough low-pass that the guides do the interesting work.
	const float kernel[5] = float[5](0.0625, 0.25, 0.375, 0.25, 0.0625);

	vec4 sum = vec4(0.0);
	float weightSum = 0.0;

	for (int y = -2; y <= 2; y++)
	{
		for (int x = -2; x <= 2; x++)
		{
			const vec2 offset = vec2(x, y) * u_Gi.Stride * texel;
			const vec2 tapUv = uv + vec2(offset.x, flip ? -offset.y : offset.y);

			// Off the buffer: no sample, rather than the clamped edge texel
			// counted several times over.
			if (any(lessThan(tapUv, vec2(0.0))) || any(greaterThan(tapUv, vec2(1.0))))
				continue;

			const vec4 tapSurface = texture(u_Surface, tapUv);
			if (SurfaceIsEmpty(tapSurface))
				continue;

			// **Same plane?** Depth rejects a wall behind a floor; the normal
			// rejects the two faces of a corner, which sit at almost the same
			// depth and must not share their bounce. Both tolerances are
			// constants -- see the header for what adapting them cost.
			const float tapDepth = LinearDepth(texture(u_Depth, tapUv).r,
											   u_Gi.NearClip, u_Gi.FarClip);
			const float depthWeight =
				exp(-abs(tapDepth - centreDepth) / max(u_Gi.DepthSigma, 1.0e-4));

			const vec3 tapNormal = OctDecode(tapSurface.rg);
			const float normalWeight =
				pow(max(dot(centreNormal, tapNormal), 0.0), u_Gi.NormalPower);

			const float w = kernel[x + 2] * kernel[y + 2] * depthWeight * normalWeight;
			sum += texture(u_Indirect, tapUv) * w;
			weightSum += w;
		}
	}

	// Every neighbour rejected -- a lone pixel on a thin surface. Its own
	// value is the honest answer, and dividing by zero is not.
	o_Color = weightSum > 1.0e-5 ? sum / weightSum : centre;
}
