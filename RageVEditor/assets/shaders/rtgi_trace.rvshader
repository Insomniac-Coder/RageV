// Ray-traced global illumination, as a pass.
//
// **Why this is not in the lit shader any more.** It was, and everything it
// needs is bound there, which is the argument the original made. What that
// costs is a resolution: an attachment has one size, so four bounce rays were
// cast for every shaded fragment of a full-resolution frame -- 5.8 million
// rays -- while ambient occlusion did the same class of tracing at half
// resolution for a ninth of the cost. Indirect light is the lowest-frequency
// thing in the frame and the one paying full rate for it.
//
// As a pass it has a target, and a target has a scale. The quality dial that
// the screen-space and voxel gathers have always had (7az) can finally mean
// the same thing here.
//
// It borrows rather than copies: RV_TRACE_ONLY drops the lit shader's vertex
// stage -- its nine varyings, its four outputs, its cluster lookup and its
// surface sampling -- and keeps set 0, the material heap and TraceSurface. A
// second copy of that light loop is how two renderers start disagreeing about
// what a hit looks like.
//
// Output is raw irradiance, **albedo-free**: the lit shader multiplies by the
// surface's own base colour when it reads the accumulated buffer next frame.
// The same contract the in-shader version wrote, so the denoise and the read
// after it are unchanged.

#type vertex
#version 460 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 460 core

#define RV_TRACE_ONLY
#include "include/pbr_fragment.glsl"
#include "include/view_reconstruction.glsl"

layout(location = 0) in vec2 v_UV;
layout(location = 0) out vec4 o_Indirect;

// The scene pass's depth and its surface description, in a set of their own.
// Set 3 rather than a spare binding in set 0: set 0 is the scene's, shared
// with every lit pipeline, and adding to it would change a layout that four
// other shaders reflect.
layout(set = 3, binding = 0) uniform sampler2D u_GiDepth;
layout(set = 3, binding = 1) uniform sampler2D u_GiSurface;

// **The emissive rectangles, so the bounce can aim at them instead of hoping.**
//
// A cosine-sampled hemisphere finds a ceiling luminaire by accident. Most rays
// hit a wall at three percent albedo and return almost nothing; a few hit the
// panel and return several hundred times that. The mean of four such samples is
// right and its *variance* is enormous, which is the speckle -- and variance
// falls as 1/sqrt(N), so twice the rays is thirty percent less noise. That is
// why raising the quality level barely moved it.
//
// Next-event estimation instead: every sample also draws a point on an emitter
// and traces a shadow ray to it. Now every sample sees the panel, and the
// estimate stops depending on whether a ray happened to find it.
//
// Centre and area in the first row, the two half-extents next -- the rectangle
// spans centre +/- U +/- V -- and the radiance last.
struct GiEmitter
{
	vec4 CentreArea;
	vec4 TangentU;
	vec4 TangentV;
	vec4 Radiance;
};

layout(std430, set = 3, binding = 2) readonly buffer GiEmitterBlock
{
	GiEmitter u_Emitters[];
};

layout(push_constant) uniform GiParams
{
	float NearClip;
	float FarClip;
	float InvP0;
	float InvP1;

	float FlipY;
	// How many bounce rays this pixel casts. A push constant rather than a
	// define: a fork earns its place by removing work from the inner loop
	// (8.2), and a loop bound does not.
	float Rays;
	// How many rows of u_Emitters are real. Zero falls back to finding
	// emitters by hemisphere sampling, which is what this did before -- so a
	// scene with no emissive geometry, or more of it than the cap allows,
	// still gets correct light and merely a noisier estimate of it.
	float Emitters;
	float _pad1;

	// The camera-to-world rotation as three rows, and where the camera is:
	// what carries a reconstructed point out into the world the rays are cast
	// in. The same block RTAO carries, for the same reason.
	vec4 CameraRow0;
	vec4 CameraRow1;
	vec4 CameraRow2;
	vec4 CameraPosition;
} u_Gi;

void main()
{
	const bool flip = u_Gi.FlipY > 0.5;
	const vec2 uv = vec2(v_UV.x, flip ? 1.0 - v_UV.y : v_UV.y);

	// **Snapped to the depth texel's centre**, as SSAO's reconstruction is
	// (7an) and as RTAO's ViewPositionAt is -- and this pass needs it more
	// than either, because it is the only one of the three whose own
	// resolution differs from the buffer's (ENGINE-NOTES 7bu).
	//
	// At Medium and below this target is half the frame, so *its* texel
	// centres land on the depth texels' corners: the point fetch takes one of
	// the four and the unsnapped uv describes the junction of all of them.
	// The ray then starts half a full-resolution texel from the point its
	// depth belongs to, along the view ray -- which on a surface the camera
	// sees at a grazing angle is far enough off the plane to beat the 2 mm
	// the origin is lifted by, so the bounce rays hit the surface they left.
	// It reads as a lattice of dashes over anything large and steeply sloped.
	const vec2 depthSize = vec2(textureSize(u_GiDepth, 0));
	const vec2 snapped = (floor(uv * depthSize) + 0.5) / depthSize;

	// Sky, grid, particles, text: anything the PBR shaders did not draw has no
	// surface to bounce light off and no depth worth reconstructing. Snapped
	// too, so the normal and the depth describe the same texel rather than
	// two of the four the junction touches.
	const vec4 surface = texture(u_GiSurface, snapped);
	if (SurfaceIsEmpty(surface))
	{
		o_Indirect = vec4(0.0, 0.0, 0.0, 1.0);
		return;
	}

	// **Minus the jitter** (ENGINE-NOTES 7bq). The depth was drawn through a
	// projection TAA had translated by a sub-pixel offset, so the point this
	// texel describes is the one whose NDC is the texel's minus that offset.
	// A pass that hands the position straight back to ViewToUv never notices;
	// this one casts a real ray from it and cannot cancel the error.
	const float z = LinearDepth(texture(u_GiDepth, snapped).r, u_Gi.NearClip, u_Gi.FarClip);
	const vec2 jitter = vec2(u_Scene.Jitter.x, flip ? -u_Scene.Jitter.y : u_Scene.Jitter.y) * 0.5;
	const vec3 frame = ViewPosition(snapped - jitter, z, vec2(u_Gi.InvP0, u_Gi.InvP1));

	// The reconstruction frame out to the world: undo the row direction and
	// the depth axis, then the camera.
	const vec3 view = vec3(frame.x, flip ? -frame.y : frame.y, -frame.z);
	const vec3 world = u_Gi.CameraPosition.xyz + vec3(dot(u_Gi.CameraRow0.xyz, view),
													  dot(u_Gi.CameraRow1.xyz, view),
													  dot(u_Gi.CameraRow2.xyz, view));

	const vec3 N = OctDecode(surface.rg);

	// The same hash the lit shader used, off the pixel *and* the frame: four
	// rays cannot integrate a hemisphere, and what makes them converge is
	// casting a different four every frame for the denoise to average.
	const uvec2 pixel = uvec2(gl_FragCoord.xy);
	uint seed = GiHash(pixel.x * 0x9E3779B9u ^ pixel.y
					   ^ (uint(u_Scene.GlobalIllumination.y) * 0x85EBCA6Bu));

	const int rays = clamp(int(u_Gi.Rays + 0.5), 1, 32);
	const int bounces = int(u_Scene.GlobalIllumination.z + 0.5);
	const float reach = u_Scene.GlobalIllumination.w > 0.0
					  ? u_Scene.GlobalIllumination.w : 1.0e4;

	const int emitters = clamp(int(u_Gi.Emitters + 0.5), 0, 16);

	// The variance bound both estimators share; the hemisphere block below
	// says why it exists and what it trades.
	const float kIndirectClamp = 4.0;

	vec3 bounced = vec3(0.0);
	for (int i = 0; i < rays; ++i)
	{
		seed += uint(i) * 0x9E3779B9u;

		// --- next event: aim at an emitter --------------------------------
		//
		// One emitter per sample, chosen uniformly, so `count` appears in the
		// estimator below: picking one of N with probability 1/N makes the
		// area density 1/(area * N).
		if (emitters > 0)
		{
			const int pick = int(GiRandom(seed) * float(emitters));
			const GiEmitter light = u_Emitters[min(pick, emitters - 1)];

			// A point on the rectangle. Uniform in area, which is what makes
			// the density constant and the conversion below exact.
			const float su = GiRandom(seed) * 2.0 - 1.0;
			const float sv = GiRandom(seed) * 2.0 - 1.0;
			const vec3 point = light.CentreArea.xyz
							 + light.TangentU.xyz * su
							 + light.TangentV.xyz * sv;

			vec3 toLight = point - world;
			const float distance2 = max(dot(toLight, toLight), 1e-6);
			const float distance = sqrt(distance2);
			toLight /= distance;

			const float NdotL = dot(N, toLight);
			// The emitter's own facing. Two-sided, because a light fitting
			// recessed into a ceiling is modelled as a single plane and which
			// way its winding runs is not something a scene should have to
			// know.
			const vec3 lightNormal = normalize(cross(light.TangentU.xyz, light.TangentV.xyz));
			const float cosLight = abs(dot(lightNormal, toLight));

			if (NdotL > 0.0 && cosLight > 1e-4)
			{
				// The visibility term, and it is the whole reason this is a
				// ray rather than an analytic form: a luminaire behind the car
				// must not light the car's far side.
				//
				// Shortened by a hair so the ray ends *before* the emitter's
				// own surface rather than in it, which would report itself as
				// an occluder.
				//
				// **A visibility ray, and nothing more.** This asked
				// TraceSurface, which finds the *closest* hit and then decodes
				// the triangle, samples the material's maps and runs the whole
				// light loop at it -- including a sun shadow ray of its own --
				// and every bit of that was thrown away to read one bool. The
				// question here is only whether anything blocks, which is what
				// TraceShadowFrom asks: terminate-on-first-hit, no attributes,
				// no shading. Identical answer, a fraction of the work.
				if (TraceShadowFrom(world, N, toLight, distance * 0.999) > 0.0)
				{
					// Area density to solid angle: pdf_w = pdf_A * d^2 / cos.
					// The estimator is Li * cos_surface / pdf_w, and the 1/pi
					// of the Lambert lobe is already outside this loop's
					// convention -- ShadeTraced's callers integrate irradiance,
					// not radiance, so no albedo appears here either.
					//
					// **And the 1/pi, which is this pass's convention rather
					// than a physical constant.** The hemisphere estimator
					// above averages radiance directly -- cosine sampling
					// cancels the cosine and the pi with it -- so what this
					// pass writes is E/pi and the lit shader multiplies by
					// albedo alone. An area estimator has no such cancellation,
					// so the pi has to be put back by hand or the emitters
					// arrive three times too bright.
					const float area = light.CentreArea.w;
					vec3 nee = light.Radiance.rgb * NdotL * cosLight
							 * area * float(emitters) / distance2 * 0.31830989;

					// **Clamped like the hemisphere term, and it was not.**
					// The estimator above is radiance times area over d^2: a
					// surface near a big panel makes it enormous, and a panel
					// partially hidden behind the bay header makes it a
					// lottery -- the sampled point either clears the occluder
					// and pays the whole unclamped term, or does not and pays
					// nothing. Four tickets a frame. On the showroom ceiling
					// that read as white spots flashing 85 display levels for
					// exactly one frame, immune to the denoiser's firefly
					// bound because a whole region flashes together. The same
					// trade as the clamp below: the brightest legitimate
					// near-panel bounce comes back slightly dim, and the
					// lottery stops paying.
					// Eight times the hemisphere's bound, not equal to it: a
					// surface right under the panel legitimately receives far
					// more than a bounce anywhere else does, and the clamp is
					// only here to end the lottery, not to meter the panel.
					// Measured on the showroom ceiling, settled mean and worst
					// one-frame swing: unclamped 63.15 and 90 levels; at 4.0,
					// 61.30 and 6 -- spotless but forty percent of the room's
					// bounce eaten; at 16, 62.11 and 10; at 32, 62.62 and 12,
					// still not one pixel over the 25-level visibility line.
					// So 32: nine tenths of the energy, none of the spots.
					const float kNeeClamp = kIndirectClamp * 8.0;
					const float neePeak = max(nee.r, max(nee.g, nee.b));
					if (neePeak > kNeeClamp)
						nee *= kNeeClamp / neePeak;
					bounced += nee;
				}
			}
		}

		// --- and the hemisphere, for everything that is not an emitter -----
		const vec3 direction = CosineDirection(N, seed);

		TracedSurface first = TraceSurface(world, N, direction, reach);
		// A miss is nothing, not the sky (7bb): the probe already integrates
		// the sky over the whole hemisphere, and adding it here counts it
		// twice.
		if (first.Missed)
			continue;

		// **Probe slot 0, the sky, rather than the shading instance's own.**
		// The in-shader version read v_Probe -- which probe the *receiving*
		// object was assigned -- and a fullscreen pass has no instance to ask.
		// Slot 0 is what an object with no probe of its own gets, and a hit is
		// not the receiver anyway.
		vec3 arriving = ProbeIrradiance(first.Normal, 0.0);
		if (bounces >= 2)
		{
			seed += 0x68BC21EBu;
			const vec3 onward = CosineDirection(first.Normal, seed);
			TracedSurface second = TraceSurface(first.Position, first.Normal, onward, reach);
			arriving = second.Missed ? second.Sky
									 : ShadeTraced(second, ProbeIrradiance(second.Normal, 0.0));
		}

		// **Emissive removed where the emitters answered for it**, and only
		// there. A hit on the luminaire would otherwise be counted twice --
		// once by the shadow ray above and once here -- and the double count
		// is exactly the high-variance term this is trying to be rid of.
		//
		// `first.IsEmitter`, not `emitters > 0`: membership in that list is
		// filtered, by the strength threshold, by the degenerate-rectangle
		// drop and by the sixteen cap. Asking only whether the list is
		// non-empty subtracted the emissive of every surface it left out,
		// which no shadow ray was aiming at -- so their light was removed
		// here and added nowhere, and a scene simply lost it. With the flag
		// the fallback the cap documents is finally the one that happens:
		// what the list omits, the hemisphere term still finds.
		vec3 shaded = max(ShadeTraced(first, arriving) - (first.IsEmitter ? first.Emissive : vec3(0.0)),
						  vec3(0.0));

		// **And a bound on what is left, which is the honest half of this.**
		//
		// Next-event estimation integrates the *emitters* exactly, and that is
		// most of the variance in a room lit by a ceiling. It does nothing for
		// the rest: a white car under that ceiling is itself a bright secondary
		// source, and a ray that happens to hit its bonnet returns thirty times
		// what one that hits the floor does. Those spikes are what is left of
		// the speckle, and no amount of emitter sampling touches them.
		//
		// Clamping trades a little energy for a lot of variance, and it is a
		// *bias* -- the brightest inter-reflections come back slightly dimmer
		// than they should. That is the trade every real-time path tracer
		// makes, and the number is chosen to sit above anything the direct
		// lighting produces so it only ever catches the outliers.
		const float peak = max(shaded.r, max(shaded.g, shaded.b));
		if (peak > kIndirectClamp)
			shaded *= kIndirectClamp / peak;

		bounced += shaded;
	}

	o_Indirect = vec4(bounced / float(rays), 1.0);
}
