// TAA's second half: blend this frame into the accumulated one.
//
// The jitter (ENGINE-NOTES 7r) has already moved the projection by a
// different fraction of a pixel; this is what turns that into an image. Each
// frame contributes a small share, so after a dozen frames a pixel holds the
// average of a dozen sub-pixel positions -- which is supersampling, spread
// over time instead of over fill rate.
//
// **This runs on the linear HDR scene, before bloom and tone mapping**, in
// the same slot as the SSAA resolve and for the same reason: averaging is
// only meaningful where the numbers add up. Two samples of 0.0 and 1.0
// describe a surface that reflected half the light. Averaging after the tone
// curve asks what is halfway between two *display* values, which is a
// different and wrong question -- see ssaa_resolve.rvshader, which makes the
// same argument at more length, and 7n for why FXAA and SMAA have to be on
// the other side of the curve.
//
// Everything below the reprojection is about one problem: **the history is
// often wrong, and blending it in anyway is what ghosting is.** A pixel that
// was hidden behind something last frame has no history; a pixel whose
// surface moved has history belonging to whatever used to be there. Three
// defences, in order of how much they matter:
//
//   1. **Reprojection.** Sample the history where this surface *was*, not
//      where this pixel is. Without it a temporal filter is only correct for
//      a still camera and smears everything else.
//
//   2. **Neighbourhood clipping.** Build the colour box of the 3x3
//      neighbourhood around this pixel and pull the history into it. History
//      that cannot be explained by anything nearby does not belong here. This
//      is a heuristic and worth saying so: it trades ghosting for flicker,
//      and where the line sits is a taste decision -- which is why the blend
//      weight is a number in the inspector rather than a constant somebody
//      chose once.
//
//   3. **A weighted mean.** A single very bright sample dominates a linear
//      average and flickers as it enters and leaves a pixel. Weighting each
//      side by 1/(1+luma) before mixing and undoing it afterwards makes the
//      blend behave like one done in a perceptual space while still producing
//      a linear result.
//
// The clipping is done in **YCoCg** rather than RGB. The neighbourhood of an
// edge is a line through colour space, not a cube, and an RGB bounding box
// around a red-to-blue transition contains magenta -- a colour no pixel in
// the neighbourhood has, and one the history is then free to keep. YCoCg puts
// luminance on its own axis, where most of the variation actually is, so the
// box is a much tighter fit around the same samples.
//
// See docs/ENGINE-NOTES.md section 7r.

#type vertex
#version 450 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 450 core

layout(location = 0) in vec2 v_UV;
layout(location = 0) out vec4 o_Color;
// **What this pixel has learned about itself, for the next frame** -- the
// GI denoiser's second attachment, carried here for the same reason:
//   .x  frames accumulated here, capped
//   .y  running mean of the arriving sample's luminance
//   .z  running mean of its square
// Written on every path, including the early outs: an attachment a path
// forgets holds whatever was in the target, and the next frame would read
// it as a count.
layout(location = 1) out vec4 o_Moments;

layout(set = 0, binding = 0) uniform sampler2D u_Current;
layout(set = 0, binding = 1) uniform sampler2D u_History;
layout(set = 0, binding = 2) uniform sampler2D u_Velocity;
// Last frame's counter and moments, reprojected with the colour. Point
// sampled: a count is not a thing to interpolate.
// **RT-6.6: and read at the same texel the colour is.** When RT-6's
// neighbour search recovers a history one texel over, the count and the
// fluctuation belong to that texel too. Reading them at the centre -- the
// texel the search had just rejected -- weights this pixel's blend by a
// surface it is not blending.
layout(set = 0, binding = 3) uniform sampler2D u_Moments;

// **RT-6: the identity lanes, this frame's and last frame's.** Packed by
// taa_guide.rvshader: clip depth in x, the octahedral shading normal in yz,
// the signed object id in w. Bindings 6 and 7 because 4 is the acceleration
// structure and 5 the counters. Point sampled -- an id interpolated between
// two objects names neither, and a depth halfway between two surfaces is the
// depth of neither.
layout(set = 0, binding = 6) uniform sampler2D u_GuideCurrent;
layout(set = 0, binding = 7) uniform sampler2D u_GuidePrevious;

// **RT-6.2: what the surface under this pixel is made of.** The G-buffer's
// normal attachment, whose B is roughness and A is metallic -- the same lane
// every other pass reads its normal from, so this costs a binding and no
// pass. Point sampled: halfway between two materials is a third material
// that is not there.
layout(set = 0, binding = 8) uniform sampler2D u_Material;

// **WR-16 S0: the validity lane, and its count.** `o_Moments.w` is now one
// where this pixel reused its history and zero where it did not -- the one
// per-pixel validity the ray budget's temporal consumers will read instead
// of each deciding for itself (RAY-BUDGET-DESIGN Part III §5, Part IV
// finding 6). Written on every path, like the rest of the attachment. The
// count of both goes into the frame's ray counters as "temporal confidence"
// -- compiled in only where the counters exist (Vulkan: subgroup ops and
// fragment atomics), which is what RV_RAY_COUNTERS says.
#ifdef RV_RAY_COUNTERS
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
// Sixty-four copies by screen tile, summed on the CPU: see pbr_fragment's
// RayCounterSlot. A fullscreen pass without depth, so the side effect costs
// no early test here.
layout(std430, set = 0, binding = 5) buffer RayCounterBlock
{
	uint Counts[64 * 16];
} u_RayCounters;
const uint RAY_LANE_TAA_PIXELS = 10u;
const uint RAY_LANE_TAA_REUSED = 11u;

uint RayCounterSlot()
{
	const uvec2 px = uvec2(gl_FragCoord.xy);
	return ((px.x >> 3u) + (px.y >> 2u) * 7u) & 63u;
}

// Called once per invocation, at whichever exit it takes. Each exit reduces
// over the lanes that reach it, so a lane is counted exactly once.
void CountTemporal(bool reused)
{
	const bool real = !gl_HelperInvocation;
	const uvec4 realLanes = subgroupBallot(real);
	const bool leader = real && gl_SubgroupInvocationID == subgroupBallotFindLSB(realLanes);
	const uint pixels = subgroupAdd(real ? 1u : 0u);
	const uint kept = subgroupAdd((real && reused) ? 1u : 0u);
	if (leader && pixels > 0u)
	{
		const uint base = RayCounterSlot() * 16u;
		atomicAdd(u_RayCounters.Counts[base + RAY_LANE_TAA_PIXELS], pixels);
		if (kept > 0u)
			atomicAdd(u_RayCounters.Counts[base + RAY_LANE_TAA_REUSED], kept);
	}
}
#else
void CountTemporal(bool reused) {}
#endif

layout(push_constant) uniform Params
{
	// One texel of the scene target.
	vec2  TexelSize;
	// How much of the accumulated image survives each frame. 0.9 means a
	// sample's influence has halved after about seven frames and is gone
	// after thirty.
	float Feedback;
	// Zero on the first frame, after a resize, and any other time the history
	// does not describe this scene at this size.
	float HasHistory;
	// Whether u_Moments holds a real frame yet. Separate from HasHistory: the
	// first frame after a resize has a pair with nothing in it.
	float HasMoments;
	float FlipY;
	// This frame's jitter in clip units (the scene block's Jitter.xy).
	vec2  Jitter;
	// The feedback for a pixel that did not move at all (RenderSettings::
	// TemporalStillFeedback); zero means Feedback. See kStillWithinTexels.
	float StillFeedback;
	// RT-6: one when the identity lanes are bound and hold a real frame, so
	// the geometric test runs; zero on the first frame, after a resize, and
	// under --taa-geometry=off, which is the reference arm.
	float Geometry;
	// RT-6.2: one when the material lane is bound.
	float Material;
	// RT-6.8: one when the colour box may be built from this surface's
	// taps alone. Zero is the reference arm (--taa-box-geometry=off) and
	// is exactly the behaviour before RT-6.8.
	float BoxGeometry;
	float Pad3;
} u_Params;

// **How far the box may open on a surface whose shading does not depend on
// where the eye is.**
//
// The neighbourhood box exists to catch a history that has gone wrong. On a
// smooth metal it earns that every frame: the pixel's colour is a function
// of view direction, so last frame's is genuinely a different answer and the
// box cannot be too tight. On rough concrete it does not: the shading is the
// same from any angle, the history is *right*, and clipping it toward the
// local mean every frame is not protection -- it is the blur. It removes
// precisely the detail the accumulation spent thirty frames building, which
// is why a wet floor's gravel and a brick wall's grain go soft under motion
// while a chrome pole stays crisp.
//
// **Eight, and it is measured rather than guessed** (owner, 2026-09-07).
// It sat at two only because a wider clamp *might* smear behind a moving
// object and no scene here had one. `showroom_moving.rage` now does -- a
// chrome cube crossing a matte wall with the camera still -- and in the band
// the cube has just vacated the residue against the no-history truth is
// **8.56 levels at widen 1, 2, 4 and 8 alike**. The arms are live (1 against
// 8 differs by 0.108 levels across the frame) and differ by 0.021 in the
// trail: the clamp width simply does not reach the ghost.
//
// What stops it ghosting is everything else the resolve does: RT-6's
// geometric test has already refused a history that is a different surface,
// the pixel's own temporal spread still sets the floor, and light that
// genuinely changes on a static rough surface -- a shadow crossing a floor
// -- moves the whole neighbourhood, so the box moves with it rather than
// being escaped. Worth +1.43% detail over widen 1 on the garage dolly.
const float kStableWiden = 8.0;

// **How far the three tests may disagree before the history is refused.**
//
// Depth is compared *relative* to the depth itself, because a depth buffer's
// own precision falls off that way and a fixed tolerance in clip units is a
// millimetre near and a hundred metres far. Two per cent is loose enough
// that a surface sliding under the camera passes and tight enough that a
// wall behind a moving object does not.
const float kDepthTolerance = 0.02;
// The normal, as a cosine. 0.9 is about twenty-five degrees: a curved
// surface turning under the camera keeps its history, a face meeting
// another face at an edge does not.
const float kNormalTolerance = 0.9;

// **RT-6.8: how many of the eight neighbours must be this surface before
// the box is built from them alone.**
//
// The box exists to catch a history that has gone wrong, and it can only
// do that if it describes *this* surface -- at a silhouette the nine taps
// span two, so the range is enormous and the clip passes anything. But a
// box built from one or two samples is nearly a point, and clipping the
// history into a point is the same as discarding it: the pixel shows the
// raw sample every frame and flickers. On a one-pixel cable or picket
// that is exactly what few matching neighbours means.
//
// Nor can the temporal floor cover it there: `temporalSigma` is multiplied
// by `stillness` and is zero for anything moving, which is when this
// matters most.
//
// Three, then: enough to describe a range, and low enough that an ordinary
// silhouette -- four or five of its neighbours are usually the same
// surface -- still gets the tighter box. Below it the full neighbourhood
// stands, so thin geometry keeps today's behaviour rather than trading a
// ghost for a flicker.
const int kLeastSameNeighbours = 3;

// Octahedral decode, the same one the G-buffer encodes with. Local, so this
// pass pulls in no lighting header for two lines of arithmetic.
vec3 DecodeOct(vec2 e)
{
	// **The engine's encoding is [0,1]^2, not [-1,1]^2** -- see
	// include/octahedral.glsl, whose OctEncode ends `e * 0.5 + 0.5`. This
	// copy omitted the matching `e * 2 - 1` and read the square through the
	// wrong fold. Kept local rather than included, for the reason the original
	// gives (no lighting header for four lines of arithmetic) -- but now it is
	// the same four lines.
	e = e * 2.0 - 1.0;
	vec3 n = vec3(e.xy, 1.0 - abs(e.x) - abs(e.y));
	if (n.z < 0.0)
		n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0,
										n.y >= 0.0 ? 1.0 : -1.0);
	return normalize(n);
}

// **RT-12: why the reprojected texel was refused**, in the reflection
// accumulator's own encoding so the two views read alike. Set by the
// centre tap only -- the neighbours are candidates, not this pixel's
// history, and their reasons are not this pixel's story.
const uint kKept        = 0u;
const uint kOffScreen   = 1u;
const uint kNoHistory   = 2u;
const uint kSkyCrossing = 3u;
const uint kObjectId    = 4u;
const uint kDepth       = 5u;
const uint kNormal      = 6u;
uint g_Refusal = kKept;

// **Which texel near `pastUv` holds this surface's history?** Three
// questions, and any one of them saying no is enough --
//
// The id is the exact one and the other two are its safety net: an id
// matches across a whole object, so a wall occluding itself -- a corner
// turning out of view -- passes the id and fails the plane. Neither test
// alone is the answer, which is why all three are here.
//
// A pixel with no surface under it now, or none there last frame, is not a
// disocclusion to refuse: it is the sky, and the sky reprojects perfectly
// well. Left to the box, exactly as it was before this test existed.
bool Matches(vec4 now, vec4 was, bool centre)
{
	// **RT-6.7: both, or neither.** This was `now || was`, which accepted the
	// transition in *both* directions -- geometry appearing where sky was
	// inherits stale sky, and sky appearing where geometry was inherits a
	// stale object. Those are silhouette trails and halos against the sky, and
	// catching them is what a history test is for. Sky where there was sky
	// still reprojects perfectly well and is still accepted outright.
	//
	// Refusing here is not refusing the pixel: this runs once per candidate
	// inside the nine-tap search, so geometry whose centre texel was sky takes
	// the neighbour that was the same geometry. Only when none of the nine is
	// does the pixel take the current frame whole, which is the right answer
	// for something genuinely uncovered.
	const bool nowSky = now.x >= 1.0;
	const bool wasSky = was.x >= 1.0;
	if (nowSky && wasSky)
		return true;
	if (nowSky != wasSky)
	{
		if (centre) g_Refusal = kSkyCrossing;
		return false;
	}

	// **The object, first.** Exactly equal or it is not the same object --
	// the lane holds a whole number the G-buffer wrote, negated for a static
	// surface, so an epsilon here would only let neighbouring ids through.
	if (abs(now.w - was.w) > 0.5)
	{
		if (centre) g_Refusal = kObjectId;
		return false;
	}

	// **Then the depth**, which catches an object occluding itself.
	if (abs(now.x - was.x) > kDepthTolerance * max(now.x, 1.0e-4))
	{
		if (centre) g_Refusal = kDepth;
		return false;
	}

	// **Then the normal**, which catches the two faces of a corner: same
	// object, same distance, and a different surface all the same.
	if (dot(DecodeOct(now.yz), DecodeOct(was.yz)) < kNormalTolerance)
	{
		if (centre) g_Refusal = kNormal;
		return false;
	}
	return true;
}

// **The reprojected texel, or the nearest neighbour that is this surface,
// or nothing.** Returns the texel to read the history from and whether one
// was found; `bilinear` says whether the centre itself matched, because
// only then are the texels between it and its neighbours this surface too.
//
// The search is SVGF's and `reflection_accumulate` already runs it for the
// same reason: at a silhouette the reprojection is right to within the
// resampling and it is the *rounding* that lands on the far side of an
// edge. Refusing there trades a ghost for aliasing; taking the neighbour
// that kept this surface's history keeps the picture, one texel over.
ivec2 MatchingTexel(vec2 uv, vec2 pastUv, out bool found, out bool bilinear)
{
	const ivec2 size = textureSize(u_GuideCurrent, 0);
	const ivec2 nowTexel = clamp(ivec2(uv * vec2(size)), ivec2(0), size - 1);
	const ivec2 centre = clamp(ivec2(pastUv * vec2(size)), ivec2(0), size - 1);
	const vec4 now = texelFetch(u_GuideCurrent, nowTexel, 0);

	const ivec2 offsets[9] = ivec2[9](ivec2(0, 0), ivec2(1, 0), ivec2(-1, 0),
									  ivec2(0, 1), ivec2(0, -1), ivec2(1, 1),
									  ivec2(-1, -1), ivec2(1, -1), ivec2(-1, 1));
	for (int k = 0; k < 9; ++k)
	{
		const ivec2 at = clamp(centre + offsets[k], ivec2(0), size - 1);
		if (Matches(now, texelFetch(u_GuidePrevious, at, 0), k == 0))
		{
			found = true;
			bilinear = (k == 0);
			return at;
		}
	}
	found = false;
	bilinear = false;
	return centre;
}

// **The current sample is filtered around the unjittered pixel centre
// before it is blended** (Unreal's filtered current). The raw sample at a
// bright edge is one side or the other depending on where the jitter put
// it, and at a feedback of 0.9 every frame moved the pixel a tenth of the
// way there: parked, bright edges changed 3.3 levels a frame with no
// reflections in the picture and 1.0 with no anti-aliasing at all
// (2026-09-06). A Gaussian over the 3x3, centred where the pixel's own
// centre actually is this frame, gives the coverage instead of the coin.
// The box and the moments keep the raw taps: they describe what the pixel
// can be, and the filter must not narrow that.
// **RT-6.4: 0.5 -> 0.15** (owner-asked). This is the blur, and RT-6.2
// found it by elimination: the material-aware clamp measured flat because
// on a detailed surface the neighbourhood box is already wide, so the
// clamp only bites where there is no detail to lose. This filter bites
// everywhere, every frame. Narrowed, the garage reads wall 22.86 -> 23.28,
// floor 9.02 -> 9.53, poles 13.74 -> 14.32, at about four per cent more
// frame-to-frame change. **Settled at 0.25 on the owner's eye** -- 0.15
// read a shade too sharp to them, and 0.25 keeps most of the detail for
// half the extra change.
// frame-to-frame change -- and the jitter's edge wobble that the filter
// exists for is now also held by the geometric test and the neighbour
// search (RT-6), which did not exist when 0.5 was chosen.
const float kFilterSigma = 0.25;
const float kJitterSign = 1.0;


// **How many frames a pixel may remember**, for the warm-up below. Once 1/n
// falls under the configured feedback the feedback governs, so the count
// stops here rather than climbing forever in a half float. **It has to reach
// past the still feedback's 1/(1 - f)**: at 16 the floor was 1/16 = 0.0625
// and a still feedback of 0.97 (0.03) was never reached -- measured as 0.94
// in effect, three arms identical to the pixel. 64 is exact in a half float
// and covers 0.98.
const float kMaxFrames = 64.0;

// **The one dial of the temporal floor.** How many of the pixel's own
// standard deviations the history may sit from the box's centre before it is
// pulled in. Two covers ~95% of a normal fluctuation. Higher trusts a
// flickering pixel's past further and ghosts more where it then genuinely
// changes; lower rejects more and lets the flicker through.
const float kTemporalSigma = 2.0;

// **A pixel that did not move keeps more of its past.** The configured
// feedback is the ghosting-versus-flicker dial, and it is set for the case
// that ghosts: motion. A pixel whose reprojection lands where it already was
// cannot ghost -- the history *is* this surface -- and for it the only cost
// of a high feedback is a slower response to a real change in lighting. The
// blend's share of the current frame is what remains of the flicker once the
// clamp keeps the history: a suspender rope rasterised one frame in four at
// forty times the pixel's mean still moves the pixel by a tenth of that
// difference at 0.9, and by a fiftieth at 0.98. Measured on the bridge
// (tower region, parked, pinned, with the moments floor): 0.9 → 28% of
// pixels blinking, 0.97 → 8.6%, 0.98 → 6.0%; the cables 1.9% → 0.7%. 0.98
// is where TemporalResolve caps the configured feedback too. Scaled by how
// far the pixel moved, in its own texels, so anything in motion keeps
// exactly the configured number.
//
// **"Still" means it did not move at all, not that it moved less than a
// pixel.** The first landing counted anything under a texel of motion as
// still, and the water paid for it: its crests move a tenth of a texel a
// frame from the headland, so every pixel of it took the 0.98 and fifty
// frames of moving glitter averaged into a smear with horizontal bands where
// the crests had been. A second landing at a thirtieth of a texel still
// caught it: the swell a kilometre out moves a few thousandths of a texel a
// frame. Geometry that is genuinely still reprojects to within about a
// hundred-thousandth (the jitter is subtracted exactly, and what remains is
// float error at clip range), so the threshold sits between the two with an
// order of magnitude to spare on each side. The temporal floor is gated the
// same way: a moving surface's fluctuation is what it looks like, not noise
// to be averaged out.
// **Off (2026-09-02).** Left in place with the reason it cannot be on: no
// signal the resolve can read separates still steel from far water. The
// water's crests move a few thousandths of a texel a frame near the
// horizon and its sparkle changes every frame regardless, so any threshold
// that admits geometry admits the far water too, and the owner saw the
// glitter smear into horizontal bands twice. The sub-pixel members that
// this was reached for -- ropes, pickets, posts, webs -- are handled where
// they arise instead, by the thin-member distance fade in the material.
// Set at or below the configured feedback, the max() below picks the
// configured number and nothing here changes the picture.
// **A render setting since 2026-09-06** (`u_Params.StillFeedback`,
// RenderSettings::TemporalStillFeedback): the garage has no water and its
// edges flickered at 0.9; the bridge keeps it off.
const float kStillWithinTexels = 0.003;

// **How many frames the moments remember**, and it is shorter than the
// colour's memory on purpose. The floor exists for flicker on the jitter's
// own period, eight frames; it must not hold a bright past open for a light
// that has genuinely gone out. A beacon flashes 360 ms in every two seconds,
// and moments with the colour's fifty-frame memory kept its glow decaying
// for most of a second after each flash. Sixteen frames covers two jitter
// cycles and forgets a flash in a quarter of a second.
const float kMomentFrames = 16.0;

// **RT-6.11: a sharper history fetch than bilinear.** Nine taps arranged as
// the standard five bilinear fetches would be, written out because this
// pass reads one texture and clarity is worth more here than four fetches.
//
// Bilinear resampling of a history that moves between texels every frame
// compounds into softness; a Catmull-Rom kernel does not. It has negative
// lobes, which ring at an edge -- so the caller uses it only where the
// reprojected texel itself matched, and the result is floored at zero,
// because a negative lobe across a bright edge makes a negative radiance
// that the tone curve renders as a black rim.
vec4 SampleCatmullRom(sampler2D tex, vec2 uv, vec2 texelSize)
{
	const vec2 samplePos = uv / texelSize;
	const vec2 centre = floor(samplePos - 0.5) + 0.5;
	const vec2 f = samplePos - centre;

	const vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
	const vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
	const vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
	const vec2 w3 = f * f * (-0.5 + 0.5 * f);
	// The middle two taps folded into one bilinear fetch, which is what makes
	// this nine samples of the kernel out of five reads of the texture.
	const vec2 w12 = w1 + w2;
	const vec2 offset12 = w2 / max(w12, vec2(1.0e-5));

	const vec2 p0 = (centre - 1.0) * texelSize;
	const vec2 p3 = (centre + 2.0) * texelSize;
	const vec2 p12 = (centre + offset12) * texelSize;

	vec4 sum = vec4(0.0);
	sum += texture(tex, vec2(p0.x,  p0.y))  * (w0.x  * w0.y);
	sum += texture(tex, vec2(p12.x, p0.y))  * (w12.x * w0.y);
	sum += texture(tex, vec2(p3.x,  p0.y))  * (w3.x  * w0.y);
	sum += texture(tex, vec2(p0.x,  p12.y)) * (w0.x  * w12.y);
	sum += texture(tex, vec2(p12.x, p12.y)) * (w12.x * w12.y);
	sum += texture(tex, vec2(p3.x,  p12.y)) * (w3.x  * w12.y);
	sum += texture(tex, vec2(p0.x,  p3.y))  * (w0.x  * w3.y);
	sum += texture(tex, vec2(p12.x, p3.y))  * (w12.x * w3.y);
	sum += texture(tex, vec2(p3.x,  p3.y))  * (w3.x  * w3.y);
	return max(sum, vec4(0.0));
}

// Y, Co, Cg. The transform is exact and cheap -- adds and shifts in fixed
// point, which is why every temporal filter uses it for this.
vec3 ToYCoCg(vec3 c)
{
	return vec3(dot(c, vec3(0.25, 0.5, 0.25)),
				dot(c, vec3(0.5, 0.0, -0.5)),
				dot(c, vec3(-0.25, 0.5, -0.25)));
}

vec3 ToRGB(vec3 c)
{
	return vec3(c.x + c.y - c.z,
				c.x + c.z,
				c.x - c.y - c.z);
}

// Pull `history` towards `centre` until it is inside the box, rather than
// clamping each channel independently.
//
// Clamping per channel moves the colour to the nearest corner of the box,
// which is a colour that may be nowhere near the line the neighbourhood
// actually occupies. Clipping walks along the segment from the centre and
// stops at the face it leaves through, which keeps the hue and gives up only
// the amount it has to.
vec3 ClipToBox(vec3 history, vec3 centre, vec3 extent)
{
	vec3 offset = history - centre;
	// Guarded: a perfectly flat neighbourhood has zero extent on some axis,
	// and the ratio there is 0/0 rather than "infinitely far outside".
	vec3 units = abs(offset / max(extent, vec3(1e-5)));
	float furthest = max(units.x, max(units.y, units.z));

	return furthest > 1.0 ? centre + offset / furthest : history;
}

// Karis's weighting, and **it is a pair of functions, not a weight.**
//
// The point is to mix somewhere a very bright sample cannot dominate, then
// come back. Compress by 1/(1+luma), mix there, expand again. `.x` is the Y
// of a YCoCg colour, so the luminance is already to hand.
//
// An earlier version of this used the same 1/(1+luma) as a *weight* in a
// weighted mean and claimed the division by the sum of the weights was the
// unweighting. That is wrong, and measurably: a weighted mean biased by
// brightness pulls every mixed pixel towards the darker sample and never
// pulls it back. On the demo scene's gold sphere it halved the number of
// near-saturated pixels and took the 99th percentile from 250 to 237, while
// every other mode left the highlight alone. A specular highlight is not a
// firefly, and dimming it is not what this is for.
//
// Compress and expand are exact inverses, so two equal samples come back
// unchanged -- which is the property the biased version also had, and is why
// a still image hid the problem.
vec3 Compress(vec3 c)   { return c / (1.0 + max(c.x, 0.0)); }
vec3 Expand(vec3 c)     { return c / max(1.0 - c.x, 1e-4); }

void main()
{
	// See PostProcess::Dispatch: the two backends do not store a rendered
	// image the same way up, so one of them samples flipped.
	const bool flip = u_Params.FlipY > 0.5;
	vec2 uv = vec2(v_UV.x, flip ? 1.0 - v_UV.y : v_UV.y);

	vec4 current = texture(u_Current, uv);

	// The moments track the luminance of what *arrives* each frame -- the
	// current sample, not the blended output -- because the question the
	// clamp needs answered is how much this pixel's input swings.
	const float currentLuma = ToYCoCg(current.rgb).x;

	// Nothing to accumulate into. Not a special case to be tidied away later
	// -- it is the correct answer on the first frame and after every resize,
	// and taking it whole is what stops one frame of uninitialised memory
	// fading out over the next thirty.
	if (u_Params.HasHistory < 0.5)
	{
		o_Color = current;
		// One frame seen, and its luminance is the whole of what is known.
		// RT-12: the reason lane, where zero still means "reused" so the
		// validity WR-16 S0 put here survives as `w == 0`.
		o_Moments = vec4(1.0, currentLuma, currentLuma * currentLuma,
						  float(kNoHistory));
		CountTemporal(false);
		return;
	}

	// Where this surface was last frame. The velocity attachment is in the
	// same UV units as this sample, and jitter-free -- the scene's fragment
	// shader subtracts the offset back out, because half a pixel of camera
	// dither is not the surface moving.
	//
	// The vertical direction is the one that has to be stated: velocity was
	// written as a difference of *clip* coordinates, whose y axis runs the
	// same way on both backends, while this shader's v runs downward on one
	// and upward on the other. Same reasoning as the flip above, applied to a
	// direction rather than to a position.
	//
	// **Measured, not argued.** This was reasoning until a scene existed that
	// could tell the difference, and reasoning is how a sign gets shipped
	// backwards. On a textured patch falling 16 px a frame, judged against a
	// 4x supersampled render of the same frame: this convention scores 19.8
	// RMS and the opposite one 29.9, on both backends. A still scene says
	// nothing about it at all -- velocity is zero everywhere there, and either
	// sign times zero is zero. ENGINE-NOTES 7r.
	vec2 velocity = texture(u_Velocity, uv).xy;
	velocity.y = flip ? -velocity.y : velocity.y;

	vec2 historyUV = uv - velocity;

	// Off the edge of the image there is no history, and clamping would smear
	// the border pixel inward along whatever direction the camera turned.
	// **RT-6: off the edge, or a different surface.** The second is the one
	// the colour box could never be trusted with. The two are one branch
	// because the consequence is identical -- there is no history for this
	// pixel, so this frame stands alone and the count restarts.
	const bool offScreen = any(lessThan(historyUV, vec2(0.0)))
						|| any(greaterThan(historyUV, vec2(1.0)));
	bool geometryFound = true;
	bool geometryBilinear = true;
	ivec2 historyTexel = ivec2(0);
	if (!offScreen && u_Params.Geometry > 0.5)
		historyTexel = MatchingTexel(uv, historyUV, geometryFound, geometryBilinear);
	const bool disoccluded = !offScreen && u_Params.Geometry > 0.5 && !geometryFound;
	if (offScreen || disoccluded)
	{
		o_Color = current;
		// Disoccluded: the count starts again here. Carrying the old one would
		// tell the next frame to trust the fluctuation of a surface that is
		// not the one now under this pixel.
		// RT-12: off screen has no clause to blame; a disocclusion carries the
		// clause that refused the centre, plus the half that says the search
		// found nothing either.
		o_Moments = vec4(1.0, currentLuma, currentLuma * currentLuma,
						  offScreen ? float(kOffScreen)
									: float(g_Refusal) + 0.5);
		CountTemporal(false);
		return;
	}

	// **RT-6.6: where the history is read from, decided once.** The colour,
	// the count and the moments have to come from the same texel or the
	// blend is weighted by a surface it is not blending: `prevMoments.x` is
	// the frame count that sets how much of this frame enters at all, and
	// `.y`/`.z` set the floor the box may not narrow below.
	//
	// RT-6 added the neighbour search and moved only the colour. `u_Moments`
	// is point sampled, so this was never a filtering question -- the colour
	// came from the neighbour and the moments from the centre, which is the
	// texel the search had just rejected as a different surface.
	//
	// **One bool rather than the condition written at each read**, because
	// the defect was exactly the second copy of that condition going missing.
	const bool neighbourServed = u_Params.Geometry > 0.5 && !geometryBilinear;

	// The 3x3 neighbourhood, in YCoCg, as a box -- and the alpha's range
	// beside it. The alpha is the traced reflection's weight, which the
	// composite after this pass multiplies into a picture that never came
	// through here (reflection_composite.rvshader); filtered like the
	// colour, its edge at a chrome pole's silhouette is as smooth as the
	// pole's.
	vec3 centreYCoCg = ToYCoCg(current.rgb);
	vec3 lowest = centreYCoCg;
	vec3 highest = centreYCoCg;
	float alphaLow = current.a;
	float alphaHigh = current.a;

	// **RT-6.8: the same box, from this surface's taps only.** Gathered
	// beside the full one rather than instead of it, because whether it is
	// usable is not known until the taps have been counted.
	const bool boxGeometry = u_Params.Geometry > 0.5 && u_Params.BoxGeometry > 0.5;
	const ivec2 guideSize = textureSize(u_GuideCurrent, 0);
	const ivec2 centreTexel = clamp(ivec2(uv * vec2(guideSize)),
									ivec2(0), guideSize - 1);
	const vec4 centreGuide = boxGeometry ? texelFetch(u_GuideCurrent, centreTexel, 0)
										 : vec4(0.0);
	vec3 lowestSame = centreYCoCg;
	vec3 highestSame = centreYCoCg;
	float alphaLowSame = current.a;
	float alphaHighSame = current.a;
	int sameSurface = 0;
	// The jitter in texels; a rendered sample at texel offset o sits at
	// o - jitter on the unjittered grid.
	vec2 jitterTexels = u_Params.Jitter * 0.5 / u_Params.TexelSize;
	jitterTexels.y = u_Params.FlipY > 0.5 ? -jitterTexels.y : jitterTexels.y;
	jitterTexels *= kJitterSign;
	const float twoSigmaSq = 2.0 * kFilterSigma * kFilterSigma;
	float filterWeight = exp(-dot(jitterTexels, jitterTexels) / twoSigmaSq);
	vec3 filtered = current.rgb * filterWeight;

	for (int y = -1; y <= 1; y++)
	{
		for (int x = -1; x <= 1; x++)
		{
			if (x == 0 && y == 0)
				continue;

			const vec4 tap = texture(u_Current, uv + u_Params.TexelSize * vec2(x, y));
			vec3 neighbour = ToYCoCg(tap.rgb);
			lowest = min(lowest, neighbour);
			highest = max(highest, neighbour);
			alphaLow = min(alphaLow, tap.a);
			alphaHigh = max(alphaHigh, tap.a);
			// RT-6.8: and again, for the taps that are this surface. The same
			// test the history uses, both sides taken from *this* frame's lane:
			// the question here is not "was this the same surface" but "is this
			// neighbour the same surface". `false` because the refusal reason
			// belongs to the centre's history test, not to a box tap.
			if (boxGeometry)
			{
				const ivec2 at = clamp(centreTexel + ivec2(x, y),
									   ivec2(0), guideSize - 1);
				if (Matches(centreGuide, texelFetch(u_GuideCurrent, at, 0), false))
				{
					lowestSame = min(lowestSame, neighbour);
					highestSame = max(highestSame, neighbour);
					alphaLowSame = min(alphaLowSame, tap.a);
					alphaHighSame = max(alphaHighSame, tap.a);
					++sameSurface;
				}
			}
			const vec2 offset = vec2(x, y) - jitterTexels;
			const float w = exp(-dot(offset, offset) / twoSigmaSq);
			filtered += tap.rgb * w;
			filterWeight += w;
		}
	}
	centreYCoCg = ToYCoCg(filtered / max(filterWeight, 1.0e-6));

	// **RT-6.8: take the narrower box only where it was built from enough
	// of this surface to mean anything.** Below the bar the full
	// neighbourhood stands and the pixel behaves exactly as it did.
	//
	// The filter above is deliberately *not* gated: it is RT-6.4's, its
	// width was set on the owner's eye, and narrowing it at silhouettes is
	// a separate change with its own picture to judge.
	if (boxGeometry && sameSurface >= kLeastSameNeighbours)
	{
		lowest = lowestSame;
		highest = highestSame;
		alphaLow = alphaLowSame;
		alphaHigh = alphaHighSame;
	}

	// Bilinear, deliberately, and this was tested rather than assumed.
	//
	// Anything moving reprojects to a position between texels, so the history
	// is resampled every frame, and bilinear resampling compounds into
	// softness -- which is the textbook argument for a Catmull-Rom fetch
	// instead. That was implemented, nine taps for one, and **measured no
	// difference at all**: 19.830 against 19.774 on the moving patch, 3.817
	// against 3.816 standing still. At this scene's speed the neighbourhood
	// clip is discarding the history the sharper kernel would have preserved,
	// so the kernel has nothing to do.
	//
	// Reverted rather than kept on the strength of the theory, because a nine
	// times more expensive fetch has to buy something. It would be worth
	// revisiting on *slow* motion -- a pixel a frame or less, where the clip
	// keeps most of the history and the resampling is what degrades it -- and
	// that scene does not exist here yet.
	// **The pixel's own history of itself, which the neighbours cannot
	// supply.** The box above says how much this *area* disagrees; the
	// moments say how much this *pixel's input* has been swinging. They
	// answer different questions, and the second one was missing.
	//
	// What it fixes, measured on the bridge with the camera parked and the
	// clock pinned: a suspender rope, a railing picket or a tower rib
	// thinner than a pixel is rasterised in the frames the jitter lands a
	// sample on it and absent in the frames it does not. In the absent
	// frames the 3x3 box is all background, the clip pulls the history to
	// the background, and the 10% of the rope that entered the blend the
	// frame before is thrown away -- so the pixel never accumulates it and
	// shows the raw sample every time (19, 19, 19, 47, 19, 19, 19, 45 ...
	// on the eight-frame Halton cycle). 34% of the tower's pixels and 33% of
	// the deck's swung six levels or more with reversals; with the jitter
	// off, none. A box that cannot narrow below the pixel's own known
	// fluctuation keeps that history, and the pixel converges on the
	// coverage-weighted average the jitter was sampling for.
	//
	// Last frame's count and moments for this surface, fetched with the same
	// reprojection the colour uses. The warm-up is the GI denoiser's: with
	// few frames behind it the estimate moves freely, and once 1/n falls
	// below the configured feedback the feedback governs.
	const vec4 prevMoments = u_Params.HasMoments > 0.5
						   ? (neighbourServed
							  ? texelFetch(u_Moments, historyTexel, 0)
							  : texture(u_Moments, historyUV))
						   : vec4(0.0);
	const float frames = min(prevMoments.x + 1.0, kMaxFrames);
	const float motionTexels = length(velocity / u_Params.TexelSize);
	// **Still, and known to be the same surface** (RT-6). The velocity test
	// alone says a pixel did not move; it cannot say the thing that did not
	// move is the thing that was there before. Reaching this line already
	// means the geometric test passed, so the two together are what the long
	// still feedback is safe to stand on -- and where the identity lanes are
	// not bound this is exactly the old test, unchanged.
	const float stillness = motionTexels < kStillWithinTexels ? 1.0 : 0.0;
	const float feedback = mix(u_Params.Feedback,
							   max(u_Params.Feedback, u_Params.StillFeedback), stillness);
	const float alpha = max(1.0 / frames, 1.0 - feedback);
	const float momentAlpha = max(alpha, 1.0 / kMomentFrames);
	const float momMean = mix(prevMoments.y, currentLuma, momentAlpha);
	const float momMeanSq = mix(prevMoments.z, currentLuma * currentLuma, momentAlpha);
	// Only for a pixel that did not move: on water and anything else whose
	// shading legitimately changes in place, the fluctuation is the picture.
	const float temporalSigma = sqrt(max(momMeanSq - momMean * momMean, 0.0)) * stillness;
	// RT-12: reached here the history was reused, so the reason is whatever
	// refused the *centre* texel -- zero when it matched outright, and the
	// clause that sent the search to a neighbour otherwise. That difference
	// is the one the view exists to show: a recovered pixel and a
	// disoccluded one are a half apart on the ramp, not a whole category.
	o_Moments = vec4(frames, momMean, momMeanSq, float(g_Refusal));
	CountTemporal(true);

	// **Never clamp tighter than this pixel is known to fluctuate.** Widened
	// as a whole -- the same factor on all three axes -- so the box keeps its
	// shape and a rope's colour survives with its brightness rather than
	// being clipped to the background's hue. The neighbourhood still sets
	// the floor: where the pixel has been steady this is exactly the box it
	// was, and a genuinely still image changes by nothing.
	const vec3 boxCentre = 0.5 * (lowest + highest);
	vec3 boxExtent = max(0.5 * (highest - lowest), vec3(1e-5));

	// **RT-6.2: widened by how view-stable the surface is.** Rough carries it
	// and metal takes it away -- a rough *metal* is still a metal, its lobe is
	// wide but it is entirely a function of the view. The window starts where
	// a surface stops behaving like a mirror (0.15, the gloss threshold the
	// reflection accumulator uses for the same distinction) and is fully open
	// by half rough, which is ordinary concrete, brick and paint.
	if (u_Params.Material > 0.5)
	{
		const vec4 material = texelFetch(u_Material, ivec2(gl_FragCoord.xy), 0);
		const float stability = (1.0 - clamp(material.a, 0.0, 1.0))
							  * smoothstep(0.15, 0.5, clamp(material.b, 0.0, 1.0));
		boxExtent *= mix(1.0, kStableWiden, stability);
	}
	const float widen = max(1.0, kTemporalSigma * temporalSigma / boxExtent.x);
	boxExtent *= widen;

	// **Bilinear where the reprojected texel itself matched; that texel's own
	// value where a neighbour served.** The texels between the two belong to
	// the other side of the edge, and a filtered read across them is exactly
	// the blend the surface test just refused.
	// **RT-6.11: Catmull-Rom where the reprojected texel itself matched.**
	// Point where a neighbour served, for RT-6's reason -- the texels between
	// belong to the other side of an edge, and a nine-tap kernel across them
	// is exactly the blend the surface test just refused, four times wider.
	const vec4 historySample = neighbourServed
							 ? texelFetch(u_History, historyTexel, 0)
							 : SampleCatmullRom(u_History, historyUV, u_Params.TexelSize);
	vec3 history = ToYCoCg(historySample.rgb);
	history = ClipToBox(history, boxCentre, boxExtent);
	const float historyAlpha = clamp(historySample.a, alphaLow, alphaHigh);

	// Compressed, mixed, expanded. The mix is the feedback fraction once the
	// pixel is warm and less than it while it is not -- the brightness
	// handling is entirely in the space it happens in, which is what keeps
	// it unbiased.
	vec3 blended = Expand(mix(Compress(centreYCoCg), Compress(history),
							  1.0 - alpha));

	o_Color = vec4(ToRGB(blended), mix(current.a, historyAlpha, 1.0 - alpha));
}
