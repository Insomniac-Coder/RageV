// Voxel GI, the clear (8.1, ENGINE-NOTES 7bc): albedo's alpha is the
// occupancy and the one thing the grid needs emptied each frame -- an
// unoccupied voxel's normal and emissive are never read, and an occupied
// one's were written this frame. One dispatch over the whole atlas.
#type compute
#version 450 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image3D u_Albedo;

void main()
{
	const ivec3 texel = ivec3(gl_GlobalInvocationID);
	if (any(greaterThanEqual(texel, imageSize(u_Albedo))))
		return;
	imageStore(u_Albedo, texel, vec4(0.0));
}
