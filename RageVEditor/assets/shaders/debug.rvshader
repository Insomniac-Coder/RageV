// Unlit coloured lines, for debug geometry.
//
// Deliberately the simplest shader in the project. Debug draw exists to answer
// "where is that collider", and anything that shades it -- lighting, fog, tone
// mapping -- makes the answer depend on the scene rather than on the geometry.

#type vertex
#version 450 core

layout(location = 0) in vec3 a_Position;
layout(location = 1) in vec4 a_Color;

layout(set = 0, binding = 0) uniform SceneData
{
	mat4 ViewProjection;
} u_Scene;

layout(location = 0) out vec4 v_Color;

void main()
{
	// Vertices arrive in world space: shapes are transformed on the CPU, which
	// is what lets one batch hold every collider in the scene regardless of
	// where each one is.
	v_Color = a_Color;
	gl_Position = u_Scene.ViewProjection * vec4(a_Position, 1.0);
}

#type fragment
#version 450 core

layout(location = 0) in vec4 v_Color;
layout(location = 0) out vec4 o_Color;
// Nothing here reports motion. The attachment is bound for the whole pass, so
// every pipeline in it declares the output; writing zero is the truthful
// answer for a background, a gizmo or a particle, and leaving it unwritten
// would be whatever the clear happened to be. ENGINE-NOTES 7r.
layout(location = 1) out vec2 o_Velocity;


void main()
{
	o_Velocity = vec2(0.0);

	o_Color = v_Color;
}
