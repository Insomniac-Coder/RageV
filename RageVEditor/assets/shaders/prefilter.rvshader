// One roughness level of a prefiltered environment map.
//
// The mip chain a cube gets from GenerateMips is box filtered: each level is
// blurrier than the last, which is monotonic in roughness and is not the GGX
// lobe. The difference shows on a rough metal, where a box blur keeps a
// highlight rounder and dimmer than the long tail a real lobe has.
//
// Run once per face per roughness level, into a target of that level's size,
// and copied into the destination cube's mip. Thirty-six small renders per
// environment map, once.

#type vertex
#version 450 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 450 core

const float PI = 3.14159265359;

layout(location = 0) in vec2 v_UV;
layout(location = 0) out vec4 o_Color;

layout(set = 0, binding = 0) uniform samplerCube u_Source;

layout(push_constant) uniform Params
{
	// The face being filled, as the three vectors its direction table is built
	// from: direction = normalize(Axis + Right * s + Up * t). Passed in rather
	// than switched on a face index, so the table lives in exactly one place --
	// Cubemap.cpp -- and this shader cannot drift from it.
	vec4 Axis;
	vec4 Right;
	vec4 Up;
	// x = roughness, y = the source's face size, z = sample count
	vec4 Settings;
} u_Params;

float RadicalInverse(uint bits)
{
	bits = (bits << 16u) | (bits >> 16u);
	bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
	bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
	bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
	bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
	return float(bits) * 2.3283064365386963e-10;
}

vec3 ImportanceSampleGGX(vec2 random, vec3 N, float roughness)
{
	float a = roughness * roughness;

	float phi = 2.0 * PI * random.x;
	float cosTheta = sqrt((1.0 - random.y) / (1.0 + (a * a - 1.0) * random.y));
	float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));

	// Not called 'half': that is a reserved word in GLSL and the error names
	// the line rather than the word.
	vec3 microfacet = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);

	// Into world space around N.
	vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
	vec3 tangent = normalize(cross(up, N));
	vec3 bitangent = cross(N, tangent);

	return normalize(tangent * microfacet.x + bitangent * microfacet.y + N * microfacet.z);
}

float DistributionGGX(float NdotH, float roughness)
{
	float a = roughness * roughness;
	float a2 = a * a;
	float denom = NdotH * NdotH * (a2 - 1.0) + 1.0;
	return a2 / max(PI * denom * denom, 1e-6);
}

void main()
{
	// Face-local coordinates. v runs with the *rendered image*, whose bottom
	// row is the face's first texel row -- see CopyToTextureLayer, which is
	// what makes that true on both backends.
	float s = 2.0 * v_UV.x - 1.0;
	float t = 2.0 * v_UV.y - 1.0;

	vec3 N = normalize(u_Params.Axis.xyz + u_Params.Right.xyz * s + u_Params.Up.xyz * t);

	// The approximation that makes this affordable: the surface is assumed to
	// be looked at head on, so the view and the reflection are both the normal.
	// It costs the stretched highlight a surface has at a grazing angle, and
	// saves a lookup per view direction per texel, which is to say it saves
	// the entire idea of a prefiltered map.
	vec3 V = N;

	float roughness = clamp(u_Params.Settings.x, 0.0, 1.0);
	float faceSize = max(u_Params.Settings.y, 1.0);
	int samples = int(max(u_Params.Settings.z, 1.0));

	vec3 sum = vec3(0.0);
	float weight = 0.0;

	for (int i = 0; i < samples; ++i)
	{
		vec2 random = vec2(float(i) / float(samples), RadicalInverse(uint(i)));
		vec3 H = ImportanceSampleGGX(random, N, roughness);
		vec3 L = normalize(2.0 * dot(V, H) * H - V);

		float NdotL = max(dot(N, L), 0.0);
		if (NdotL <= 0.0)
			continue;

		// Sample a mip chosen from how much of the sphere this one sample is
		// standing in for. Without it, a bright detail smaller than the sample
		// spacing survives as a speckle -- the same firefly the bloom prefilter
		// deals with, arriving by a different route.
		float NdotH = max(dot(N, H), 0.0);
		float HdotV = max(dot(H, V), 0.0);
		float pdf = DistributionGGX(NdotH, roughness) * NdotH / (4.0 * HdotV) + 1e-4;

		float texelSolidAngle = 4.0 * PI / (6.0 * faceSize * faceSize);
		float sampleSolidAngle = 1.0 / (float(samples) * pdf);

		float mip = roughness == 0.0 ? 0.0
									 : 0.5 * log2(sampleSolidAngle / texelSolidAngle);

		sum += textureLod(u_Source, L, max(mip, 0.0)).rgb * NdotL;
		weight += NdotL;
	}

	o_Color = vec4(weight > 0.0 ? sum / weight : textureLod(u_Source, N, 0.0).rgb, 1.0);
}
