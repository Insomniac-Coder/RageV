// Composites weighted-blended transparency back over the scene.
//
// One fullscreen triangle, run after everything that accumulated. The two
// inputs are order-independent by construction -- a sum and a product -- so
// this is where the accumulated mess becomes a picture.

#type vertex
#version 450 core

layout(location = 0) out vec2 v_UV;

void main()
{
	// A triangle that covers the screen, from the vertex index alone. Cheaper
	// than a quad and free of the seam a quad's diagonal puts down the middle.
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 450 core

layout(location = 0) in vec2 v_UV;

layout(set = 0, binding = 0) uniform sampler2D u_Accumulate;
layout(set = 0, binding = 1) uniform sampler2D u_Revealage;

layout(push_constant) uniform Params
{
	float FlipY;
} u_Params;

layout(location = 0) out vec4 o_Color;

void main()
{
	// This pass reads two render targets and writes a third, so it owes the
	// same V flip every other fullscreen pass pays -- see PostProcess::Dispatch
	// for why Vulkan flips and OpenGL does not. It is a single pass, and a
	// single pass is an odd number: nothing downstream cancels the mistake.
	//
	// It went unnoticed because the transparency was flipped and nothing else
	// was, against test scenes whose plumes sat near the middle of frame. What
	// found it was rendering the same particles as sorted alpha and comparing
	// the silhouettes.
	vec2 uv = vec2(v_UV.x, u_Params.FlipY > 0.5 ? 1.0 - v_UV.y : v_UV.y);

	float revealage = texture(u_Revealage, uv).r;

	// Nothing covered this pixel: leave the scene alone. Alpha of zero makes
	// the blend below a no-op, which is cheaper and more honest than
	// discarding.
	vec4 accumulation = texture(u_Accumulate, uv);

	// The weights divide out -- that is the trick. Whatever they were, the
	// ratio is the weighted average colour, and the weights themselves never
	// appear in the answer.
	//
	// The guard is not paranoia: an accumulation of exactly zero happens on
	// every pixel no particle touched, and infinity spreads.
	vec3 average = accumulation.rgb / max(accumulation.a, 1e-5);

	// Written as ordinary alpha, so the pipeline's AlphaBlend preset does the
	// composite: coverage is one minus what stayed revealed.
	o_Color = vec4(average, 1.0 - revealage);
}
