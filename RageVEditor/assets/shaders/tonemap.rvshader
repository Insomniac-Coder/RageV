// The last pass: exposure, bloom, tone mapping, and the transfer function.
//
// This is what moved out of the PBR shader. Doing it there meant every shader
// that wrote to the screen had to agree on it -- and only one of them did, so
// Renderer2D's quads and the PBR meshes were being displayed with two different
// transfer functions in the same image. It also made bloom impossible: bloom
// needs the linear values from before tone mapping, and by the time the PBR
// shader had finished there were none left.

#type vertex
#version 450 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 450 core

layout(location = 0) in vec2 v_UV;
layout(location = 0) out vec4 o_Color;

layout(set = 0, binding = 0) uniform sampler2D u_Scene;
layout(set = 0, binding = 1) uniform sampler2D u_Bloom;

// The colour-grading LUT: a volume, sampled with the graded colour as its
// coordinate. Declared whether or not one is assigned -- the binding is always
// filled, with a 2-cube identity when there is nothing to grade with, because
// a declared-but-unbound sampler is undefined behaviour on both backends.
layout(set = 0, binding = 2) uniform sampler3D u_ColorLut;

layout(push_constant) uniform Params
{
	float Exposure;
	float BloomIntensity;
	// Entries per axis, or 0 for "do not grade". A size rather than a flag
	// because the sampling scale below needs the number anyway.
	float LutSize;
	float LutStrength;
	float Unused2;
	float FlipY;

	// --- lens and film. ENGINE-NOTES 7w -------------------------------------
	// Each is zero when off, and each is branched past rather than computed
	// as a no-op: `mix(1.0, v, 0.0)` and `uv + vec2(0.0)` are mathematically
	// nothing and not guaranteed to be bit-exactly nothing on every compiler.
	float Aberration;
	float Vignette;
	float VignetteSmoothness;
	float Grain;
	float GrainSize;
	// The frame number, not a clock: grain has to animate *and* reproduce, so
	// that a screenshot of frame 30 is the same picture every time. Same rule
	// the TAA jitter follows, 7r.
	float Frame;
} u_Params;

// A hash, not a texture. One less binding to fill and no sampling state to
// get wrong, and the pattern only has to be *unstructured* rather than
// well-distributed -- grain that repeats visibly is the failure, and this
// does not at any size worth using.
float Hash(vec3 v)
{
	return fract(sin(dot(v, vec3(12.9898, 78.233, 37.719))) * 43758.5453);
}

// ACES filmic approximation (Narkowicz). Without tone mapping anything above
// 1.0 clips to white, and the specular highlights that make PBR read as PBR
// are the first thing lost.
vec3 TonemapACES(vec3 x)
{
	const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
	return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

void main()
{
	// The destination row this fragment writes and the source row v_UV
	// names are the same row on OpenGL and opposite rows on Vulkan. See
	// PostProcess::Dispatch.
	vec2 uv = vec2(v_UV.x, u_Params.FlipY > 0.5 ? 1.0 - v_UV.y : v_UV.y);

	// Chromatic aberration first, on the linear sample, because a lens
	// disperses before the sensor sees anything. Three taps radially offset
	// from the centre: dispersion grows towards the edge of the frame and is
	// zero in the middle, which is what a real lens does and what stops the
	// effect reading as a colour fringe on everything.
	vec3 color;
	if (u_Params.Aberration > 0.0)
	{
		vec2 toCentre = uv - vec2(0.5);
		vec2 offset = toCentre * u_Params.Aberration;

		color = vec3(texture(u_Scene, uv + offset).r,
					 texture(u_Scene, uv).g,
					 texture(u_Scene, uv - offset).b);
	}
	else
	{
		color = texture(u_Scene, uv).rgb;
	}

	// The bloom is added undispersed. It is blurred far wider than any sane
	// offset, so three taps of it would shift something nobody could see had
	// moved.
	color += texture(u_Bloom, uv).rgb * u_Params.BloomIntensity;

	// Exposure before the curve, which is what makes it an exposure control
	// rather than a brightness one: it slides the scene along the response
	// curve instead of scaling the result of it.
	color *= u_Params.Exposure;

	// And the vignette before the curve too, for the same reason exposure is:
	// it is *less light arriving*, so it should roll off through the response
	// curve like everything else. After the curve it multiplies display
	// values and reads as a shadow painted on the result. ENGINE-NOTES 7w.
	if (u_Params.Vignette > 0.0)
	{
		// Distance from the centre, in units where the corner is 1. Not
		// aspect-corrected on purpose: a vignette that is a circle on a
		// 21:9 frame leaves the middle of the top edge darker than the
		// middle of the sides, which is not what a lens does.
		float d = length(uv - vec2(0.5)) * 1.41421356;

		// smoothstep rather than a power: the falloff has a start and an end
		// that a person can reason about, and at smoothness 1 it begins at
		// the centre rather than never quite arriving.
		float falloff = smoothstep(1.0 - u_Params.VignetteSmoothness, 1.0, d);
		color *= mix(1.0, 1.0 - u_Params.Vignette, falloff);
	}

	color = TonemapACES(color);

	// The swapchain is UNORM rather than sRGB, so the transfer function is
	// applied here instead of by the hardware.
	color = pow(color, vec3(1.0 / 2.2));

	// Colour grading, **after** the transfer function.
	//
	// A `.cube` from a grading tool was authored against what a display shows
	// -- encoded, in 0..1 -- so this is the point where the value the LUT
	// expects actually exists. Applying it in linear light would need a shaper
	// the LUT's author also used, which is a different feature with a
	// different input. ENGINE-NOTES 7t.
	if (u_Params.LutSize > 1.5)
	{
		// Texel *centres*: a colour c lands at (c * (N-1) + 0.5) / N, not at
		// c. The difference is half a texel -- about 1.5% of the range at
		// N = 32 -- and getting it wrong produces a grade that is smooth,
		// plausible and not the one that was authored, everywhere, with no
		// artefact to notice. The identity check exists for exactly this line.
		float n = u_Params.LutSize;
		vec3 coord = (clamp(color, 0.0, 1.0) * (n - 1.0) + 0.5) / n;

		vec3 graded = texture(u_ColorLut, coord).rgb;
		color = mix(color, graded, clamp(u_Params.LutStrength, 0.0, 1.0));
	}

	// Grain last: after the curve *and* after the LUT.
	//
	// Grain is the texture of the recording medium, not a colour anybody
	// graded. Before the LUT, the grade re-maps the noise -- amplifying it
	// wherever the look stretches the range and crushing it wherever the look
	// compresses -- so the grain would change character with the grade instead
	// of sitting on top of it. ENGINE-NOTES 7w.
	if (u_Params.Grain > 0.0)
	{
		// Quantised to the grain size so a speck covers several pixels at
		// larger settings, and seeded with the frame number so it animates and
		// still reproduces.
		vec2 cell = floor(gl_FragCoord.xy / max(u_Params.GrainSize, 1.0));
		float noise = Hash(vec3(cell, u_Params.Frame)) - 0.5;

		// Scaled by luma so the darkest parts of the frame stay clean. Film
		// grain lives in the midtones; noise of equal amplitude in the blacks
		// reads as a broken sensor rather than as stock.
		float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
		color = clamp(color + noise * u_Params.Grain * 0.25 * (1.0 - luma * 0.5),
					  0.0, 1.0);
	}

	o_Color = vec4(color, 1.0);
}
