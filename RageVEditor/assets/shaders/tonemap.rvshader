// The last pass: exposure, bloom, tone mapping, and the transfer function.
//
// This is what moved out of the PBR shader. Doing it there meant every shader
// that wrote to the screen had to agree on it -- and only one of them did, so
// Renderer2D's quads and the PBR meshes were being displayed with two different
// transfer functions in the same image. It also made bloom impossible: bloom
// needs the linear values from before tone mapping, and by the time the PBR
// shader had finished there were none left.

#type vertex
#version 450 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 450 core

layout(location = 0) in vec2 v_UV;
layout(location = 0) out vec4 o_Color;

layout(set = 0, binding = 0) uniform sampler2D u_Scene;
layout(set = 0, binding = 1) uniform sampler2D u_Bloom;

// The colour-grading LUT: a volume, sampled with the graded colour as its
// coordinate. Declared whether or not one is assigned -- the binding is always
// filled, with a 2-cube identity when there is nothing to grade with, because
// a declared-but-unbound sampler is undefined behaviour on both backends.
layout(set = 0, binding = 2) uniform sampler3D u_ColorLut;

layout(push_constant) uniform Params
{
	float Exposure;
	float BloomIntensity;
	// Entries per axis, or 0 for "do not grade". A size rather than a flag
	// because the sampling scale below needs the number anyway.
	float LutSize;
	float LutStrength;
	float Unused2;
	float FlipY;

	// --- lens and film. ENGINE-NOTES 7w -------------------------------------
	// Each is zero when off, and each is branched past rather than computed
	// as a no-op: `mix(1.0, v, 0.0)` and `uv + vec2(0.0)` are mathematically
	// nothing and not guaranteed to be bit-exactly nothing on every compiler.
	float Aberration;
	float Vignette;
	float VignetteSmoothness;
	float Grain;
	float GrainSize;
	// The frame number, not a clock: grain has to animate *and* reproduce, so
	// that a screenshot of frame 30 is the same picture every time. Same rule
	// the TAA jitter follows, 7r.
	float Frame;

	// Whether to take the exposure from u_Exposure below. Zero uses Exposure
	// above unchanged, which is what makes auto exposure off *exact* rather
	// than arithmetically harmless. ENGINE-NOTES 7y.
	float AutoExposure;
} u_Params;

// What auto exposure worked out, on the GPU, earlier this frame.
//
// Always bound -- with a unit buffer when the feature is off -- because a
// declared binding with nothing bound is undefined behaviour rather than a
// zero. Same rule as the identity LUT above.
layout(std430, set = 0, binding = 3) readonly buffer ExposureState
{
	float AdaptedLog;
	float Exposure;
	float MeasuredLog;
	float Pad;
} u_Exposure;

// --- film grain -------------------------------------------------------------
//
// Value noise, not a hash per pixel -- and not gradient (Perlin) noise either.
// Three properties, and each is the reason for one of the lines below:
//
//   * **Clumps, not squares.** A hash of `floor(coord / size)` is a grid of
//     axis-aligned blocks. Grain is round specks in random positions, and
//     interpolating between lattice points is what removes every straight
//     edge from the field.
//   * **Clumps of more than one size**, because a film stock is a
//     distribution of crystal sizes rather than a single one. Two octaves, at
//     a frequency ratio that is deliberately not a whole number so the two
//     lattices never line up and hand the grid back.
//   * **Three layers, slightly independent**, because colour negative has
//     three emulsions and they do not grain together. Only the *finest*
//     octave is per channel: the clumping itself is shared, which is both
//     cheaper and closer to what the stock does.
//
// Gradient noise is the obvious alternative and is worse here for one
// specific reason: it is exactly zero at every lattice point, so a field of
// it carries a regular grid of grain-free dots -- the artefact this is
// replacing, rotated 45 degrees. ENGINE-NOTES 7x.

// An integer hash, not `fract(sin(x) * 43758.5453)`.
//
// The sine version is the common one and it is not *reproducible*: the
// precision of `sin` is implementation-defined, the arguments it is fed are
// large, and the answer lives entirely in the low bits that the two backends
// are least likely to agree on. Integer multiplies and shifts are exact and
// wrap identically everywhere, which is what makes a grain pattern something
// a Vulkan and an OpenGL screenshot can be compared on at all.
//
// lowbias32 (Wellons), chosen over the usual Wang hash because its avalanche
// is good enough that consecutive integers do not need a second round to stop
// looking consecutive -- and consecutive integers is exactly what a lattice
// feeds it.
uint HashU(uint x)
{
	x ^= x >> 16;
	x *= 0x7feb352du;
	x ^= x >> 15;
	x *= 0x846ca68bu;
	x ^= x >> 16;
	return x;
}

// One lattice point's value, in 0..1.
float Lattice(ivec2 cell, uint seed)
{
	uint h = HashU(uint(cell.x) ^ HashU(uint(cell.y) ^ HashU(seed)));

	// 24 bits, so the conversion to float is exact rather than rounded.
	// Exactness is the entire reason for hashing in integers; throwing it away
	// on the last line would be a waste of the previous six.
	return float(h >> 8) * (1.0 / 16777216.0);
}

// Value noise: the lattice, interpolated with a smoothstep fade so the field
// has no visible seams where the cells meet.
float ValueNoise(vec2 p, uint seed)
{
	vec2 base = floor(p);
	vec2 f = p - base;
	vec2 w = f * f * (3.0 - 2.0 * f);

	ivec2 c = ivec2(base);
	float a = Lattice(c + ivec2(0, 0), seed);
	float b = Lattice(c + ivec2(1, 0), seed);
	float d = Lattice(c + ivec2(0, 1), seed);
	float e = Lattice(c + ivec2(1, 1), seed);

	return mix(mix(a, b, w.x), mix(d, e, w.x), w.y);
}

// The field above has a standard deviation of 0.1392 -- measured, not assumed.
// Interpolating between lattice points narrows the distribution, and stacking
// octaves narrows it again, so it is nowhere near the 0.2887 of the uniform
// hash this replaces. 7.19 makes it 1.0, and the amplitude below is then in
// display levels directly.
const float kGrainNormalise = 7.19;

// About 11 levels of 255 at full strength: a stock, not a dusting. Lower than
// the 0.072 the old white-noise field used, deliberately -- noise with
// structure reads as considerably stronger than noise without at the same
// RMS, because the eye is far more sensitive at the size of a clump than at
// the size of a pixel.
const float kGrainAmplitude = 0.045;

// Signed grain per channel, normalised to unit standard deviation.
vec3 GrainField(vec2 p, uint frame)
{
	// Two octaves of clumping, shared across the channels.
	float clump = ValueNoise(p, frame) - 0.5;
	float mid = ValueNoise(p * 2.17 + vec2(19.0, 7.0), frame ^ 0x9e3779b9u) - 0.5;

	// Neither `shared` nor `common`: GLSL reserves both, along with a long
	// list of words it has no use for but has kept anyway. The error names
	// the line *after* the offending one, which is worth knowing before
	// spending a rebuild on it.
	float clumping = 0.55 * clump + 0.30 * mid;

	// And the finest octave per channel, at 15% of the amplitude -- which
	// measures as a channel correlation of 0.95. Enough to break up the flat
	// grey of a single monochrome overlay, not enough to read as colour noise.
	vec3 fine = vec3(
		ValueNoise(p * 4.63 + vec2(0.0),  frame ^ 0x85ebca6bu),
		ValueNoise(p * 4.63 + vec2(31.7), frame ^ 0xc2b2ae35u),
		ValueNoise(p * 4.63 + vec2(63.1), frame ^ 0x27d4eb2fu)) - vec3(0.5);

	return (vec3(clumping) + 0.15 * fine) * kGrainNormalise;
}

// ACES filmic approximation (Narkowicz). Without tone mapping anything above
// 1.0 clips to white, and the specular highlights that make PBR read as PBR
// are the first thing lost.
vec3 TonemapACES(vec3 x)
{
	const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
	return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

void main()
{
	// The destination row this fragment writes and the source row v_UV
	// names are the same row on OpenGL and opposite rows on Vulkan. See
	// PostProcess::Dispatch.
	vec2 uv = vec2(v_UV.x, u_Params.FlipY > 0.5 ? 1.0 - v_UV.y : v_UV.y);

	// Chromatic aberration first, on the linear sample, because a lens
	// disperses before the sensor sees anything. Three taps radially offset
	// from the centre: dispersion grows towards the edge of the frame and is
	// zero in the middle, which is what a real lens does and what stops the
	// effect reading as a colour fringe on everything.
	vec3 color;
	if (u_Params.Aberration > 0.0)
	{
		vec2 toCentre = uv - vec2(0.5);
		vec2 offset = toCentre * u_Params.Aberration;

		color = vec3(texture(u_Scene, uv + offset).r,
					 texture(u_Scene, uv).g,
					 texture(u_Scene, uv - offset).b);
	}
	else
	{
		color = texture(u_Scene, uv).rgb;
	}

	// The bloom is added undispersed. It is blurred far wider than any sane
	// offset, so three taps of it would shift something nobody could see had
	// moved.
	color += texture(u_Bloom, uv).rgb * u_Params.BloomIntensity;

	// Exposure before the curve, which is what makes it an exposure control
	// rather than a brightness one: it slides the scene along the response
	// curve instead of scaling the result of it.
	//
	// With auto exposure on, the profile's own value stops being the exposure
	// and becomes exposure *compensation* -- it multiplies what the metering
	// worked out, the same control a camera has and for the same reason. The
	// branch, rather than multiplying by a buffer that holds 1, is what keeps
	// "off" exact. ENGINE-NOTES 7y.
	if (u_Params.AutoExposure > 0.5)
		color *= u_Params.Exposure * u_Exposure.Exposure;
	else
		color *= u_Params.Exposure;

	// And the vignette before the curve too, for the same reason exposure is:
	// it is *less light arriving*, so it should roll off through the response
	// curve like everything else. After the curve it multiplies display
	// values and reads as a shadow painted on the result. ENGINE-NOTES 7w.
	if (u_Params.Vignette > 0.0)
	{
		// Distance from the centre, in units where the corner is 1. Not
		// aspect-corrected on purpose: a vignette that is a circle on a
		// 21:9 frame leaves the middle of the top edge darker than the
		// middle of the sides, which is not what a lens does.
		float d = length(uv - vec2(0.5)) * 1.41421356;

		// smoothstep rather than a power: the falloff has a start and an end
		// that a person can reason about, and at smoothness 1 it begins at
		// the centre rather than never quite arriving.
		float falloff = smoothstep(1.0 - u_Params.VignetteSmoothness, 1.0, d);
		color *= mix(1.0, 1.0 - u_Params.Vignette, falloff);
	}

	color = TonemapACES(color);

	// The swapchain is UNORM rather than sRGB, so the transfer function is
	// applied here instead of by the hardware.
	color = pow(color, vec3(1.0 / 2.2));

	// Colour grading, **after** the transfer function.
	//
	// A `.cube` from a grading tool was authored against what a display shows
	// -- encoded, in 0..1 -- so this is the point where the value the LUT
	// expects actually exists. Applying it in linear light would need a shaper
	// the LUT's author also used, which is a different feature with a
	// different input. ENGINE-NOTES 7t.
	if (u_Params.LutSize > 1.5)
	{
		// Texel *centres*: a colour c lands at (c * (N-1) + 0.5) / N, not at
		// c. The difference is half a texel -- about 1.5% of the range at
		// N = 32 -- and getting it wrong produces a grade that is smooth,
		// plausible and not the one that was authored, everywhere, with no
		// artefact to notice. The identity check exists for exactly this line.
		float n = u_Params.LutSize;
		vec3 coord = (clamp(color, 0.0, 1.0) * (n - 1.0) + 0.5) / n;

		vec3 graded = texture(u_ColorLut, coord).rgb;
		color = mix(color, graded, clamp(u_Params.LutStrength, 0.0, 1.0));
	}

	// Grain last: after the curve *and* after the LUT.
	//
	// Grain is the texture of the recording medium, not a colour anybody
	// graded. Before the LUT, the grade re-maps the noise -- amplifying it
	// wherever the look stretches the range and crushing it wherever the look
	// compresses -- so the grain would change character with the grade instead
	// of sitting on top of it. ENGINE-NOTES 7w.
	if (u_Params.Grain > 0.0)
	{
		// The grain size is the lattice period in pixels, so a speck covers
		// several pixels at larger settings. Seeded with the frame number, so
		// it animates and still reproduces.
		vec3 grain = GrainField(gl_FragCoord.xy / max(u_Params.GrainSize, 1.0),
								uint(u_Params.Frame));

		// Where grain lives on the tone scale, and this is the half that was
		// wrong rather than merely coarse.
		//
		// Film grain peaks in the **midtones** and disappears at both ends:
		// nothing is exposed in the blacks and everything is exposed in the
		// highlights, so neither end has any variation left to show. The curve
		// here used to be `1.0 - luma * 0.5`, which is *largest at black* --
		// the comment above it said it kept the shadows clean and the
		// arithmetic did the opposite, which is most of why this read as
		// sensor noise rather than as stock.
		//
		// The square root of the parabola rather than the parabola, which on
		// its own is too narrow: it leaves grain in a band around mid grey
		// with a visibly clean zone either side.
		float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
		float response = sqrt(max(4.0 * luma * (1.0 - luma), 0.0));

		color = clamp(color + grain * (u_Params.Grain * kGrainAmplitude * response),
					  0.0, 1.0);
	}

	o_Color = vec4(color, 1.0);
}
