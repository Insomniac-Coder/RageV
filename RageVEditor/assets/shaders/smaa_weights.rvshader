// SMAA pass 2 of 3: how much of each pixel did the real edge actually cover?
//
// This is the pass that makes morphological anti-aliasing different in kind
// from FXAA. It does not blur an edge it found -- it reconstructs the straight
// line the rasterizer was approximating, and then computes coverage from it.
//
// For a pixel whose north side is an edge:
//
//   1. Walk left and right along the run of north-edges it belongs to.
//   2. At each end of the run, look at the *crossing* edge -- the vertical
//      discontinuity that stopped it. Which row that sits in says whether the
//      silhouette stepped up or stepped down there.
//   3. That gives the line two endpoints, half a pixel above or below the row
//      boundary. Everything else is the area of a trapezoid.
//
// The reference implementation looks step 3 up in a 179 KB texture. It is
// fifteen lines of arithmetic, and on any current GPU a dependent texture
// fetch costs more than the arithmetic it replaces. See ENGINE-NOTES 7n.
//
// Output, RGBA8, all four in [0, 0.5]:
//
//   .r  I blend this much towards the pixel NORTH of me
//   .g  the pixel north of me blends this much back towards me
//   .b  I blend this much towards the pixel WEST of me
//   .a  the pixel west of me blends this much back towards me
//
// Two edges, four numbers: an edge is computed once, by the pixel on its
// south or east side, and both sides of the answer are stored. The blending
// pass gathers the other half from its neighbour. Computing it twice would
// mean two searches per edge and two chances to disagree.

#type vertex
#version 450 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 450 core

layout(location = 0) in vec2 v_UV;
layout(location = 0) out vec4 o_Weights;

layout(set = 0, binding = 0) uniform sampler2D u_Edges;

layout(push_constant) uniform Params
{
	vec2  TexelSize;
	float Unused0;
	float Unused1;
	float Unused2;
	float FlipY;
} u_Params;

// How far a run is followed before the filter gives up and treats that end as
// carrying no slope information. Longer reaches shallower edges and costs a
// fetch per step -- but only on edge pixels, which are a small part of a frame.
//
// A plain point-sampled step rather than the reference's two-at-a-time
// bilinear trick. That trick is an optimisation, and this repository has been
// wrong about two "obviously worth it" optimisations already; it gets measured
// before it gets clever.
const int kMaxSearchSteps = 16;

// The diagonal search. A 43-degree edge breaks its staircase about every
// fourteen pixels -- one over the departure from 45 -- so sixteen reaches the
// break for anything from roughly 42 to 48 degrees and reports "centred",
// which is the right answer, for everything nearer the diagonal than that.
const int kMaxDiagonalSteps = 16;

// How much longer a diagonal run has to be than the orthogonal one before it
// is believed.
//
// Measured, not chosen. On a fan of thin bars, against a 4x supersampled
// reference: 4.313 with no margin, 4.104 at 2, 3.944 at 4, and 3.933 at 8 --
// which is exactly the score with the diagonal pass switched off entirely, so
// at 8 it has stopped doing harm. The 43 degree edge it exists for is
// unaffected all the way up, and marginally better at 8 than at 0.
const float kDiagonalMargin = 8.0;

// Where the line leaves this end of the run, in pixels either side of the
// boundary it is crossing.
//
//   negative side  the silhouette steps that way, so the line exits half a
//                  pixel to the negative side: north for a horizontal run,
//                  west for a vertical one
//   positive side  the other way
//   both, or none  no slope information. Both means a hard perpendicular stop
//                  -- a corner rather than a slope. None means the search hit
//                  its limit. Either way a flat end is the honest answer.
float EndHeight(float crossingNegative, float crossingPositive)
{
	bool negative = crossingNegative > 0.5;
	bool positive = crossingPositive > 0.5;

	if (negative == positive)
		return 0.0;

	return negative ? -0.5 : 0.5;
}

// The coverage of one pixel by a line that enters the run at height `yStart`
// and leaves it at `yEnd`, with `d1` pixels of run behind this one and `d2`
// ahead.
//
// Returns (positive side, negative side): how much of this pixel belongs to
// the other side of the line, and how much of the pixel across the boundary
// belongs to this one. Exactly one of the two is non-zero unless the line
// crosses the boundary inside this very pixel.
vec2 Coverage(float d1, float d2, float yStart, float yEnd)
{
	float length = d1 + d2 + 1.0;

	// Where the line enters and leaves *this* pixel. The run spans
	// [-d1, d2+1] and this pixel is [0, 1] of it.
	float y0 = mix(yStart, yEnd, d1 / length);
	float y1 = mix(yStart, yEnd, (d1 + 1.0) / length);

	if (y0 * y1 >= 0.0)
	{
		// Both ends the same side of the boundary: one trapezoid, and its
		// sign says which of the two pixels the sliver belongs to.
		float area = 0.5 * (y0 + y1);
		return area >= 0.0 ? vec2(area, 0.0) : vec2(0.0, -area);
	}

	// The line crosses the boundary inside this pixel, so both pixels get
	// something: two triangles meeting where it crosses.
	float crossing = -y0 / (y1 - y0);
	float first  = 0.5 * y0 * crossing;
	float second = 0.5 * y1 * (1.0 - crossing);

	return y0 >= 0.0 ? vec2(first, -second) : vec2(second, -first);
}

// --- the diagonal case ------------------------------------------------------
//
// On a near-45-degree edge every orthogonal run is *one pixel long*, so the
// reconstruction above degenerates: both ends carry a crossing edge, the line
// goes through the pixel's middle, and every pixel on the edge gets two
// eighths regardless of where the real line sits. The pattern it reads is
// identical for every sub-pixel offset, so there is nothing left to recover.
//
// The information is along the other axis. Walk diagonally and the run is
// long again. ENGINE-NOTES 7p.

// Integral of clamp(t, 0, 1) from zero, which is all a line crossing a pixel
// needs. Exact rather than sampled, and checked against numeric integration
// across the whole range before it was written down.
float ClampIntegral(float t)
{
	if (t <= 0.0) return 0.0;
	if (t >= 1.0) return t - 0.5;
	return 0.5 * t * t;
}

// How much of the unit square lies above a line that enters at height `k` and
// leaves one pixel later at `k + slope`.
//
// Checks out at the three cases anyone can verify by eye: a line corner to
// corner gives a half, one entering half a pixel down gives an eighth, and
// the mirror of that gives seven eighths.
float LineArea(float k, float slope)
{
	float entry = k;
	float exit  = k + slope;
	return ClampIntegral(max(entry, exit)) - ClampIntegral(min(entry, exit));
}

float FlagAt(vec2 uv, vec2 mask)
{
	return dot(texture(u_Edges, uv).rg, mask);
}

// How many consecutive pixels carry this flag, stepping by `stride`.
float Walk(vec2 uv, vec2 stride, vec2 mask, int limit)
{
	float count = 0.0;
	for (int i = 1; i <= limit; i++)
	{
		if (FlagAt(uv + float(i) * stride, mask) <= 0.5)
			break;
		count += 1.0;
	}
	return count;
}

// Coverage from a diagonal run, the same shape of argument as Coverage above:
// walk the run, read the end, integrate a clamped line.
//
// Returns (this pixel, the pixel across the edge), same as Coverage.
vec2 DiagonalCoverage(vec2 uv, vec2 mask, vec2 stride, vec2 alongOrtho,
					  float slope, float behind, float ahead)
{
	float len = behind + ahead + 1.0;

	// Which way the line drifts across the run. A diagonal run ends where the
	// staircase takes a double step, and which way it doubles is the slope's
	// departure from exactly 45 degrees: along the orthogonal axis means
	// shallower, across it means steeper.
	vec2 last = uv + ahead * stride;
	float shallower = FlagAt(last + alongOrtho, mask);
	float steeper   = FlagAt(last + (stride - alongOrtho), mask);

	// A half is not a fallback. At exactly 45 degrees every sub-pixel offset
	// produces the identical staircase, so there is genuinely nothing to
	// recover and a centred line is the honest answer -- and that is also what
	// a run truncated by the search limit reports, which is the same statement
	// about the same missing information.
	float t = 0.5;
	if (shallower > 0.5 && steeper <= 0.5)
		t = (behind + 0.5) / len;
	else if (steeper > 0.5 && shallower <= 0.5)
		t = 1.0 - (behind + 0.5) / len;

	float k = slope < 0.0 ? t : t - 1.0;
	return vec2(LineArea(k, slope), 1.0 - LineArea(k + 1.0, slope));
}

void main()
{
	// See PostProcess::Dispatch for the flip, and ENGINE-NOTES 7n for why this
	// pass needs the *direction* as well: after the flip, one pixel towards
	// the top of the image is still -texel.y on Vulkan and +texel.y on OpenGL,
	// and every offset below is signed.
	const bool flip = u_Params.FlipY > 0.5;
	vec2 uv = vec2(v_UV.x, flip ? 1.0 - v_UV.y : v_UV.y);

	vec2 texel = u_Params.TexelSize;
	vec2 up    = vec2(0.0, texel.y * (flip ? -1.0 : 1.0));
	vec2 right = vec2(texel.x, 0.0);

	vec2 down = -up;

	// Which flag each half of this shader is following.
	const vec2 maskNorth = vec2(0.0, 1.0);
	const vec2 maskWest  = vec2(1.0, 0.0);

	vec2 edges = texture(u_Edges, uv).rg;
	vec4 weights = vec4(0.0);

	// --- the north edge: a horizontal run --------------------------------
	if (edges.y > 0.5)
	{
		// Three runs through this pixel, and the longest wins -- but only by
		// a clear margin, and that margin is the whole of what a fan of thin
		// bars taught this pass.
		//
		// Reconstruct along whichever axis still has information: a shallow
		// edge has a long horizontal run and diagonal runs of one or two, a
		// near-diagonal edge has exactly the reverse, and nothing here needs a
		// threshold on the angle, which is good, because the angle is the
		// thing being measured.
		//
		// **But a short run is not information.** A run of three resolves
		// coverage to a third, and on content that turns every few pixels the
		// bare "longest wins" rule fires on those constantly -- measurably
		// replacing a mediocre answer with a worse one. Requiring the diagonal
		// to win by kDiagonalMargin says the same thing twice over, since the
		// orthogonal run is never negative: the diagonal has to be long, *and*
		// it has to be the longer of the two.
		vec2 upRight   = right + up;
		vec2 downRight = right + down;

		float upBehind   = Walk(uv, -upRight,   maskNorth, kMaxDiagonalSteps);
		float upAhead    = Walk(uv,  upRight,   maskNorth, kMaxDiagonalSteps);
		float downBehind = Walk(uv, -downRight, maskNorth, kMaxDiagonalSteps);
		float downAhead  = Walk(uv,  downRight, maskNorth, kMaxDiagonalSteps);

		float straight = Walk(uv, -right, maskNorth, kMaxSearchSteps)
					   + Walk(uv,  right, maskNorth, kMaxSearchSteps);

		if (max(upBehind + upAhead, downBehind + downAhead) > straight + kDiagonalMargin)
		{
			// The line runs up-right or down-right; in this pixel's own frame
			// that is a slope of -1 or +1.
			if (upBehind + upAhead >= downBehind + downAhead)
				weights.rg = DiagonalCoverage(uv, maskNorth, upRight, right,
											  -1.0, upBehind, upAhead);
			else
				weights.rg = DiagonalCoverage(uv, maskNorth, downRight, right,
											  1.0, downBehind, downAhead);
		}
		else
		{
		float behind = 0.0;
		for (int i = 1; i <= kMaxSearchSteps; i++)
		{
			if (texture(u_Edges, uv - float(i) * right).g <= 0.5)
				break;
			behind += 1.0;
		}

		float ahead = 0.0;
		for (int i = 1; i <= kMaxSearchSteps; i++)
		{
			if (texture(u_Edges, uv + float(i) * right).g <= 0.5)
				break;
			ahead += 1.0;
		}

		// The run covers columns [x - behind, x + ahead]. The vertical edge
		// that ends it is the west-edge flag of the first column *in* the run
		// on the left, and of the first column past it on the right.
		vec2 westEnd = uv - behind * right;
		vec2 eastEnd = uv + (ahead + 1.0) * right;

		float yStart = EndHeight(texture(u_Edges, westEnd + up).r,
								 texture(u_Edges, westEnd).r);
		float yEnd   = EndHeight(texture(u_Edges, eastEnd + up).r,
								 texture(u_Edges, eastEnd).r);

		weights.rg = Coverage(behind, ahead, yStart, yEnd);
		}
	}

	// --- the west edge: a vertical run, the same thing rotated ------------
	if (edges.x > 0.5)
	{
		// And the diagonal case rotated with it. The frame is transposed, so
		// the run axis is vertical and "shallower" means nearer vertical.
		vec2 downRight = down + right;
		vec2 downLeft  = down - right;

		float rightBehind = Walk(uv, -downRight, maskWest, kMaxDiagonalSteps);
		float rightAhead  = Walk(uv,  downRight, maskWest, kMaxDiagonalSteps);
		float leftBehind  = Walk(uv, -downLeft,  maskWest, kMaxDiagonalSteps);
		float leftAhead   = Walk(uv,  downLeft,  maskWest, kMaxDiagonalSteps);

		float straight = Walk(uv,  up,   maskWest, kMaxSearchSteps)
					   + Walk(uv,  down, maskWest, kMaxSearchSteps);

		if (max(rightBehind + rightAhead, leftBehind + leftAhead) > straight + kDiagonalMargin)
		{
			if (rightBehind + rightAhead >= leftBehind + leftAhead)
				weights.ba = DiagonalCoverage(uv, maskWest, downRight, down,
											  1.0, rightBehind, rightAhead);
			else
				weights.ba = DiagonalCoverage(uv, maskWest, downLeft, down,
											  -1.0, leftBehind, leftAhead);
		}
		else
		{
		float behind = 0.0;
		for (int i = 1; i <= kMaxSearchSteps; i++)
		{
			if (texture(u_Edges, uv + float(i) * up).r <= 0.5)
				break;
			behind += 1.0;
		}

		float ahead = 0.0;
		for (int i = 1; i <= kMaxSearchSteps; i++)
		{
			if (texture(u_Edges, uv - float(i) * up).r <= 0.5)
				break;
			ahead += 1.0;
		}

		vec2 northEnd = uv + behind * up;
		vec2 southEnd = uv - (ahead + 1.0) * up;

		float yStart = EndHeight(texture(u_Edges, northEnd - right).g,
								 texture(u_Edges, northEnd).g);
		float yEnd   = EndHeight(texture(u_Edges, southEnd - right).g,
								 texture(u_Edges, southEnd).g);

		weights.ba = Coverage(behind, ahead, yStart, yEnd);
		}
	}

	o_Weights = weights;
}
