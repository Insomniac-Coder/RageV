// WR-16 S4b, the second of the sea's two lamp passes: the neighbours, then
// the light.
//
// Every pixel has finished choosing by the time this runs, so here a pixel
// may ask the ones around it what they kept -- the whole reason this is a
// pass of its own. Their choices are merged into its own in its own terms (a
// neighbour's lamp is re-scored here before it is believed), the survivors
// are shaded in full, one shadow ray each is traced, and the answer goes out
// as two pictures: the part of the lamp light that scatters into the water,
// and the part that glints off its surface. The water pass keeps those two
// apart -- the glitter reflected before the light ever entered the sea, so
// it must not be dimmed by what the sea absorbs.
//
// **The shading here is the water pass's, and the two must agree.** That is
// what shading the sea's lamps somewhere else costs. It is paid down where
// it can be: the lobe and its masking come from the shared include, the
// shadow ray is literally the lit shader's own function -- cutout test
// inside traversal and all, which the bridge's masked thin members need --
// and what is left is the sized lamp's closest-point half vector and the
// widening, copied in the order the lit shader does them.
#type vertex
#version 460 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 460 core

#define RV_TRACE_ONLY
#include "include/pbr_fragment.glsl"
#include "include/water_lobe.glsl"
#include "include/water_lamps.glsl"

layout(location = 0) in vec2 v_UV;

layout(location = 0) out vec4 o_LampDiffuse;
layout(location = 1) out vec4 o_LampSpecular;

void main()
{
	o_LampDiffuse = vec4(0.0);
	o_LampSpecular = vec4(0.0);

	const WaterPoint p = FetchWaterPoint(ivec2(gl_FragCoord.xy));
	const int K = LampBudget();
	if (!p.Valid || K == 0)
		return;

	// **By texel, never by coordinate.** A choice is a light's index and the
	// weight the estimate divides by; neither is a thing to address in
	// normalised coordinates. Read through a sampler this pass shaded the
	// lamp its neighbour had chosen, with a weight computed for a third one,
	// and the sea came out at a third of its light with no other symptom.
	const ivec2 mineTexel = ivec2(gl_FragCoord.xy);
	const uvec4 mineIndex = texelFetch(u_ReservoirIndex, mineTexel, 0);
	const uvec4 mineWeight = texelFetch(u_ReservoirWeight, mineTexel, 0);

	uint  index[4];
	uint  frames[4];
	float weight[4];
	float target[4];
	for (int r = 0; r < 4; ++r)
	{
		const Reservoir mine = UnpackReservoir(mineIndex, mineWeight, uint(r));
		index[r] = mine.Index;
		frames[r] = mine.M;
		weight[r] = mine.W;
		target[r] = 0.0;
		if (mine.M > 0u && mine.W > 0.0)
		{
			vec3 L;
			float NdotL;
			target[r] = ScoreLamp(p, mine.Index, L, NdotL);
			if (NdotL <= 0.0)
			{
				frames[r] = 0u;
				weight[r] = 0.0;
			}
		}
	}

	// **The neighbours.** Three of them, on a ring turned by this pixel's own
	// angle so the pattern does not line up across the frame. One standing on
	// a different piece of sea -- across the pier's edge, or a wave away -- is
	// dropped rather than blended, on the distance between the two surfaces,
	// with the slack growing with distance because a far pixel covers metres.
	const uvec2 px = uvec2(gl_FragCoord.xy);
	const uint cap = uint(max(u_Lamps.History.y, 1.0));
	const vec2 texel = 1.0 / vec2(textureSize(u_WaterPositionIn, 0));
	const uint salt = LampFrameSalt();
	const float turn = LampRandom(px.x ^ (px.y << 16u) ^ salt ^ 0x9E3779B9u) * 6.28318530718;
	const float myDepth = dot(p.Position - u_Scene.CameraPosition.xyz,
							  u_Scene.CameraForward.xyz);
	const float slack = myDepth;   // reported by the probe
	const int neighbours = u_Lamps.History.z > 0.5 ? 3 : 0;
	float triedNeighbours = 0.0;
	float tookNeighbours = 0.0;
	for (int s = 0; s < neighbours; ++s)
	{
		triedNeighbours += 1.0;
		const float angle = turn + float(s) * 2.09439510239;
		// The ring in framebuffer texels, for the same reason: a coordinate
		// and a fragment do not agree about which way is up on this backend.
		const ivec2 size = textureSize(u_WaterPositionIn, 0);
		const ivec2 theirTexel = mineTexel
							   + ivec2(round(vec2(cos(angle), sin(angle)) * 12.0));
		if (any(lessThan(theirTexel, ivec2(0))) || any(greaterThanEqual(theirTexel, size)))
			continue;

		const vec4 theirPosition = texelFetch(u_WaterPositionIn, theirTexel, 0);
		if (theirPosition.w <= 0.5)
			continue;
		// **Depth and normal, not a distance in metres.** The sea is seen
		// nearly edge on: twelve pixels toward the horizon is hundreds of
		// metres of water, so a world-space slack rejects every neighbour
		// a grazing view has -- measured, three tried and none taken on
		// every pixel of the bay. What actually says 'the same surface' is
		// the pair the design named: depth within a tenth, and normals
		// within a wide angle, wide because a wave's normal turns fast and
		// two neighbours on one swell are still the same swell.
		const float theirDepth = dot(theirPosition.xyz - u_Scene.CameraPosition.xyz,
									 u_Scene.CameraForward.xyz);
		if (abs(theirDepth - myDepth) > 0.1 * max(myDepth, 1.0))
			continue;
		const vec2 theirXZ = texelFetch(u_WaterSurfaceIn, theirTexel, 0).xy;
		const vec3 theirN = vec3(theirXZ.x,
								 sqrt(max(1.0 - dot(theirXZ, theirXZ), 0.0)), theirXZ.y);
		if (dot(theirN, p.N) < 0.85)
			continue;
		tookNeighbours += 1.0;

		const uvec4 theirIndex = texelFetch(u_ReservoirIndex, theirTexel, 0);
		const uvec4 theirWeight = texelFetch(u_ReservoirWeight, theirTexel, 0);
		for (int r = 0; r < K; ++r)
		{
			const Reservoir theirs = UnpackReservoir(theirIndex, theirWeight, uint(r));
			if (theirs.M == 0u || theirs.W <= 0.0)
				continue;
			if (LampOutOfRange(theirs.Index, p.Position))
				continue;

			vec3 L;
			float NdotL;
			const float here = ScoreLamp(p, theirs.Index, L, NdotL);
			if (NdotL <= 0.0 || here <= 0.0)
				continue;

			const float mineSum = target[r] > 0.0
								? target[r] * weight[r] * float(frames[r]) : 0.0;
			const float theirSum = here * theirs.W * float(min(theirs.M, cap));
			const float sum = mineSum + theirSum;
			if (sum <= 0.0)
				continue;

			uint keptIndex = index[r];
			float keptTarget = target[r];
			if (LampRandom(px.x ^ (px.y << 16u) ^ (uint(r) << 24u)
						   ^ (uint(s) << 8u) ^ salt ^ 0x85EBCA6Bu) < theirSum / sum)
			{
				keptIndex = theirs.Index;
				keptTarget = here;
			}
			// **The cap goes on each input, never on the sum.** Each
			// neighbour brings min(M, cap) frames into the numerator, so the
			// denominator has to carry the same frames or the estimate is
			// inflated by whatever was clamped away. Capping the sum here
			// read as a brightening that happened to cancel a displacement
			// elsewhere -- two wrongs, and only one of them visible.
			const uint merged = frames[r] + min(theirs.M, cap);
			index[r] = keptIndex;
			frames[r] = merged;
			target[r] = keptTarget;
			weight[r] = keptTarget > 0.0 ? sum / (float(merged) * keptTarget) : 0.0;
		}
	}

	// **The survivors, shaded and traced.** One ray each, always: choosing
	// which lamps deserve a ray is what all of this was for.
	vec3 diffuse = vec3(0.0);
	vec3 specular = vec3(0.0);
	for (int r = 0; r < K; ++r)
	{
		if (frames[r] == 0u || weight[r] <= 0.0)
			continue;

		vec3 lampDiffuse, lampSpecular, L;
		float toward;
		ShadeLamp(p, index[r], lampDiffuse, lampSpecular, L, toward);
		if (toward <= 0.0)
			continue;

		const float visible = TraceShadowSoftFromMasked(
			p.Position, p.N, L, toward, u_Lights.Lights[index[r]].Direction.w,
			index[r], RV_RAY_MASK_SCENE);

		const float scale = visible * weight[r] / float(K);
		diffuse += lampDiffuse * scale;
		specular += lampSpecular * scale;
	}

	o_LampDiffuse = vec4(diffuse, 1.0);
	o_LampSpecular = vec4(specular, 1.0);

	// **The one pixel under the microscope** (--lamp-probe=x,y). Everything
	// the estimate turns on, beside the answer it should have produced. A
	// picture cannot show a sum of scores.
	if (LampProbeHere())
	{
		const vec3 kLum = vec3(0.2126, 0.7152, 0.0722);
		const uint cell = WaterClusterCell(p.Position, v_UV);
		const uint offset = u_Cells.Cells[cell].Offset;
		const uint count = u_Cells.Cells[cell].Count;

		float swept = 0.0;
		float scoreSum = 0.0;
		vec3 walk = vec3(0.0);
		vec3 walkLit = vec3(0.0);
		for (uint e = 0u; e < count; ++e)
		{
			const uint i = u_CellIndices.Indices[offset + e];
			if (LampOutOfRange(i, p.Position))
				continue;
			vec3 sL;
			float sN;
			const float sc = ScoreLamp(p, i, sL, sN);
			if (sN <= 0.0)
				continue;
			swept += 1.0;
			scoreSum += sc;

			vec3 wd, ws, wL;
			float wt;
			ShadeLamp(p, i, wd, ws, wL, wt);
			if (wt <= 0.0)
				continue;
			walkLit += wd + ws;
			const float vis = TraceShadowSoftFromMasked(p.Position, p.N, wL, wt,
								u_Lights.Lights[i].Direction.w, i, RV_RAY_MASK_SCENE);
			walk += (wd + ws) * vis;
		}

		u_LampProbe.Values[0] = swept;
		u_LampProbe.Values[2] = float(count);
		u_LampProbe.Values[3] = float(K);
		for (int r = 0; r < 4; ++r)
		{
			u_LampProbe.Values[4 + r] = float(index[r]);
			u_LampProbe.Values[8 + r] = target[r];
			u_LampProbe.Values[12 + r] = weight[r];
			u_LampProbe.Values[16 + r] = 0.0;
			u_LampProbe.Values[20 + r] = 0.0;
			if (frames[r] > 0u && weight[r] > 0.0)
			{
				vec3 pd, ps, pL;
				float pt;
				ShadeLamp(p, index[r], pd, ps, pL, pt);
				u_LampProbe.Values[16 + r] = dot(pd + ps, kLum);
				if (pt > 0.0)
					u_LampProbe.Values[20 + r] = TraceShadowSoftFromMasked(
						p.Position, p.N, pL, pt, u_Lights.Lights[index[r]].Direction.w,
						index[r], RV_RAY_MASK_SCENE);
			}
		}
		u_LampProbe.Values[24] = dot(diffuse + specular, kLum);
		u_LampProbe.Values[25] = dot(walk, kLum);
		u_LampProbe.Values[26] = dot(walkLit, kLum);
		u_LampProbe.Values[27] = scoreSum;
		u_LampProbe.Values[28] = gl_FragCoord.x;
		u_LampProbe.Values[29] = gl_FragCoord.y;
		u_LampProbe.Values[40] = triedNeighbours;
		u_LampProbe.Values[41] = tookNeighbours;
		u_LampProbe.Values[42] = u_Lamps.History.z;
		u_LampProbe.Values[43] = float(frames[0]);
		u_LampProbe.Values[44] = slack;
		// slots 30 and 31 belong to the choose pass; left alone here.
	}
}
