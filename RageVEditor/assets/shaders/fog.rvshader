// Exponential height fog, over the depth buffer.
//
// The engine had no fog of any kind -- a search of the renderer returned
// nothing -- and for a night exterior that is most of the difference between
// a render and a photograph. Air is not clear: distance desaturates, the far
// end of a bridge goes to the colour of the sky behind it, and a lamp two
// hundred metres away is a smudge rather than a point.
//
// **Height fog rather than distance fog, and the integral rather than a
// curve.** Fog sits in a layer: it is thick at the water and thin at the
// tower tops, so how much a ray accumulates depends on where it starts,
// where it ends, and how steeply it climbs between them. A plain
// exp(-density * distance) cannot express that -- it fogs the tower and the
// deck equally -- and a screen-space fade fogs them by where they landed in
// the frame, which swims when the camera turns.
//
// So the density is integrated along the view ray:
//
//     density(y) = D * exp(-F * (y - H))
//
// which has a closed form over a straight segment, evaluated below. The
// camera can be inside the layer or above it and the answer stays right; fly
// the camera up and the fog thins under you rather than following.
//
// **Before tone mapping, on the linear image**, for the reason SSAO's apply
// pass gives about occlusion: fog is light, not a filter over a finished
// picture. It has to bloom, defocus and expose like the light it replaces --
// a fogged headlamp should bloom as the fog's colour, not have grey painted
// over its bloom afterwards.

#type vertex
#version 450 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 450 core

#include "include/view_reconstruction.glsl"

layout(location = 0) in vec2 v_UV;
layout(location = 0) out vec4 o_Color;

layout(set = 0, binding = 0) uniform sampler2D u_Scene;
layout(set = 0, binding = 1) uniform sampler2D u_Depth;

// **WR-3: the sky this fog is standing under.** The same cube the scene's
// surfaces reflect -- the baked gradient for a gradient sky, the scene's own
// environment map for a cubemap one -- so the haze cannot disagree with what
// is drawn behind it, and an HDRI sky tints the fog without this shader
// knowing what a gradient is. Always bound, because a declared binding with
// nothing in it is undefined on both backends; SkyAffect at zero is what says
// "do not read it", not a null.
//
// **A cube sample rather than a shared gradient function**, which is what the
// plan first proposed. Two reasons it came out this way: the gradient is
// seven vec4s of state and this pass's push block is already 128 bytes to the
// byte, so sharing the function means giving the fog a uniform buffer that
// PostProcess::Dispatch has no parameter for; and an analytic evaluator is
// blind to a cubemap sky, which is precisely the case where guessing the
// horizon colour is most wrong. The cost is resolution -- the gradient cube is
// 32 texels a face -- and fog is the one term in the frame that has no high
// frequencies to lose. The moon does not survive that filtering, which is
// correct: a crisp moon inside a haze layer would be the artefact.
layout(set = 0, binding = 2) uniform samplerCube u_Sky;

layout(push_constant) uniform Params
{
	float TexelX;          // PostParams' shared header
	float TexelY;
	float Density;         // the header's A
	float HeightFalloff;   // B
	float MaxOpacity;      // C
	float FlipY;

	float NearClip;
	float FarClip;
	float InvP0;
	float InvP1;

	// **Before the vec4s, because a vec4 here is 16-byte aligned.** The
	// header plus the four scalars above ends at 40; without these two the
	// shader would pad to 48 and read every field after by eight bytes off
	// the struct that filled it. StartDistance is how far the ray travels
	// before any fog accumulates -- zero is physically right and unhelpful
	// for a bonnet a metre from the camera.
	float StartDistance;
	float FogFloor;        // no air, and so no fog, below this world height

	// Rows of the camera-to-world rotation. **Their w lanes are WR-3's four
	// scalars**, and they go here rather than in a longer struct because this
	// block is already 128 bytes -- the size every Vulkan implementation
	// guarantees and the most this pass can be given. Four floats that were
	// being uploaded as zeros anyway is exactly the room WR-3 needed, which is
	// the only reason it did not have to grow a uniform buffer.
	vec4 CameraRow0;       // w: SkyIntensity
	vec4 CameraRow1;       // w: SkyRotation, radians
	vec4 CameraRow2;       // w: SkyAffect  -- inscatter colour from the sky
	// xyz: the camera's world position. w: SkyOcclusion -- how much the fog
	// eats the sky behind it. (WR-2 tried the frame number in this lane for
	// dither seeding and backed it out -- pre-exposure linear space is the
	// wrong place for a fixed 1/255 term; see tonemap.rvshader's final write.)
	vec4 CameraPosition;

	// rgb: what the fog is. w: the world height the density is quoted at,
	// so a scene can put the layer at the water rather than at the origin.
	vec4 Color;
} u_Fog;

void main()
{
	const bool flip = u_Fog.FlipY > 0.5;
	const vec2 uv = vec2(v_UV.x, flip ? 1.0 - v_UV.y : v_UV.y);

	const vec4 scene = texture(u_Scene, uv);
	const float raw = texture(u_Depth, uv).r;

	// **The sky is fogged too, and to its full depth.** Anything that wrote
	// no geometry sits at the far plane, and the honest answer for it is the
	// whole column of air -- which is what makes a distant headland read as
	// distance rather than as a cut-out pasted on the horizon. Without this
	// the fog stops at the last object and the sky stays crisp behind it,
	// which is the giveaway of every fog that was applied as a filter.
	const bool background = raw <= 0.000001;

	const float z = background ? u_Fog.FarClip
							   : LinearDepth(raw, u_Fog.NearClip, u_Fog.FarClip);
	const vec3 frame = ViewPosition(uv, z, vec2(u_Fog.InvP0, u_Fog.InvP1));

	// The reconstruction frame out to the world: undo the row direction and
	// the depth axis, then the camera. The same three lines rtgi_trace and
	// rtao_compute use, and deliberately identical -- three passes
	// disagreeing about where a pixel is would be three different bugs.
	const vec3 view = vec3(frame.x, flip ? -frame.y : frame.y, -frame.z);
	const vec3 world = u_Fog.CameraPosition.xyz
					 + vec3(dot(u_Fog.CameraRow0.xyz, view),
							dot(u_Fog.CameraRow1.xyz, view),
							dot(u_Fog.CameraRow2.xyz, view));

	vec3 ray = world - u_Fog.CameraPosition.xyz;
	float distance = length(ray);

	const float start = max(u_Fog.StartDistance, 0.0);
	if (distance <= start || distance <= 1e-4)
	{
		o_Color = scene;
		return;
	}

	// Only the part of the ray past the start distance accumulates, and it
	// starts from where the ray had got to -- not from the camera, or a
	// windscreen at half a metre would haze the moment the start was cleared.
	const vec3 direction = ray / distance;
	float travel = distance - start;
	vec3 origin = u_Fog.CameraPosition.xyz + direction * start;

	// **Clip the segment to the air.** Fog is atmosphere, and below the
	// waterline there is none -- but the integral below knows only about
	// height and distance, so without this it fogs a seabed twenty metres
	// down, and fogs it *harder* than the surface because the falloff makes
	// the layer densest at the bottom. Haze under the sea, which is the one
	// place haze cannot be.
	//
	// Solve for where the ray crosses the floor and keep the part above it.
	// A ray running level is either wholly in the air or wholly out of it,
	// and that branch is uniform across any run of pixels looking the same
	// way, so it costs nothing to take.
	{
		const float floorY = u_Fog.FogFloor;
		const float dy = direction.y;
		if (abs(dy) < 1.0e-6)
		{
			if (origin.y < floorY)
			{
				o_Color = scene;
				return;
			}
		}
		else
		{
			const float cross = (floorY - origin.y) / dy;
			if (dy < 0.0)
			{
				// Descending: in the air until it crosses.
				if (cross <= 0.0)
				{
					o_Color = scene;
					return;
				}
				travel = min(travel, cross);
			}
			else
			{
				// Climbing: in the air only after it crosses.
				if (cross >= travel)
				{
					o_Color = scene;
					return;
				}
				if (cross > 0.0)
				{
					origin += direction * cross;
					travel -= cross;
				}
			}
		}
	}

	if (travel <= 1e-4)
	{
		o_Color = scene;
		return;
	}

	const float falloff = max(u_Fog.HeightFalloff, 0.0);
	const float relative = origin.y - u_Fog.Color.w;

	// **The integral of density along the segment.**
	//
	//     integral of D*exp(-F*(y0 + t*dy)) dt, t from 0 to travel
	//   = D*exp(-F*y0) * (1 - exp(-F*dy*travel)) / (F*dy)
	//
	// The horizontal case is not a special case of that expression -- it is
	// 0/0 -- so it is written out. Ten centimetres of climb over a kilometre
	// is horizontal for this purpose, and the branch is uniform across any
	// run of pixels looking the same way, so it costs nothing to take.
	const float climb = falloff * direction.y;
	float optical;
	if (abs(climb) < 1.0e-5 || falloff <= 0.0)
	{
		// A layer of uniform density, or a ray that never leaves its height.
		optical = u_Fog.Density * exp(-falloff * relative) * travel;
	}
	else
	{
		optical = u_Fog.Density * exp(-falloff * relative)
				* (1.0 - exp(-climb * travel)) / climb;
	}

	// Beer-Lambert, then the author's ceiling. The clamp is not physical: it
	// is how a scene keeps a distant landmark readable through fog thick
	// enough to sell the air in front of it.
	const float fog = clamp((1.0 - exp(-max(optical, 0.0)))
							* clamp(u_Fog.MaxOpacity, 0.0, 1.0), 0.0, 1.0);

	// **WR-3: what colour the fog is, in this direction.**
	//
	// Air glows with the sky it sits under, and the sky is not one colour --
	// down this strait it is amber toward the city and near-black toward the
	// ocean, which is the single most characteristic thing about the view and
	// nothing a constant `Color` can say. Both dials at zero is the constant
	// this pass shipped with, so every profile written before WR-3 renders
	// byte-for-byte as it did; the branch is on push constants, so it is
	// uniform across the draw and the scenes that do not use it pay nothing.
	vec3 inscatter = u_Fog.Color.rgb;
	float occlusion = 0.0;

	const float skyAffect = clamp(u_Fog.CameraRow2.w, 0.0, 1.0);
	const float skyOcclusion = clamp(u_Fog.CameraPosition.w, 0.0, 1.0);

	if (skyAffect > 0.0 || skyOcclusion > 0.0)
	{
		// **Never below the horizon, and this is not a detail.** The obvious
		// reading of "the sky in this view direction" hands a ray aimed down
		// at the water the *ground* half of the gradient, and the first render
		// of this said so plainly: the haze over the strait went navy while
		// the sky above it stayed amber, because SkyGround is a stand-in for
		// dark terrain and a downward ray reads nothing else. But the air
		// between the camera and a ship two kilometres out is not lit by the
		// sea under it -- it is lit by the low sky in that bearing, which at
		// night is the city. Lifting the sample to the horizon plane keeps the
		// azimuth, which is where the whole effect lives (amber toward the
		// city, near-black toward the ocean), and drops only the elevation,
		// which for a horizontal kilometre of air was never the answer.
		// Aerial perspective by day works out the same way: a distant valley
		// goes pale toward the horizon sky, not dark toward the ground.
		const vec3 lifted = vec3(direction.x, max(direction.y, 0.0), direction.z);

		// **Spun the way the sky is spun, not the way the camera is.**
		// Skybox::BuildDirectionMatrix turns the sky by +SkyRotation and says
		// in as many words that the two differ by a sign; taking the other one
		// here would tint the fog toward a patch of sky the frame is not
		// showing, and it would look like a plausible colour while doing it.
		const float spin = u_Fog.CameraRow1.w;
		const float sine = sin(spin);
		const float cosine = cos(spin);
		const vec3 skyDirection = vec3(cosine * lifted.x + sine * lifted.z,
									   lifted.y,
									   -sine * lifted.x + cosine * lifted.z);

		// Level 0 explicitly. The post-process sampler is MaxLod 0 so this is
		// the only level it could read anyway, and asking for it by name keeps
		// an implicit-derivative fetch out of a branch -- which is undefined
		// the day someone makes this branch per-pixel.
		//
		// Times SkyIntensity, because the cube holds the sky's colours
		// unscaled: sky.rvshader applies exactly this multiply at its own
		// write, and fog that skipped it would tint toward a sky darker or
		// brighter than the one on screen.
		const vec3 sky = textureLod(u_Sky, skyDirection, 0.0).rgb * u_Fog.CameraRow0.w;

		inscatter = mix(u_Fog.Color.rgb, sky, skyAffect);

		// **Only where the sky itself is the thing behind.** A geometry pixel
		// is already attenuated by the mix below -- that is what the blend
		// *is* -- and dimming it again here would be a second, undeclared
		// exposure control. A background pixel is the one place the fog would
		// otherwise mix the sky toward itself and come out unchanged however
		// thick the air got, which is why a bank of it could not eat a
		// skyline until this term existed.
		occlusion = background ? skyOcclusion : 0.0;
	}

	// **WR-2: no dither here** -- tried it (salted, seeded off
	// CameraPosition.w, which is WR-3's SkyOcclusion now) and measured a
	// linear pre-exposure 1/255 coming out close to 10 levels of 255 after
	// Exposure/ACES/gamma at a representative night-sky brightness, the same
	// finding that took it out of sky.rvshader. tonemap.rvshader's single
	// dither, after all of that, is what actually lands at ~1 level.
	o_Color = vec4(mix(scene.rgb * (1.0 - fog * occlusion), inscatter, fog), scene.a);
}
