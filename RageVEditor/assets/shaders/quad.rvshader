// Authored once in Vulkan-flavoured GLSL with explicit set/binding decorations.
// glslang lowers this to SPIR-V for the Vulkan backend; SPIRV-Cross turns the
// same SPIR-V back into desktop GLSL for the OpenGL backend.

#type vertex
#version 450 core

layout(location = 0) in vec3  a_Position;
layout(location = 1) in vec3  a_Normal;
layout(location = 2) in vec4  a_Color;
layout(location = 3) in vec2  a_TexCoord;
layout(location = 4) in float a_TextureIndex;
layout(location = 5) in float a_TilingFactor;

const int MAX_LIGHTS = 8;

// std140 pads vec3 to vec4 inside arrays, so everything is declared as vec4 to
// keep the C++ mirror struct byte-identical.
layout(set = 0, binding = 0) uniform SceneData
{
	mat4 ViewProjection;
	vec4 CameraPosition;
	vec4 LightPositions[MAX_LIGHTS];
	vec4 LightColors[MAX_LIGHTS];
	int  LightCount;
} u_Scene;

layout(location = 0) out vec3      v_WorldPos;
layout(location = 1) out vec3      v_Normal;
layout(location = 2) out vec4      v_Color;
layout(location = 3) out vec2      v_TexCoord;
layout(location = 4) out float     v_TilingFactor;
layout(location = 5) flat out int  v_TextureIndex;

void main()
{
	// Renderer2D transforms vertices on the CPU, so a_Position is world space.
	v_WorldPos     = a_Position;
	v_Normal       = a_Normal;
	v_Color        = a_Color;
	v_TexCoord     = a_TexCoord;
	v_TilingFactor = a_TilingFactor;
	v_TextureIndex = int(a_TextureIndex + 0.5);

	gl_Position = u_Scene.ViewProjection * vec4(a_Position, 1.0);
}

#type fragment
#version 450 core

const int MAX_LIGHTS = 8;

layout(set = 0, binding = 0) uniform SceneData
{
	mat4 ViewProjection;
	vec4 CameraPosition;
	vec4 LightPositions[MAX_LIGHTS];
	vec4 LightColors[MAX_LIGHTS];
	int  LightCount;
} u_Scene;

layout(set = 1, binding = 0) uniform sampler2D u_Textures[32];

layout(location = 0) in vec3      v_WorldPos;
layout(location = 1) in vec3      v_Normal;
layout(location = 2) in vec4      v_Color;
layout(location = 3) in vec2      v_TexCoord;
layout(location = 4) in float     v_TilingFactor;
layout(location = 5) flat in int  v_TextureIndex;

layout(location = 0) out vec4 o_Color;
// Nothing here reports motion. The attachment is bound for the whole pass, so
// every pipeline in it declares the output; writing zero is the truthful
// answer for a background, a gizmo or a particle, and leaving it unwritten
// would be whatever the clear happened to be. ENGINE-NOTES 7r.
layout(location = 1) out vec2 o_Velocity;
// The surface-description attachment SSR reads. Zero decodes to "no
// surface", which the resolve reads as "no reflection" -- so this never
// reflects, which is right for what it draws. ENGINE-NOTES 7ad.
layout(location = 2) out vec4 o_Surface;
// The scene target's fourth attachment (ENGINE-NOTES 7av): traced indirect
// diffuse. This pass has none, and writes zero -- an attachment a pipeline
// declares and does not write is undefined, and the resolve reads it as light.
layout(location = 3) out vec4 o_Indirect;


void main()
{
	o_Velocity = vec2(0.0);
	o_Surface = vec4(0.0);
	o_Indirect = vec4(0.0);

	vec4 albedo = texture(u_Textures[v_TextureIndex], v_TexCoord * v_TilingFactor) * v_Color;

	if (u_Scene.LightCount == 0)
	{
		o_Color = albedo;
		return;
	}

	const float ambientStrength  = 0.1;
	const float specularStrength = 0.5;

	vec3 normal  = normalize(v_Normal);
	vec3 viewDir = normalize(u_Scene.CameraPosition.xyz - v_WorldPos);

	vec3 lighting = vec3(0.0);

	for (int i = 0; i < u_Scene.LightCount && i < MAX_LIGHTS; ++i)
	{
		vec3 lightColor = u_Scene.LightColors[i].rgb;
		vec3 lightDir   = normalize(u_Scene.LightPositions[i].xyz - v_WorldPos);

		vec3 ambient = ambientStrength * lightColor;

		float diff   = max(dot(normal, lightDir), 0.0);
		vec3 diffuse = diff * lightColor;

		vec3  reflectDir = reflect(-lightDir, normal);
		float spec       = pow(max(dot(viewDir, reflectDir), 0.0), 128.0);
		vec3  specular   = specularStrength * spec * lightColor;

		lighting += ambient + diffuse + specular;
	}

	o_Color = vec4(lighting * albedo.rgb, albedo.a);
}
