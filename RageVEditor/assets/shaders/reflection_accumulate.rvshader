// **The glossy reflection, averaged over the frames behind it -- for as long
// as there is evidence the frames behind it are the same picture.**
//
// ReflectionTrace draws a few rays from each glossy pixel's lobe, a different
// few every frame, and ReflectionResolve shares them across the rough
// neighbourhood. That estimate is right on average and grainy in detail,
// and the frame's temporal filter cannot smooth it once it is folded into the
// lit pixel: it clamps every sparkle back toward its neighbours, so the bright
// frames are thrown away and the mean sinks. Averaged on its own, before the
// lit shader ever sees it, the grain cancels and costs no rays -- the same
// argument water_accumulate makes for the sea's lamp light, whose shape this
// pass borrows.
//
// **Reprojected by the reflection's image, not by the surface.** A reflection
// is not painted on the floor: as the eye moves it slides across the floor,
// and a history read at the surface's old place holds the image of something
// else. What stays put under a moving eye is the mirror image itself -- for a
// flat mirror, the hit seen through the surface, as far behind it as the ray
// went. **For a curved one the image sits nearer.** A chrome pole is a convex
// mirror and a convex mirror's image lies almost at its own surface (the
// mirror equation: d / (1 + 2 d k) behind it, for curvature k), so the first
// version, which pushed every image the ray's full distance back, looked for
// a pole's history metres behind the pole -- on the wall -- and found the
// wall's reflection there (owner, 2026-09-05 night: "a LOT of smearing by the
// shiny poles"). The curvature is read from the neighbouring normals, and the
// distance is the one the frames behind this surface agreed on, not the one
// ray this frame happened to draw: a rough pixel's ray hits the tube one
// frame and the ceiling the next, and a history looked for at a different
// depth every frame is a trail.
//
// **And the history has to be the same reflector.** The reprojected texel is
// only worth averaging with if last frame's surface there was this surface:
// the same plane, facing the same way, about as rough. The second attachment
// carries the reflector and the third what was learned about it, and a
// history that fails the tests is refused; the surface's own old place is
// tried next, which is where a freshly moved reflector's picture is. Without
// the test every glossy texel accepted every other's, and in a room where
// every wall is inside the gloss window that was all of them.
//
// **Confidence-driven, not time-driven** (RT_Temporal_Reconstruction design,
// 2026-09-06): the memory shortens when the reprojection moves, in texels,
// measured with the jitter taken out (a parked camera moves nothing); a
// mirror, whose rays hardly scatter and whose fresh estimate is already
// exact, forgets fastest of all -- it has no grain to average, only a picture
// to keep up with; and the bound that pulls a surviving history back to the
// fresh neighbourhood never squeezes tighter than the pixel's own measured
// fluctuation, so grain is averaged and a real change is followed.
//
// The alpha carries how many frames stand behind the value. The lit shader
// reads it a frame late to decide how much of its probe to give up, and the
// composite after the temporal filter adds this frame's picture at this
// texel (reflection_composite.rvshader) -- the picture never passes through
// the frame's own temporal filter, which reprojects by the surface and
// smeared it.
#type vertex
#version 460 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 460 core

#define RV_TRACE_ONLY
#include "include/pbr_fragment.glsl"
// RT-5: every running average below is rounded onto the half grid before it
// is written -- see the include for the 1.7% it was losing.
#include "include/half_float.glsl"
// **Reprojection, measured (RT-first T5, 2026-09-06):** the surface rebuilt
// at the texel centre through the scene's view-projection, and the history
// looked up at the previous projection *minus* the previous jitter, is right
// as it stands -- rebuilding at the unjittered position, or adding the jitter
// instead, doubled the parked per-frame change and the motion error on every
// region of the garage. Leave both alone.

layout(location = 0) in vec2 v_UV;

// This frame's estimate, resolved: rgb the radiance, a the mean distance its
// rays travelled, or below zero where nothing is glossy.
layout(set = 3, binding = 0) uniform sampler2D u_Fresh;
// The scene's depth, to rebuild the surface point.
layout(set = 3, binding = 1) uniform sampler2D u_Depth;
// What this pass wrote last frame; w is the frames behind it.
layout(set = 3, binding = 2) uniform sampler2D u_History;
// The scene's surface: normal (octahedral, zero to one) for the curvature,
// roughness for the tests and the bound.
layout(set = 3, binding = 3) uniform sampler2D u_Surface;
// What this pass wrote about the reflector last frame: its normal (rg,
// octahedral, zero to one), the plane it lies in (b: n . P), and the
// distance to its image (a), below zero where there was no reflector.
layout(set = 3, binding = 4) uniform sampler2D u_HistorySurface;
// And what it learned: r the reflector's roughness, g and b the first two
// moments of the fresh estimate's luminance, a which candidate the texel
// took (0 none, 0.5 the surface's old place, 1 the image's).
layout(set = 3, binding = 5) uniform sampler2D u_HistoryExtra;
// The scene's velocity attachment (clip units, as TAA reads it): what the
// surfaces around a silhouette are doing, for the rule below.
layout(set = 3, binding = 6) uniform sampler2D u_Velocity;
// **RT-6.5: who this surface is, and who it was.** The G-buffer's id
// lane (signed object id in r), and the copy this pass kept last frame.
// The fourth history test: position, facing and shininess can all agree
// across two different objects, because the plane test's tolerance is
// 0.05 + 0.01 * eyeDistance -- a quarter of a metre at twenty.
layout(set = 3, binding = 9) uniform sampler2D u_SurfaceId;
layout(set = 3, binding = 10) uniform sampler2D u_HistoryIdent;
#if !defined(RV_SIGNAL_PAIR) && !defined(RV_SIGNAL_DIFFUSE)
// **RT-17: what this frame's rays struck** (reflection_trace's third lane): r the
// instance's identity, zero for a miss; g the struck normal, five bits a side.
// Its history is the id lane's b and a. Read only where Change.y says a trace
// wrote it and something moved this frame or the last -- the sea's mirror has no
// such lane and is bound black, and a still scene skips the test.
layout(set = 3, binding = 12) uniform sampler2D u_FreshIdentity;
// **RT-15: and how far what they struck travelled since last frame** (the trace's
// fourth lane): world metres in rgb, zero for a miss and for anything that stood
// still. Read under the same Change.y, and bound black with the lane above.
layout(set = 3, binding = 13) uniform sampler2D u_FreshTravel;
// **RT-15: the moving layer.** This frame's, from the resolve's second lane: rgb the part of
// the picture whose rays struck something that moved, a the share of the lobe those rays
// carried. And the one this pass kept last frame, in the history's sixth lane: rgb the layer,
// a its frames (zero where there was none). Read where Change.z says a resolve split this
// signal's picture and something moved; bound black otherwise.
layout(set = 3, binding = 14) uniform sampler2D u_FreshMoving;
layout(set = 3, binding = 15) uniform sampler2D u_HistoryMoving;
#endif
#ifdef RV_SIGNAL_PAIR
// The second payload (RT-first T5): a signal of two pictures -- the direct
// light's diffuse and specular halves -- sharing every test above. Its fresh
// frame and its own history; the same texel, the same frames, the same bound
// width from its own neighbourhood.
layout(set = 3, binding = 7) uniform sampler2D u_Fresh2;
layout(set = 3, binding = 8) uniform sampler2D u_History2;
#endif

layout(push_constant) uniform ReflectionParams
{
	// A texel and its depth back to the world, and where a world point sat
	// on screen last frame. Both carry their frame's jitter, as the
	// rasteriser drew with them.
	mat4 InverseViewProjection;
	mat4 PreviousViewProjection;
	// x: last frame's picture is there to average with. y: the most frames a
	// value may carry standing still. z: the fewest, under motion. w: one
	// where a texture row runs the other way up from a projected coordinate.
	vec4 History;
	// x: how far, in standard deviations of the fresh neighbourhood, a
	// history may stand from it before it is pulled back. y: the pixels the
	// reprojection may move before the memory starts shortening.
	vec4 Probe;
	// The signal's tuning (RT-first T4, Renderer3D::SignalParams): x the
	// smear cap in texels of travel, y the moving memory floor, z the
	// silhouette memory floor, w spare.
	vec4 Tuning;
	// The blur's (read by reflection_blur.rvshader; carried here so the two
	// share one push block).
	vec4 Blur;
	// RT-6.3: last frame's eye in xyz, w one when it is real.
	vec4 PreviousEye;
	// **Measured change (docs/RT-MEASURED-CHANGE.md): x one when binding 11
	// holds this signal's change map.** Zero is every frame before it existed.
	vec4 Change;
} u_Reflection;

// The change map, on the 3x3 block grid of this signal's own target: r the
// share of the diffuse light measured to have changed since last frame, g the
// highlight's. Black and unread where `Change.x` is zero.
layout(set = 3, binding = 11) uniform sampler2D u_Change;

// The map at a position in this target's texels, read filtered between the
// block centres -- a block's texel sits at the middle of its three.
vec2 MeasuredChangeAt(vec2 at)
{
	const vec2 blocks = vec2(textureSize(u_Change, 0));
	return texture(u_Change, (at / 3.0) / blocks).rg;
}

// Why the texel's own history was refused this frame, for the
// `reflection-refusal` debug view: 0 kept, 1 off screen, 2 none there,
// 3 normal, 4 plane, 5 roughness, 6 another object (RT-15c, the specular
// instance). Written into o_Extra.a above `choice`.
int g_Refusal = 0;
// RT-6.1: where the picture this texel took came from, last frame -- set
// when a candidate is accepted, so the motion write below has something to
// difference against.
vec2 g_ImageMotion = vec2(0.0);
// RT-6.5: this pixel's metallic, for the history gate. A global for the
// same reason the motion is one -- HistoryAt is called from two places and
// threading one more parameter through both says nothing the name does not.
float g_Metallic = 0.0;
// RT-6.5: this pixel's object id, for the same reason -- HistoryAt is
// called from two places and this is the same value at both.
float g_ObjectId = 0.0;
// RT-6.10: this frame's raw image distance, before it is blended into the
// history's. The comparison has to be against the *fresh* value -- the
// blended one has already been dragged toward whatever the history holds,
// which is the thing being tested.
float g_FreshImage = 0.0;
bool g_HaveMotion = false;
// RT-19: whether this texel ended up blending a history at all. `have` is
// scoped to the block that decides it and the count happens at the end.
bool g_Kept = false;
// Measured change: the frames the blend itself carries, kept apart from the
// trust in the alpha (see the memory block). One with no history.
float g_BlendFrames = 1.0;
// RT-18: whether something in this silhouette's 3x3 moves on its own, which takes
// the silhouette's exemption away (HistoryAt; ObjectMovesAround says why).
bool g_SilhouetteMoving = false;
// RT-15: whether the reflector is curved and moves on its own -- the case neither
// history follows exactly. Chooses between them (main) and marks the texel for the
// young blur (o_Extra.a, kMovingCurvedMark).
bool g_MovingCurved = false;

layout(location = 0) out vec4 o_Accumulated;
layout(location = 1) out vec4 o_Surface;
layout(location = 2) out vec4 o_Extra;
#ifdef RV_SIGNAL_PAIR
layout(location = 3) out vec4 o_Accumulated2;
#elif !defined(RV_SIGNAL_DIFFUSE)
// **RT-5 part 5: the specular variant alone, as the paragraph below always
// said.** The guard was `#else`, so the occlusion and indirect accumulates
// wrote both lanes into targets that have neither, and the validation layer
// reported the unused writes on every draw once it could name the pass.
// **RT-6.1: where the picture at this texel moved, in the scene velocity
// lane's own units.** Not the surface's motion -- the virtual image's, which
// is the whole reason this accumulator reprojects the way it does. The
// temporal resolve reads it so the reflection can be composited *before* it
// and still be reprojected correctly; without it the resolve drags the
// reflection along the floor's motion and the wet ground smears into
// horizontal bands (measured 2026-09-05 and again 2026-09-07).
//
// Only on the specular variant: a diffuse signal moves with its surface, so
// its motion *is* the velocity lane's and a second copy would say nothing.
layout(location = 3) out vec4 o_Motion;
// RT-6.5: the object id under this texel, for the next frame's test.
layout(location = 4) out vec4 o_Ident;
// **RT-15: the moving layer this texel keeps**, for the next frame (see u_HistoryMoving).
// The picture in the first attachment is the sum of both layers, so every reader of it --
// the lit shader, the blur, the composite, the glass pane -- sees one picture as before.
layout(location = 5) out vec4 o_MovingLayer;
#endif

// **RT-15: the least motion, in texels, that counts as motion.** See
// ObjectShift for where the number comes from.
const float kMotionFloor = 0.125;
// How many frames the moments remember: enough to know the grain's
// spread, short enough to forget a light that went out.
const float kMomentFrames = 16.0;
// How many of the pixel's own standard deviations the bound opens to.
const float kTemporalSigma = 2.0;
// **The smear cap (WR-16 R12, 2026-09-06).** A running average of a moving
// picture is motion blur: with the memory only halved per texel of travel
// a frame, a floor texel sliding one texel a frame still averaged 32
// positions -- the smear the owner saw at every camera move. The memory
// may never span more than kSmearTexels of travel (memory <= kSmearTexels
// / moved), down to kMovingMemory frames; the blur after the accumulator
// carries the noise of a short history. Parked, `moved` reads exactly zero
// (measured through the picture view, 2026-09-06), so the cap never bites
// on a still camera; a slow hand dolly moves ~0.3 texel a frame and gets
// ~13 frames, a fast one 1.5 texels and gets the floor.
#define kSmearTexels (u_Reflection.Tuning.x)
// **The silhouette rule's other half (WR-16 R5, 2026-09-06).** The rule
// keeps a silhouette texel's own history across the side flip the jitter
// causes, with the full memory, so the two sides average into the
// coverage. When one side is an object moving on its own with the camera
// still, that history is the other side's picture from where the object
// was: a trail. So at a silhouette the memory is also shortened by the
// fastest motion in the 3x3, the same shape as the `moved` term, down to
// kSilhouetteMemory frames. A jitter-only flip reads zero velocity
// (still geometry reprojects within 1e-5 texel) and keeps everything.
#define kSilhouetteMemory (u_Reflection.Tuning.z)
#define kMovingMemory (u_Reflection.Tuning.y)

float Luma(vec3 c)
{
	return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// **RT-15c: the object-aware history's rule, made hard** (owner, 2026-09-15: "I WANT THE
// OBJECT AWARE TEMPORAL HISTORY TO DO ITS JOB").
//
// A history belongs to the object it was gathered on, and only a texel showing that
// object may use it -- refused outright where the ids differ, never weighed. And everything
// that builds one keeps to its object: the candidates (HistoryAt), the filtered read of the
// texel's own (OwnHistoryPicture) and the bound it is held to (Neighbourhood). Kept that
// way, no stored picture ever holds two objects' light, so the id written beside it is the
// truth about what it holds, and the next frame's test can rely on it.
//
// Before this, a different object's history was only weighed down when it also sat off the
// plane (kIdAgree), a silhouette texel's own history was kept with no test at all, and the
// filter and the bound read across object edges. The chrome cube crossing the car's wing
// showed the result: the cube's texels uncovered beside the wing started from the wing's
// light and faded it out over several frames, one vertical streak per frame of travel.
//
// On the specular instance, whose id lanes are real. A layer that says it has no ids
// (PreviousEye.w two, the sea) is one object, and every texel of it passes.
#if !defined(RV_SIGNAL_PAIR) && !defined(RV_SIGNAL_DIFFUSE)
bool HardObjectIds() { return u_Reflection.PreviousEye.w <= 1.5; }
bool SameObject(float id) { return !HardObjectIds() || abs(id - g_ObjectId) < 0.5; }
#endif

// **RT-6.3: how far the reflection direction may swing before last frame's
// picture stops being this frame's reflection** -- as a cosine, scaled by
// the lobe.
//
// Every other test here asks about the *reflector*: is it the same plane,
// facing the same way, about as rough. On a smooth metal the camera is
// orbiting, all of them pass -- the surface has not changed at all -- and
// the reflection has changed completely, because R = reflect(-V, N) swings
// with the view. The history is accepted and the old image is dragged
// across the metal. That is why smearing is worst on shiny surfaces and
// mild on rough ones, and no amount of surface validation can see it.
//
// A mirror's lobe is a line: cos(1.8 degrees) is the whole of its
// tolerance. A rough surface integrates over most of a hemisphere, so the
// same swing changes almost nothing and its history keeps its memory.
// Smooth rather than a cutoff: a step on a continuous quantity makes the
// memory drop out as the camera turns, which reads as a pop rather than as
// a reflection catching up. These two are the numbers to tune.
const float kMirrorSensitivity = 0.9995;
const float kRoughSensitivity = 0.86;

float DirectionConfidence(vec3 nowDir, vec3 thenDir, float roughness)
{
	const float agree = dot(nowDir, thenDir);
	const float lowest = mix(kMirrorSensitivity, kRoughSensitivity,
							 clamp(roughness, 0.0, 1.0));
	return smoothstep(lowest, mix(lowest, 1.0, 0.5), agree);
}

// The bound on a history: the fresh 3x3's mean and spread, widened. Not the
// outright range -- with a few rays a pixel is often legitimately brighter
// than all eight of its neighbours, and holding it to their range clips the
// average back into the noise every frame (measured on the sea, WR-16 S4c).
void Neighbourhood(ivec2 texel, ivec2 size, out vec3 mean, out vec3 sd)
{
	vec3 sum = vec3(0.0), sum2 = vec3(0.0);
	float n = 0.0;
	for (int y = -1; y <= 1; ++y)
	{
		for (int x = -1; x <= 1; ++x)
		{
			const ivec2 at = clamp(texel + ivec2(x, y), ivec2(0), size - 1);
			const vec4 f = texelFetch(u_Fresh, at, 0);
			if (f.a < 0.0)
				continue;
#if !defined(RV_SIGNAL_PAIR) && !defined(RV_SIGNAL_DIFFUSE)
			// RT-15c: the bound is this object's own light. A neighbour on another object
			// opened it by that object's picture -- at an edge, the other side's history
			// then fitted inside it.
			if (!SameObject(texelFetch(u_SurfaceId, at, 0).r))
				continue;
#endif
			sum += f.rgb;
			sum2 += f.rgb * f.rgb;
			n += 1.0;
		}
	}
	n = max(n, 1.0);
	mean = sum / n;
	sd = sqrt(max(sum2 / n - mean * mean, vec3(0.0)));
}
#ifdef RV_SIGNAL_PAIR
void Neighbourhood2(ivec2 texel, ivec2 size, out vec3 mean, out vec3 sd)
{
	vec3 sum = vec3(0.0), sum2 = vec3(0.0);
	float n = 0.0;
	for (int y = -1; y <= 1; ++y)
	{
		for (int x = -1; x <= 1; ++x)
		{
			const ivec2 at = clamp(texel + ivec2(x, y), ivec2(0), size - 1);
			const vec4 f = texelFetch(u_Fresh2, at, 0);
			if (f.a < 0.0)
				continue;
			sum += f.rgb;
			sum2 += f.rgb * f.rgb;
			n += 1.0;
		}
	}
	n = max(n, 1.0);
	mean = sum / n;
	sd = sqrt(max(sum2 / n - mean * mean, vec3(0.0)));
}
#endif

// **RT-8: and the same surface from a layer that knows where it is.** The
// contract rebuilds P from the depth buffer, which assumes the signal it is
// filtering sits on a surface the depth buffer describes. The sea does not:
// water writes no depth, and the buffer under it holds the seabed and the
// pier, so every test here would have been asking about the wrong surface.
// That, and not the plane test, was what kept the sea out of the contract.
//
// The sea does know its own position -- it writes it in full floats, because
// a bay is a kilometre across -- so the depth binding takes a second meaning
// rather than a second binding: **Probe.w is one when what is bound at the
// depth slot is a position-and-mask lane, xyz the world point and w the mask.**
// That is not a workaround for the sea; it is the more exact of the two, and
// any future layer with a position of its own can take the same route.
// A bitfield, not a flag: a layer describes itself in one number.
bool PositionLane() { return (int(u_Reflection.Probe.w + 0.5) & 1) != 0; }
bool UpNormalLane() { return (int(u_Reflection.Probe.w + 0.5) & 2) != 0; }

// **RT-8: how this layer encodes a normal.** Octahedral for the G-buffer, and
// two horizontal components with the vertical recovered for the sea -- whose
// normal always points up, so nothing is lost and nothing is quantised. That
// is the better encoding for a sea and a different one from the rest of the
// frame, and reading one as the other is silent: the lobe simply points
// somewhere it should not. Measured when it was: the sea's mid-tones a seventh
// dimmer and its highlight a third narrower.
vec3 DecodeSurfaceNormal(vec2 e)
{
	if (UpNormalLane())
		return vec3(e.x, sqrt(max(1.0 - dot(e, e), 0.0)), e.y);
	return OctDecode(e);
}

// A texel of the scene back to the world: its point and its normal. False
// where there is no surface. The row is a projected coordinate the other
// way up on the backend whose rows run down; clip z is the depth as written.
bool SurfaceAt(ivec2 texel, ivec2 size, out vec3 P, out vec3 N)
{
	const vec4 surface = texelFetch(u_Surface, texel, 0);
	const vec4 depthLane = texelFetch(u_Depth, texel, 0);
	if (PositionLane())
	{
		// The layer's own point, and its mask where the depth test would be.
		if (surface.b <= 0.0 || depthLane.w <= 0.5)
			return false;
		P = depthLane.xyz;
		N = DecodeSurfaceNormal(surface.rg);
		return true;
	}
	const float depth = depthLane.r;
	if (surface.b <= 0.0 || depth >= 1.0)
		return false;
	const vec2 uv = (vec2(texel) + 0.5) / vec2(size);
	const float row = u_Reflection.History.w > 0.5 ? 1.0 - uv.y : uv.y;
	const vec4 clip = u_Reflection.InverseViewProjection
					* vec4(uv.x * 2.0 - 1.0, row * 2.0 - 1.0, depth, 1.0);
	P = clip.xyz / clip.w;
	N = DecodeSurfaceNormal(surface.rg);
	return true;
}

// How sharply the reflector bends here, per metre: the normal's change over
// the distance it changes across, along whichever screen axis bends most.
// One-sided, taking the neighbour that is nearer in the world, so a pole's
// edge measures the pole and not the jump to the wall behind it. Two texels
// out rather than one: the normals are half floats, and their quantisation
// over a texel's worth of floor read as a metre-scale curve on a plane.
float Curvature(ivec2 texel, ivec2 size, vec3 P, vec3 N)
{
	float k = 0.0;
	for (int axis = 0; axis < 2; ++axis)
	{
		const ivec2 step = axis == 0 ? ivec2(2, 0) : ivec2(0, 2);
		vec3 Pa, Na, Pb, Nb;
		const bool a = SurfaceAt(clamp(texel + step, ivec2(0), size - 1), size, Pa, Na);
		const bool b = SurfaceAt(clamp(texel - step, ivec2(0), size - 1), size, Pb, Nb);
		const float da = a ? length(Pa - P) : 1.0e9;
		const float db = b ? length(Pb - P) : 1.0e9;
		if (!a && !b)
			continue;
		const vec3 dN = da <= db ? Na - N : Nb - N;
		const float dP = min(da, db);
		k = max(k, length(dN) / max(dP, 1.0e-4));
	}
	// A plane reads a little curvature from the normals' quantisation; a
	// radius over some metres is a plane for this purpose.
	return max(k - 0.15, 0.0);
}

// A history the tests let through, and where it was found.
struct Candidate
{
	vec4 past;        // the picture, bilinear
	vec4 reflector;   // the second attachment at the texel: normal, plane, image distance
	vec4 extra;       // the third: roughness, moments, choice
	vec2 pastUv;
	vec2 thenNdc;
	ivec2 pastTexel;  // the texel the candidate came from (RV_SIGNAL_PAIR reads its twin there)
	bool  bilinear;   // whether the picture was sampled at pastUv rather than fetched
	// **RT-6.4: how well it matched, not just that it did.** One where the
	// reflector is the same to well inside the tolerances, falling to zero at
	// their edge. The tests below stay binary because the neighbour search
	// needs a yes or a no; this is how much the winner is then trusted.
	float matchConfidence;
};

// Where a world point sat in last frame's picture, and whether the picture
// there is this reflector's. `pastUv` is in the history's texel space and
// `thenNdc` the jittered projected coordinate the motion is measured from.
// Whether a 3x3 neighbour lies on another surface: a silhouette texel,
// whose own surface flips sides with the jitter every frame. Also the
// fastest motion in that 3x3, in texels a frame, from the velocity
// attachment -- whichever side is moving.
bool AtSilhouette(ivec2 texel, ivec2 size, vec3 P, vec3 N, float eyeDistance, out float neighbourMotion)
{
	bool silhouette = false;
	neighbourMotion = 0.0;
	for (int y = -1; y <= 1; ++y)
		for (int x = -1; x <= 1; ++x)
		{
			const ivec2 at = clamp(texel + ivec2(x, y), ivec2(0), size - 1);
			neighbourMotion = max(neighbourMotion, length(texelFetch(u_Velocity, at, 0).xy * 0.5 * vec2(size)));
			if (x == 0 && y == 0)
				continue;
			vec3 Pn, Nn;
			if (!SurfaceAt(at, size, Pn, Nn))
			{
				silhouette = true;
				continue;
			}
			if (dot(N, Nn) < 0.8 || abs(dot(N, Pn - P)) > 0.05 + 0.01 * eyeDistance)
				silhouette = true;
		}
	return silhouette;
}

// **RT-6.5: how much a history is worth when the material underneath it
// changed.** A metal and a dielectric at the same roughness pass every
// other test this accumulator has and shade nothing alike -- one is a
// mirror of the room, the other is mostly its own albedo.
//
// Scaled, not refused, for RT-6.3's reason: refusing trades a smear for the
// noise of a one-frame estimate, on exactly the surfaces that show noise
// worst. A sixth of the memory is short enough that the fresh rays take
// over within a few frames and long enough that they are not read alone.
const float kMaterialAgree = 0.15;

// **RT-6.5: and how much a history from a *different object* is worth.**
//
// Not a flat penalty, because whether the id matters depends on how
// marginal the plane test was. Two different objects that are genuinely
// coplanar, facing the same way and of the same material reflect the
// same image -- refusing there would throw away a correct history. Two
// different objects out at the edge of the plane tolerance are up to a
// quarter of a metre apart at twenty metres and reflect *different*
// images, and that is the case no other test here can see.
//
// So the penalty follows the plane residual: none when the candidate is
// well inside the tolerance, most of it at the edge.
const float kIdAgree = 0.25;

// **RT-6.10: how far the reflected picture may move before the history
// stops describing it**, as a fraction of the distance itself.
//
// A mirror sends one ray to one place: its hit distance is steady frame to
// frame, so a change of a few per cent means the *scene* changed -- an
// object moved in the reflection, which is the case no reflector test can
// see. A rough surface samples a wide lobe and its hit distance swings
// wildly between frames for no reason but the sampling, so the same test
// there would refuse history for noise. Hence the two ends, and the
// interpolation between them.
const float kMirrorHitTolerance = 0.05;
const float kRoughHitTolerance = 1.50;

// One where the reflected picture is where it was, falling to a floor as it
// moves. Smooth for RT-6.4's reason: a cutoff on a continuous quantity makes
// the memory step out as something crosses the reflection, which reads as a
// pop rather than as a reflection catching up.
const float kHitAgree = 0.2;

// **RT-17: and has what the ray hits been replaced?** RT-6.10 asks how far the
// ray went, which misses the case its own record names: something crossing the
// reflection at about the distance the ray already travelled. Two questions,
// both about what the history showed against what this frame's rays show:
// whether the object is another one, and -- the same object -- whether the face
// the ray lands on has turned. A mirror's ray lands on one thing, so the test is
// whole there and gone by roughness 0.3, where a lobe's rays land on many things
// every frame for no reason but the sampling.
//
// **Only where something that moved is involved** -- the object the history's ray
// struck, or one this frame's rays around the texel strike. Built first without it,
// the test fired on 9% of a parked garage: a glossy floor's ray lands on a tube
// one frame and on the ceiling the next, for no reason but its sampling, and an
// average over a still room is right however many objects it is made of. A
// ghost needs something to have moved.
//
// **Against the fresh 3x3, not the texel alone.** Under the jitter a texel that
// sits on a reflected edge sees the object one frame and what is behind it the
// next; asking only the centre would call that a change and shorten every
// reflected edge's memory. What the history showed counts as still there if any
// ray in the 3x3 still lands on it -- so only a change wider than a texel is one.
//
// Scaled, not refused, for RT-6.3's reason; the floor is how much of a history
// a texel keeps when what it shows has been replaced.
const float kHitIdentityAgree = 0.2;
// The cosine under which the struck face has turned: twenty-five degrees, well
// above the six the packing quantises to.
const float kHitNormalAgree = 0.9;

// The lane's green: the normal in the low ten bits, 1024 above them where the
// struck instance moved this frame.
bool StruckMoving(float packed) { return packed >= 1023.5; }

vec3 UnpackStruckNormal(float packed)
{
	const float bits = packed - (StruckMoving(packed) ? 1024.0 : 0.0);
	const float u = floor(bits / 32.0);
	return OctDecode(vec2(u, bits - u * 32.0) / 31.0);
}

#if !defined(RV_SIGNAL_PAIR) && !defined(RV_SIGNAL_DIFFUSE)
float IdentityConfidence(ivec2 texel, ivec2 size, vec2 was, float roughness)
{
	if (u_Reflection.Change.y < 0.5)
		return 1.0;
	const float sensitivity = 1.0 - smoothstep(0.05, 0.3, roughness);
	if (sensitivity <= 0.0)
		return 1.0;
	const vec3 wasNormal = was.x > 0.5 ? UnpackStruckNormal(was.y) : vec3(0.0);
	// The texel's own ray first: still the same thing is the usual answer.
	{
		const vec2 own = texelFetch(u_FreshIdentity, texel, 0).rg;
		if (abs(own.x - was.x) <= 0.5
			&& (was.x < 0.5 || dot(UnpackStruckNormal(own.y), wasNormal) >= kHitNormalAgree))
			return 1.0;
	}
	bool moving = was.x > 0.5 && StruckMoving(was.y);
	for (int y = -1; y <= 1; ++y)
	{
		for (int x = -1; x <= 1; ++x)
		{
			const vec2 now = texelFetch(u_FreshIdentity, clamp(texel + ivec2(x, y), ivec2(0), size - 1), 0).rg;
			moving = moving || (now.x > 0.5 && StruckMoving(now.y));
			if (abs(now.x - was.x) > 0.5)
				continue;
			// A miss matches a miss; the sky has no face to turn.
			if (was.x < 0.5 || dot(UnpackStruckNormal(now.y), wasNormal) >= kHitNormalAgree)
				return 1.0;
		}
	}
	return moving ? mix(1.0, kHitIdentityAgree, sensitivity) : 1.0;
}

// **RT-15: two layers, because one colour cannot move two ways.** A glossy texel's picture
// is its lobe: the still room where the rays land on it, and whatever moved where they land
// on that. As one stored colour the two could only be reprojected together, and neither way
// is right: kept in place, a moving object's old reflection stays behind as a ghost; carried
// along with the object (Zeng et al. 2021's glossy reflection motion vector, tried first),
// the still reflection around it is dragged too -- measured smearing the floor's light
// ripples sideways under the chrome cube and sphere, worse there than averaging nothing. So
// the resolve splits the picture by what each ray struck, and this pass keeps the moving
// part in a layer of its own (the sixth attachment): the still layer is reprojected exactly
// as before, the moving layer follows what its rays struck, and the picture written is
// their sum. Where nothing moved the moving layer is zero and every line below reduces to
// the one-layer pass, bit for bit.
bool MovingLayerLive() { return u_Reflection.Change.z > 0.5; }

// How far the moving things this texel's 3x3 struck travelled: their mean, the still hits
// and the misses left out -- the moving layer is only their light, so it follows them whole.
vec3 MoverTravel(ivec2 texel, ivec2 size)
{
	vec3 sum = vec3(0.0);
	float movers = 0.0;
	for (int y = -1; y <= 1; ++y)
	{
		for (int x = -1; x <= 1; ++x)
		{
			const vec3 t = texelFetch(u_FreshTravel, clamp(texel + ivec2(x, y), ivec2(0), size - 1), 0).rgb;
			if (dot(t, t) > 0.0)
			{
				sum += t;
				movers += 1.0;
			}
		}
	}
	return movers > 0.0 ? sum / movers : vec3(0.0);
}

// The fresh 3x3's mean and spread for each layer, where Neighbourhood gives them for the
// whole picture: the still layer is bounded by the still part, the moving by the moving.
void NeighbourhoodLayers(ivec2 texel, ivec2 size, out vec3 meanStill, out vec3 sdStill,
						 out vec3 meanMoving, out vec3 sdMoving)
{
	vec3 sum = vec3(0.0), sum2 = vec3(0.0), msum = vec3(0.0), msum2 = vec3(0.0);
	float n = 0.0;
	for (int y = -1; y <= 1; ++y)
	{
		for (int x = -1; x <= 1; ++x)
		{
			const ivec2 at = clamp(texel + ivec2(x, y), ivec2(0), size - 1);
			const vec4 f = texelFetch(u_Fresh, at, 0);
			if (f.a < 0.0)
				continue;
			// RT-15c: this object's light alone, as Neighbourhood keeps it.
			if (!SameObject(texelFetch(u_SurfaceId, at, 0).r))
				continue;
			const vec3 m = clamp(texelFetch(u_FreshMoving, at, 0).rgb, vec3(0.0), max(f.rgb, vec3(0.0)));
			const vec3 s = max(f.rgb - m, vec3(0.0));
			sum += s;
			sum2 += s * s;
			msum += m;
			msum2 += m * m;
			n += 1.0;
		}
	}
	n = max(n, 1.0);
	meanStill = sum / n;
	sdStill = sqrt(max(sum2 / n - meanStill * meanStill, vec3(0.0)));
	meanMoving = msum / n;
	sdMoving = sqrt(max(msum2 / n - meanMoving * meanMoving, vec3(0.0)));
}

// The moving layer kept where a candidate was found, read the way its picture was.
vec4 PastMovingAt(Candidate c)
{
	return c.bilinear ? texture(u_HistoryMoving, c.pastUv) : texelFetch(u_HistoryMoving, c.pastTexel, 0);
}
#endif

// **RT-15: the curvature past which a moving reflector's histories are both
// approximate**, per metre, as Curvature returns it (past its plane allowance). The
// image history carries a flat mirror's reflection exactly under any motion
// (ImageThen); on a curve the image sits at a distance that changes across the
// surface and with the motion, and the car's body and the chrome sphere both measured
// their image history misplaced -- averaging nothing was nearer the settled picture.
const float kCurvedMover = 0.2;
// How much nearer the fresh neighbourhood the surface's history must sit than the
// image's, in the neighbourhood's own spreads, before a curved mover takes it: clearly
// nearer, so a tie stays with the image, which is right more often (measured 0.7
// against always and against 0.5, 2026-09-15).
const float kSurfaceNearer = 0.7;
// Added to o_Extra.a where g_MovingCurved: reflection_blur's mark. Above the
// choice-and-refusal code (0..6.5), which the debug view reads below it.
const float kMovingCurvedMark = 8.0;

// A displacement mirrored through a plane with this normal.
vec3 MirrorVector(vec3 v, vec3 N)
{
	return v - 2.0 * dot(N, v) * N;
}

float HitConfidence(float nowImage, float wasImage, float roughness)
{
	// Relative, not absolute: a metre of change matters on a reflection two
	// metres deep and not on one forty metres deep. The floor in the divisor
	// keeps a reflection sitting on the surface from dividing by nothing.
	const float moved = abs(nowImage - wasImage)
					  / max(max(nowImage, wasImage), 0.25);
	const float tolerance = mix(kMirrorHitTolerance, kRoughHitTolerance,
								clamp(roughness, 0.0, 1.0));
	return mix(1.0, kHitAgree, smoothstep(tolerance, tolerance * 3.0, moved));
}

// **The roughness channel carries the metallic in its integer part.**
// Roughness is in [0,1] and the whole integer part of `o_Extra.r` was
// unused; a half float at magnitude two still resolves about 0.002, which
// is far finer than a test whose tolerance is 0.5. The alternative was a
// fifth attachment on a contract four signals share, a week before RT-14
// measures whether the lanes already there are affordable.
float PackMaterial(float roughness, float metallic)
{
	return clamp(roughness, 0.0, 1.0) + (metallic >= 0.5 ? 2.0 : 0.0);
}

bool  UnpackMetal(float packed)     { return packed >= 1.5; }
float UnpackRoughness(float packed) { return packed - (packed >= 1.5 ? 2.0 : 0.0); }

// **RT-15: how far this pixel surface moved on its own**, in the same
// projected coordinate the history is addressed in.
//
// PreviousViewProjection asks where a world point would have been last
// frame *if it had not moved*. For anything that did move that is the wrong
// place: with the camera standing still it names this very texel, where the
// wall behind the object was, so every test refuses, frames falls to one
// and a near-mirror pixel shows a single ray. The scene velocity lane holds
// the right answer -- the rasteriser writes it through PreviousModel, so
// object motion is in it -- and this pass has had it bound at binding 6 all
// along for the silhouette rule, which only ever took its length.
//
// **Returned as the difference between the two answers, not as the answer**,
// so a surface that did not move contributes nothing and the tuning measured
// on still scenes is untouched. Measured on the parked garage: zero for 95%
// of the frame and below a sixtieth of a texel elsewhere -- except on the
// on-screen UI strip, whose shaders write o_Velocity = 0 unconditionally
// (ui_world.rvshader and its siblings) so that the lane and the matrix
// disagree by up to 3.9 texels there. Hence the first line: a pixel the
// renderer reports as not having moved has not moved, and gets no
// correction. That also covers the sky, the grid and the particles.
vec2 ObjectShift(ivec2 texel, vec3 P, vec2 nowNdc)
{
	const vec2 velocity = texelFetch(u_Velocity, texel, 0).xy;
	if (dot(velocity, velocity) <= 0.0)
		return vec2(0.0);
	const vec4 clipThen = u_Reflection.PreviousViewProjection * vec4(P, 1.0);
	if (clipThen.w <= 0.0)
		return vec2(0.0);
	const vec2 byCamera = clipThen.xy / clipThen.w - u_Scene.Jitter.zw;
	const vec2 byMotion = (nowNdc - u_Scene.Jitter.xy) - 2.0 * velocity;
	const vec2 shift = byMotion - byCamera;
	// **Below the floor there is no motion, only two ways of computing
	// the same answer.** The lane is an interpolated clip position and
	// the matrix arm a rebuilt depth, each with its frame jitter taken
	// out afterwards, so on a surface standing perfectly still they agree
	// to rounding rather than to the bit. Measured on the parked garage:
	// zero texels for 95% of the frame and nothing above a sixtieth of a
	// texel on real geometry, against 2.994 texels on the moving panel.
	// An eighth of a texel sits between them with three orders of
	// magnitude to spare, and returning exactly zero below it is what
	// keeps a scene with nothing moving in it bit-identical -- which is
	// also the test that says so.
	const vec2 texelNdc = 2.0 / vec2(textureSize(u_Velocity, 0));
	if (length(shift / texelNdc) < kMotionFloor)
		return vec2(0.0);
	return shift;
}

// **RT-18: history cannot outlive the silhouette it belongs to.**
//
// A silhouette texel keeps its own history with no test at all (HistoryAt), so
// that a parked edge whose side flips with the jitter averages into its coverage
// instead of shaking. That history is the picture of whichever side the texel
// showed last frame. While the object moves, it is the *other* side's picture
// and the edge's highlight -- and one frame later the texel is inside the object,
// where that history passes every test and stays. So the moving chrome cube kept
// a column of its own edge behind every frame, and its face filled with bright
// vertical stripes (owner, 2026-09-15: "the moment the cube moves the entire
// reflection on it falls apart"); the car left a grainy trail behind its rear.
// Measured with the averaging switched off, the cube's face is dark and clean.
//
// **Only objects moving on their own count**, the question ObjectShift answers on
// each neighbour. A camera move alone keeps the exemption: both sides of a still
// edge reproject consistently, and the dolly renders identical to before this
// (measured). Reading any motion instead -- the velocity lane's length -- changed
// 3% of the dolly's pixels, by up to 241 levels, for nothing the dolly needed.
bool ObjectMovesAround(ivec2 texel, ivec2 size)
{
	for (int y = -1; y <= 1; ++y)
	{
		for (int x = -1; x <= 1; ++x)
		{
			const ivec2 at = clamp(texel + ivec2(x, y), ivec2(0), size - 1);
			// The velocity lane first: zero wherever nothing moved, which is every
			// texel of a still scene, and the surface is not rebuilt for those.
			const vec2 velocity = texelFetch(u_Velocity, at, 0).xy;
			if (dot(velocity, velocity) <= 0.0)
				continue;
			vec3 Pn, Nn;
			if (!SurfaceAt(at, size, Pn, Nn))
				continue;
			const vec2 uvAt = (vec2(at) + 0.5) / vec2(size);
			const float rowAt = u_Reflection.History.w > 0.5 ? 1.0 - uvAt.y : uvAt.y;
			const vec2 shift = ObjectShift(at, Pn, vec2(uvAt.x * 2.0 - 1.0, rowAt * 2.0 - 1.0));
			if (dot(shift, shift) > 0.0)
				return true;
		}
	}
	return false;
}

// **RT-15: and where the picture behind the surface stood last frame.**
//
// The reflection is not painted on the reflector, so it does not travel
// with it. What is seen stands as far behind the plane as the thing itself
// stands in front, which gives two cases and no others: a face sliding
// along its own plane leaves the image exactly where it was, and a face
// moving along its normal by d moves the image by **2d** -- once because
// the plane carried it, and once because the gap behind has to match the
// gap in front, which just grew by d. Shifting the image by the surface
// own motion, which is what the velocity lane alone would say, is wrong in
// both: too far in the first, half as far in the second.
//
// Both numbers are already written every frame for the history tests -- the
// reflector normal and its plane, in the second attachment -- so the
// general case, a reflector that also **turns**, costs two reflections and
// no memory: mirror the image back through this frame plane to recover the
// point the ray sees, then mirror that through last frame one.
//
// **Only ever called with the texel own history** (see the call site): on a
// neighbour the search reached, the stored plane belongs to a different
// point of the surface and the residual is its shape, not its travel.
//
// **RT-15: and the seen point may have moved too** -- `seenTravel`, how far what the
// ray sees travelled, already shrunk as its image is. Taken off the seen point before
// it is mirrored through last frame's plane; zero, and nothing changes.
vec3 ImageThen(vec3 P, vec3 N, vec3 sight, float image, Candidate atSurface, vec3 seenTravel)
{
	const vec3 I = P + sight * image;
	const vec3 wasN = DecodeSurfaceNormal(atSurface.reflector.rg);
	// It did not turn: the shift is along the normal, and is exactly zero
	// where the plane did not move, so a still reflector returns the image
	// it had bit for bit.
	if (dot(wasN, N) > 0.9999)
		return I - 2.0 * (dot(N, P) - atSurface.reflector.b) * N - MirrorVector(seenTravel, N);
	const vec3 seen = I - 2.0 * (dot(N, I) - dot(N, P)) * N - seenTravel;
	return seen - 2.0 * (dot(wasN, seen) - atSurface.reflector.b) * wasN;
}

// **RT-8: the memory a pixel is allowed, given a base and how it moved.**
//
// Lifted out of main so a pair's two halves can each be put through it with
// their own base. Every step is a property of the pixel rather than of the
// payload: how far the picture travelled since last frame, whether the average
// would span more than the smear cap allows, and whether the texel sits on a
// silhouette whose other side moves. The floor is the caller's `fewest`.
//
// Bit-identical to the chain it replaces when called with History.y, which is
// what the first half calls it with.
float ShortenedMemory(float base, float moved, float slack, float fewest,
					  bool silhouette, float neighbourMotion)
{
	float memory = base / (1.0 + moved / slack);
	memory = min(memory, max(kSmearTexels / max(moved, 1.0e-3), kMovingMemory));
	if (silhouette)
		memory = min(memory, max(base / (1.0 + neighbourMotion / slack), kSilhouetteMemory));
	return max(memory, fewest);
}

// **RT-15c: the texel's own history, filtered only within its object.** The bilinear read
// at the reprojected point is right on a surface and wrong across an edge, where up to three
// of its four texels are the other object's picture -- a quarter of the wing's light at a
// time on the cube beside it, in a texel whose id says cube. Where any of the four belongs
// to another object the texel under the point is read alone; it has already passed the id
// test (HistoryAt).
vec4 OwnHistoryPicture(vec2 pastUv, ivec2 pastTexel, ivec2 size)
{
#if !defined(RV_SIGNAL_PAIR) && !defined(RV_SIGNAL_DIFFUSE)
	if (HardObjectIds())
	{
		const ivec2 base = ivec2(floor(pastUv * vec2(size) - 0.5));
		for (int i = 0; i < 4; ++i)
		{
			const ivec2 at = clamp(base + ivec2(i & 1, i >> 1), ivec2(0), size - 1);
			if (!SameObject(texelFetch(u_HistoryIdent, at, 0).r))
				return texelFetch(u_History, pastTexel, 0);
		}
	}
#endif
	return texture(u_History, pastUv);
}

bool HistoryAt(vec3 world, ivec2 size, vec3 P, vec3 N, float roughness,
			   float eyeDistance, bool silhouette, vec2 objectShift,
			   out Candidate c)
{
	const vec4 clipThen = u_Reflection.PreviousViewProjection * vec4(world, 1.0);
	if (clipThen.w <= 0.0)
		return false;
	// **The picture lives on the unjittered grid.** The matrix carries last
	// frame's jitter, as the rasteriser drew with it; taken back out, the
	// point lands where it sits in a picture whose texels mean the pixel
	// centres, not this frame's dithered sample of them. That is the
	// temporal resolve's own structure: the fresh estimate arrives at the
	// jittered position and is one part in twenty-four, the history is kept
	// on the fixed grid and is the rest, and what accumulates is the average
	// over the dither -- a stable, anti-aliased picture the composite can
	// add at the pixel. Kept on the jittered grid instead, the picture
	// wobbled by the jitter on top of the resolved frame (9 levels of
	// frame-to-frame change parked; resampled back by the jitter, still 5);
	// and the first version added the jitter again on top of the matrix's
	// and read every history up to a pixel from itself, parked (13 frames of
	// memory where 24 stood).
	// **RT-15: plus what the matrix cannot see.** The projection above is
	// the camera answer alone; objectShift carries the surface own motion,
	// and is exactly zero wherever the scene says nothing moved.
	c.thenNdc = clipThen.xy / clipThen.w - u_Scene.Jitter.zw + objectShift;
	const vec2 thenUv = c.thenNdc * 0.5 + 0.5;
	if (any(lessThan(thenUv, vec2(0.0))) || any(greaterThan(thenUv, vec2(1.0))))
	{
		g_Refusal = 1;
		return false;
	}
	const float thenRow = u_Reflection.History.w > 0.5 ? 1.0 - thenUv.y : thenUv.y;
	c.pastUv = clamp(vec2(thenUv.x, thenRow), vec2(0.0), vec2(1.0));

	// The reflector that was there. Fetched, not sampled: a plane is not a
	// thing to interpolate across a silhouette.
	// The texel under the reprojection first, then its eight neighbours
	// (SVGF's search). Under jitter an edge texel's surface flips sides
	// every frame, and refusing the history there left every silhouette one
	// frame old and shaking: parked, bright edges moved 8.1 levels a frame
	// against 3.3 with the reflections off (2026-09-06). The neighbour that
	// kept this surface's picture holds the same picture, a texel over.
	const ivec2 centre = clamp(ivec2(c.pastUv * vec2(size)), ivec2(0), size - 1);
	const ivec2 offsets[9] = ivec2[9](ivec2(0, 0), ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1),
									  ivec2(1, 1), ivec2(-1, -1), ivec2(1, -1), ivec2(-1, 1));
	for (int k = 0; k < 9; ++k)
	{
		const ivec2 pastTexel = clamp(centre + offsets[k], ivec2(0), size - 1);
		c.reflector = texelFetch(u_HistorySurface, pastTexel, 0);
		if (c.reflector.a < 0.0)
		{
			if (k == 0) g_Refusal = 2;
			continue;
		}
		c.extra = texelFetch(u_HistoryExtra, pastTexel, 0);
#if !defined(RV_SIGNAL_PAIR) && !defined(RV_SIGNAL_DIFFUSE)
		// **RT-15c: another object's history is never this one's.** First, before any test
		// that weighs a candidate, and before the silhouette rule below -- so that rule keeps
		// a texel's own history across the jitter's side flip only where both sides are the
		// same object. Where they are two, the side the texel shows this frame takes its own
		// object's history from the neighbour that kept it, and the edge's coverage is left to
		// the temporal resolve, as every other edge in the frame is.
		if (!SameObject(texelFetch(u_HistoryIdent, pastTexel, 0).r))
		{
			if (k == 0) g_Refusal = 6;
			continue;
		}
#endif
		// At a silhouette the texel's own history is kept whichever side it
		// showed last frame: under jitter the side flips every frame, and a
		// history refused there was one frame old and shook (2026-09-06,
		// parked bright edges 7.5 levels a frame against 0.9 with no
		// reflections). Averaged across the flip it is the coverage-weighted
		// picture, which is what TAA's colour is at the same texel. The
		// bound below still holds it to this frame's neighbourhood.
		// **RT-15c: on the specular instance, only across one object's own edge** (the id
		// test above has already refused the other object's side).
		// **RT-18: not where something moves on its own** -- there that history
		// is the other side's, and it stays behind (ObjectMovesAround).
		c.matchConfidence = 1.0;
		if (!(silhouette && k == 0 && !g_SilhouetteMoving))
		{
			const vec3 wasN = DecodeSurfaceNormal(c.reflector.rg);
			const float facing = dot(wasN, N);
			if (facing < 0.8)
			{
				if (k == 0) g_Refusal = 3;
				continue;
			}
			const float planeTolerance = 0.05 + 0.01 * eyeDistance;
			const float offPlane = abs(dot(wasN, P) - c.reflector.b);
			// **RT-15: on the same moving object, this residual IS the motion.**
			// The test asks whether the surface is still in the plane it was in,
			// which is the right question for a scene that does not move and the
			// wrong one for a car driving along its own normal. Three conditions,
			// and all three are needed: the pixel actually moved (objectShift is
			// zero wherever the renderer says nothing did), the history is the
			// texel own rather than a neighbour the search reached (a neighbour
			// plane is a different point of the surface, so its residual is shape
			// and not travel), and the object id matches exactly.
			const float wasId = texelFetch(u_HistoryIdent, pastTexel, 0).r;
			// RT-8: on a layer with no ids the id half of this is vacuously
			// true -- there is one object, so the history is always its own.
			const bool sameMover = dot(objectShift, objectShift) > 0.0 && k == 0
				  && (u_Reflection.PreviousEye.w > 1.5 || abs(wasId - g_ObjectId) < 0.5);
			if (offPlane > planeTolerance && !sameMover)
			{
				if (k == 0) g_Refusal = 4;
				continue;
			}
			// RT-6.5: the same cutoff, on the roughness unpacked from beside the
			// metallic. Unchanged in behaviour -- what is new is the bit above it.
			if (abs(UnpackRoughness(c.extra.r) - roughness) > 0.5)
			{
				if (k == 0) g_Refusal = 5;
				continue;
			}
			// **RT-6.4: and how well, not merely whether.** A history is whole at
			// dot 0.801 and gone at 0.799 with a cutoff, and nothing in a picture
			// changes that sharply -- what the eye sees as the camera turns is the
			// memory stepping out rather than a reflection catching up. Full trust
			// well inside each tolerance, falling to none at its edge.
			//
			// **RT-6.5: and by whether it is even the same kind of surface.** The
			// one axis nothing here has ever tested: a metal/dielectric boundary
			// passes the normal, the plane and the roughness, and the two sides
			// reflect nothing alike. Multiplied in like the rest, so a candidate
			// marginal on two counts is worth less than one marginal on either.
			const float material = UnpackMetal(c.extra.r) == (g_Metallic >= 0.5)
								 ? 1.0 : kMaterialAgree;
			// **RT-6.5's fourth check: is it the same object?** Weighted by how
			// far out the plane test was -- see kIdAgree. A coplanar neighbour
			// of another object is reflecting what this one reflects and keeps
			// its history; one near the tolerance's edge is at a different
			// depth and does not.
			// **RT-6.10: and has what the ray hits moved?** The one question the
			// reflector tests cannot ask -- a static mirror, a static camera and a
			// moving object in the reflection pass every one of them.
			const float hit = HitConfidence(g_FreshImage, c.reflector.a, roughness);
#if !defined(RV_SIGNAL_PAIR) && !defined(RV_SIGNAL_DIFFUSE)
			// RT-17: and is it still the same thing the ray lands on?
			const float identity = IdentityConfidence(ivec2(gl_FragCoord.xy), size,
													  texelFetch(u_HistoryIdent, pastTexel, 0).ba, roughness);
#else
			const float identity = 1.0;
#endif
			// **RT-8: a layer with no object ids does not get an id test.** The
			// sea is one surface and its layer carries no id lane, so the test
			// would be comparing this frame's packed normal against last
			// frame's -- which on a turning wave differs every frame and would
			// shorten the memory for a reason that is not there. The engine
			// says so in PreviousEye.w: zero no eye, one an eye, two an eye on
			// a layer with no ids. Read as `> 1.5`, so the direction test's
			// `> 0.5` above is untouched.
			const bool noIds = u_Reflection.PreviousEye.w > 1.5;
			// RT-15c: on the specular instance a candidate of another object never gets
			// here (refused at the top of the search), so this weight is one there.
			const float idPenalty =
				(noIds || abs(wasId - g_ObjectId) < 0.5)
					? 1.0
					: mix(1.0, kIdAgree,
						  smoothstep(0.2, 1.0, offPlane / max(planeTolerance, 1.0e-5)));
			// RT-15: and neither does the confidence, on the same three counts --
			// a moving object scored by the plane residual would keep its history
			// and then be trusted with none of it, which is the same defect one
			// step further down.
			const float planeAgree = sameMover ? 1.0
							  : (1.0 - smoothstep(0.35 * planeTolerance, planeTolerance,
												  offPlane));
			c.matchConfidence = smoothstep(0.8, 0.94, facing)
							  * planeAgree
							  * material * idPenalty * hit * identity;
		}
		// Bilinear where the texel itself matched; the neighbour's own value
		// where it did not, since the texels between belong to the other side.
		// RT-15c: and the filter kept to this object (OwnHistoryPicture).
		c.past = k == 0 ? OwnHistoryPicture(c.pastUv, pastTexel, size) : texelFetch(u_History, pastTexel, 0);
		c.pastTexel = pastTexel;
		c.bilinear = k == 0;
		if (c.past.a > 0.0)
			return true;
	}
	return false;
}

#if defined(RV_RAY_COUNTERS)
// **RT-19: how often this pass keeps a history, and what refuses the rest.**
//
// The reason has been written to `o_Extra.a` since RT-12 and read by one
// debug view; nothing ever counted it. On the specular instance only --
// this shader also runs for the occlusion, the bounce and the direct
// light, and one set of lanes summed over four signals would describe
// none of them. The counter block and the slot function come from
// pbr_fragment.glsl, which this shader already includes, and the buffer
// is already bound to this pass at set 0 binding 21 with the lamp set.
//
// Pixels that had nothing glossy in them return before this and are not
// counted, so the denominator is the pixels that had a temporal decision
// to make.
const uint RAY_LANE_REFL_PIXELS  = 19u;
const uint RAY_LANE_REFL_KEPT    = 20u;
const uint RAY_LANE_REFL_REFUSED = 21u;   // and the four after it
const uint RAY_LANE_REFL_FRAMES  = 26u;

// **RT-8: and the sea's own set, for slot 4.** Not because the sea deserves
// special treatment, but because summing five signals into one set of lanes
// describes none of them -- which is the same reason the reflections were
// split off the temporal resolve's in RT-19.
const uint RAY_LANE_WATER_SIGNAL_PIXELS  = 37u;
const uint RAY_LANE_WATER_SIGNAL_KEPT    = 38u;
const uint RAY_LANE_WATER_SIGNAL_REFUSED = 39u;   // and the four after it
const uint RAY_LANE_WATER_SIGNAL_FRAMES  = 44u;
const uint RAY_LANE_WATER_SIGNAL_TWIN    = 45u;

// Which signal is running: the slot the engine put in Probe.z. Zero is the
// reflections, four and five the sea; everything else counts nothing, because
// a shared set of lanes is worse than none -- the glass layer's six and seven
// (RT-13) included.
bool CountsAsReflection() { return u_Reflection.Probe.z < 0.5; }
bool CountsAsWater()      { return u_Reflection.Probe.z > 3.5 && u_Reflection.Probe.z < 5.5; }

void CountSignal(bool kept, int refusal, float frames, float twin)
{
#ifdef RV_SIGNAL_DIFFUSE
	// The diffuse instances are the occlusion, the bounce, the direct light
	// and the sea. Only the sea has lanes.
	if (!CountsAsWater())
		return;
#else
	if (!CountsAsReflection())
		return;
#endif
	const uint lanePixels  = CountsAsWater() ? RAY_LANE_WATER_SIGNAL_PIXELS  : RAY_LANE_REFL_PIXELS;
	const uint laneKept    = CountsAsWater() ? RAY_LANE_WATER_SIGNAL_KEPT    : RAY_LANE_REFL_KEPT;
	const uint laneRefused = CountsAsWater() ? RAY_LANE_WATER_SIGNAL_REFUSED : RAY_LANE_REFL_REFUSED;
	const uint laneFrames  = CountsAsWater() ? RAY_LANE_WATER_SIGNAL_FRAMES  : RAY_LANE_REFL_FRAMES;
	const bool real = !gl_HelperInvocation;
	const uvec4 realLanes = subgroupBallot(real);
	const bool leader = real && gl_SubgroupInvocationID == subgroupBallotFindLSB(realLanes);
	const uint base = RayCounterSlot() * RAY_COUNTER_STRIDE;
	const uint pixels = subgroupAdd(real ? 1u : 0u);
	const uint held = subgroupAdd((real && kept) ? 1u : 0u);
	const uint frameSum = subgroupAdd((real && kept) ? uint(max(frames, 0.0)) : 0u);
	const uint twinSum = subgroupAdd((real && kept) ? uint(max(twin, 0.0)) : 0u);
	if (leader && pixels > 0u)
	{
		atomicAdd(u_RayCounters.Counts[base + lanePixels], pixels);
		if (held > 0u)
		{
			atomicAdd(u_RayCounters.Counts[base + laneKept], held);
			atomicAdd(u_RayCounters.Counts[base + laneFrames], frameSum);
			if (CountsAsWater())
				atomicAdd(u_RayCounters.Counts[base + RAY_LANE_WATER_SIGNAL_TWIN], twinSum);
		}
	}
	// One reason per refused pixel, numbered as g_Refusal is: off screen,
	// none there, normal, plane, roughness. They sum to the refused count
	// by construction, which is the check if a printed line looks wrong --
	// less RT-15c's sixth, another object, which has no lane of its own
	// (the frames lane follows the fifth).
	for (uint r = 1u; r <= 5u; ++r)
	{
		const uint n = subgroupAdd((real && !kept && uint(refusal) == r) ? 1u : 0u);
		if (leader && n > 0u)
			atomicAdd(u_RayCounters.Counts[base + laneRefused + (r - 1u)], n);
	}
}

#else
void CountSignal(bool kept, int refusal, float frames, float twin) {}
#endif

void main()
{
	const ivec2 texel = ivec2(gl_FragCoord.xy);
	const ivec2 size = textureSize(u_Fresh, 0);
	const vec4 fresh = texelFetch(u_Fresh, texel, 0);
#ifdef RV_SIGNAL_PAIR
	const vec4 fresh2 = texelFetch(u_Fresh2, texel, 0);
	vec3 kept2 = fresh2.rgb;
	// RT-8: the twin counts its own frames now; one until a history is kept.
	float twinFrames = 1.0;
#endif

	// Nothing glossy here: nothing to average, and a zero share for the hook.
	// The zero matters -- a stale value left in this attachment would be
	// picked up as a history next frame -- and so does the mark below it,
	// which says no reflector stood here for anyone to match.
	vec3 P, N;
	if (fresh.a < 0.0 || !SurfaceAt(texel, size, P, N))
	{
		o_Accumulated = vec4(0.0);
		o_Surface = vec4(0.0, 0.0, 0.0, -1.0);
		o_Extra = vec4(0.0);
#if !defined(RV_SIGNAL_PAIR) && !defined(RV_SIGNAL_DIFFUSE)
		// Nothing here reflects, so there is no image to have moved. Zero is
		// read by the resolve as "use the surface's", which is right.
		o_Motion = vec4(0.0);
		// RT-15: and no moving layer to keep.
		o_MovingLayer = vec4(0.0);
		// RT-15c: and no object. The filter's id test reads this lane on texels that took
		// no candidate, and a lane left unwritten there holds whatever the target held.
		o_Ident = vec4(0.0);
#endif
#ifdef RV_SIGNAL_PAIR
		o_Accumulated2 = vec4(0.0);
#endif
		return;
	}

	const vec2 uv = (vec2(texel) + 0.5) / vec2(size);
	const float row = u_Reflection.History.w > 0.5 ? 1.0 - uv.y : uv.y;
	const vec2 nowNdc = vec2(uv.x * 2.0 - 1.0, row * 2.0 - 1.0);
	const vec3 eye = u_Scene.CameraPosition.xyz;
	const float eyeDistance = length(P - eye);
	const vec3 sight = (P - eye) / max(eyeDistance, 1.0e-4);
	const vec4 surface = texelFetch(u_Surface, texel, 0);
	const float roughness = clamp(surface.b, 0.0, 1.0);
	// RT-6.5: the G-buffer's normal attachment carries the metallic in a,
	// beside the roughness in b. Read here once, used by every candidate.
	g_Metallic = clamp(surface.a, 0.0, 1.0);
	// RT-6.5: and who it is. The id lane's r, as the G-buffer wrote it --
	// a whole number, negated for a static surface, so it is compared and
	// never interpolated.
	g_ObjectId = texelFetch(u_SurfaceId, texel, 0).r;
	const float luma = Luma(fresh.rgb);

	// The image behind the surface: the ray's distance for a flat mirror,
	// nearer for anything that curves -- and nearer again for anything
	// rough. A rough lobe's reflection is a blur of many directions and its
	// blur slides across the surface by less than a mirror image would, so a
	// history looked for at the mirror's parallax lands past it, on a
	// neighbour's picture: the smear the rough floor showed under a dolly.
	// The lobe's dominant direction sits between the mirror direction and
	// the normal by a factor of roughness and view angle (Lagarde's fit, as
	// NVIDIA's ReBLUR places its virtual point), and the image goes that
	// fraction of the way back. A miss is the sky and stands at the horizon.
	const float travelled = min(fresh.a, 1.0e3);
#ifdef RV_SIGNAL_DIFFUSE
	// A diffuse signal (shadows, occlusion, irradiance) moves with its
	// surface: no virtual image, the history is read where the surface was.
	float image = 0.0;
#else
	const float curvature = Curvature(texel, size, P, N);
	const float NoV = clamp(dot(N, -sight), 0.0, 1.0);
	const float lobe = 0.298475 * log(39.4115 - 39.0029 * roughness);
	const float dominant = pow(1.0 - NoV, 10.8649) * (1.0 - lobe) + lobe;
	float image = travelled * clamp(dominant, 0.0, 1.0) / (1.0 + 2.0 * travelled * curvature);
#endif

	// RT-6.10: kept before anything blends it. Below, `image` is mixed toward
	// the history's own so the parallax is steady frame to frame; the test
	// needs the value *this frame's ray* produced.
	g_FreshImage = image;

	// RT-15: this frame's picture as its two layers. The still layer is the whole picture on
	// every signal but the reflections', and on those wherever nothing moved.
	vec3 freshStill = fresh.rgb;
#if !defined(RV_SIGNAL_PAIR) && !defined(RV_SIGNAL_DIFFUSE)
	const vec4 freshMovingLane = MovingLayerLive() ? texelFetch(u_FreshMoving, texel, 0) : vec4(0.0);
	const vec3 freshMoving = clamp(freshMovingLane.rgb, vec3(0.0), max(fresh.rgb, vec3(0.0)));
	if (MovingLayerLive())
		freshStill = max(fresh.rgb - freshMoving, vec3(0.0));
	// What the moving layer keeps: this frame's until a history of it is found, and no
	// frames behind it -- where no ray struck a mover it is nothing, at once, so a mover
	// that has passed leaves no reflection of itself behind.
	vec3 keptMoving = freshMoving;
	float framesMoving = freshMovingLane.a > 0.0 ? 1.0 : 0.0;
#endif
	vec3 kept = freshStill;
	float frames = 1.0;
	float choice = 0.0;
	float momMean = luma;
	float momMeanSq = luma * luma;

	if (u_Reflection.History.x > 0.5)
	{
		// The surface's own old place first -- not to average with yet, but
		// to read the image distance the frames behind it settled on, which
		// this frame's rays refine rather than replace.
		Candidate atSurface;
		float neighbourMotion = 0.0;
		const bool silhouette = AtSilhouette(texel, size, P, N, eyeDistance, neighbourMotion);
		// RT-15: the surface history is looked for where the surface was, not
		// where the camera alone would put it.
		const vec2 objectShift = ObjectShift(texel, P, nowNdc);
		// RT-18: asked only at a silhouette, the one place the answer is used.
		g_SilhouetteMoving = silhouette && ObjectMovesAround(texel, size);
		const bool haveSurface = HistoryAt(P, size, P, N, roughness, eyeDistance,
		                                   silhouette, objectShift, atSurface);
#ifdef RV_SIGNAL_DIFFUSE
		Candidate c = atSurface;
		bool have = haveSurface;
		choice = have ? 0.5 : 0.0;
#else
		// RT-15: and the image is looked for where the *image* was, which is
		// only the same place when the reflector stood still. No shift is
		// passed with it: ImageThen has already moved the world point to
		// where it stood, so the camera matrix alone is the whole of it.
		//
		// `bilinear` is the search saying it took the texel own history
		// rather than a neighbour. Only that one knows where this surface
		// plane stood last frame; a neighbour plane is a different point of
		// the same surface, and doubling that difference throws the lookup
		// off by metres. Without it the camera answer is kept, as before.
		vec3 imagePoint = P + sight * image;
		if (haveSurface)
		{
			image = mix(atSurface.reflector.a, image, 1.0 / min(atSurface.past.a + 1.0, 8.0));
			// The plane the shift is measured against is stored at half
			// precision, so on a still reflector the residual is its rounding
			// rather than nothing at all -- doubled and applied, that moved the
			// lookup enough to shorten the memory across a parked frame. No
			// motion, no move, and the image point stays exactly where the
			// camera arm puts it.
			const bool moved = dot(objectShift, objectShift) > 0.0;
			imagePoint = (moved && atSurface.bilinear)
			           ? ImageThen(P, N, sight, image, atSurface, vec3(0.0))
			           : P + sight * image;
		}
		Candidate c;
		bool have = HistoryAt(imagePoint, size, P, N, roughness, eyeDistance,
		                      silhouette, vec2(0.0), c);
		choice = have ? 1.0 : 0.0;
		// **RT-15: on a curved reflector moving on its own, both histories, and the
		// one nearer this frame's picture.** Neither follows it exactly: the image
		// history is placed by an image distance that varies across the curve and
		// with the motion, the surface history by the surface, which is where a
		// rough lobe's blurred picture travels but not a sharp one's. Measured on the
		// driving car's body, the image history alone was further from the settled
		// picture than averaging nothing at all. So each candidate is scored by how
		// far its picture sits from the fresh 3x3's mean, in that neighbourhood's
		// spreads, and the surface's is taken when it is clearly nearer
		// (kSurfaceNearer) -- the choice the dual-source denoisers make per pixel.
		// Car body error 6.82 -> 5.75 against its settled pose; the flat chrome
		// cube, whose image history is exact, never enters.
		g_MovingCurved = dot(objectShift, objectShift) > 0.0 && curvature > kCurvedMover;
		if (have && haveSurface && g_MovingCurved)
		{
			vec3 nearMean, nearSd;
			Neighbourhood(texel, size, nearMean, nearSd);
			const float spread = max(Luma(nearSd), 1.0e-4);
			const float byImage = abs(Luma(c.past.rgb) - Luma(nearMean)) / spread;
			const float bySurface = abs(Luma(atSurface.past.rgb) - Luma(nearMean)) / spread;
			if (bySurface < kSurfaceNearer * byImage)
			{
				c = atSurface;
				choice = 0.5;
			}
		}
		// **RT-15e: but not on a flat reflector moving on its own.** Its image history is exact
		// (ImageThen), and where there is none -- the strip its leading edge covers this frame --
		// its surface history is the wrong picture: the surface carries its own old place, whose
		// reflection stood one frame of travel away. Taken, every new strip started as a copy of
		// the picture shifted by the travel and kept it for the frames that history held, so the
		// moving chrome cube's reflected detail repeated every four texels (its travel a frame)
		// and smeared along its path -- the vertical bands and horizontal lines the owner saw, which
		// took seconds to fade after it stopped (2026-09-15). The strip starts from its own rays
		// instead. A curved mover keeps the fallback: its choice between the two is made above.
		const bool flatMover = dot(objectShift, objectShift) > 0.0 && curvature <= kCurvedMover;
		if (!have && haveSurface && !flatMover)
		{
			c = atSurface;
			have = true;
			choice = 0.5;
		}
#endif

		if (have)
		{
			g_Kept = true;
			// **The bound: the fresh neighbourhood's spread, widened on smooth
			// surfaces and never narrower than the pixel's own fluctuation.**
			// A tube's line on car paint is a pixel or two wide with dark
			// neighbours; held to their spread, its history is pulled down
			// every frame and the paint reads matte (owner, 2026-09-05
			// night) -- a mirror's rays hardly scatter, so its history needs
			// no bounding against noise; the rough floor's does. And a rough
			// pixel whose own estimate swings by so much a frame is not
			// changing, it is grainy: the moments say by how much, and the
			// bound opens to that.
			// **RT-8: and a signal with no mirror end never opens it.** The ramp
			// above says a smooth surface needs no bound because a mirror's
			// rays hardly scatter -- true of a reflection, and false of every
			// diffuse-kind signal, whose estimate is stochastic however smooth
			// the surface under it is. The sea is the case that shows it: its
			// roughness is an RMS slope of about 0.05, which reads as a mirror
			// here and opened the bound to twelve spreads, so a lamp drawn with
			// a small probability and paid an enormous weight went straight
			// through as a firefly. `gloss` is already forced to one for these
			// signals two lines down, for the same reason and in the same words.
			// **And only where a layer says its roughness is not a gloss axis.**
			// The ramp is right for a reflection and wrong for a sea, whose RMS
			// slope of about 0.05 reads here as a mirror -- but the occlusion,
			// the bounce and the direct light were working with it, and turning
			// it off for every diffuse-kind signal changed pictures that had
			// not asked. PositionLane is what marks a layer of the sea's kind.
			const float width = PositionLane()
							  ? max(u_Reflection.Probe.x, 0.0)
							  : mix(12.0, max(u_Reflection.Probe.x, 0.0),
									smoothstep(0.08, 0.3, roughness));
			vec3 mean, sd;
			// RT-15: the still layer's history is the picture kept less the moving layer kept
			// with it, and its bound the fresh still part's -- both the whole picture's where
			// the moving layer is not live.
			vec3 pastStill = c.past.rgb;
#if !defined(RV_SIGNAL_PAIR) && !defined(RV_SIGNAL_DIFFUSE)
			if (MovingLayerLive())
			{
				vec3 ignoredMean, ignoredSd;
				NeighbourhoodLayers(texel, size, mean, sd, ignoredMean, ignoredSd);
				pastStill = max(c.past.rgb - PastMovingAt(c).rgb, vec3(0.0));
			}
			else
#endif
				Neighbourhood(texel, size, mean, sd);
			const float sigma = sqrt(max(c.extra.b - c.extra.g * c.extra.g, 0.0));
			const vec3 halfWidth = max(sd * width, vec3(kTemporalSigma * sigma));
			const vec3 held = clamp(pastStill, mean - halfWidth, mean + halfWidth);

			// How far the picture moved since last frame, in texels, on the
			// unjittered grid both sides: a parked camera reads the half
			// pixel this frame's sample sits from the centre and no more,
			// which the slack below absorbs; the dither is not motion.
			const vec2 shift = c.thenNdc - (nowNdc - u_Scene.Jitter.xy);
			// RT-6.1: the same quantity the temporal resolve wants, in its units.
			g_ImageMotion = -shift * 0.5;
			g_HaveMotion = true;
			const float moved = length(shift * 0.5 * vec2(size));

			// The memory: full standing still, and shorter in proportion to
			// how far the picture moved -- a running average of a moving
			// picture is motion blur, and the 12 m burst measured its peaks
			// losing a tenth over three seconds of slow yaw with a fixed
			// memory. A mirror has no grain to average and forgets four times
			// as fast, down to a single frame; the rough floor keeps a few so
			// its grain does not come back under motion.
#ifdef RV_SIGNAL_DIFFUSE
			const float gloss = 1.0;   // a diffuse signal has no mirror end
#else
			const float gloss = smoothstep(0.0, 0.3, roughness);
#endif
			const float slack = max(u_Reflection.Probe.y, 0.25) * mix(0.25, 1.0, gloss);
			const float fewest = mix(1.0, max(u_Reflection.History.z, 1.0), gloss);
			// The silhouette rule above keeps the full memory here on purpose:
			// capped at one jitter cycle (eight frames, tried 2026-09-06) the
			// edges flickered again at 2.7 levels a frame against 1.5, and the
			// "ghost" that cap was meant for was the metric comparing an
			// averaged edge texel with a single-sided reference.
			//
			// **Written against a base rather than against History.y** (RT-8):
			// a pair's two halves may want different memories, and every
			// shortening below applies to both alike. See ShortenedMemory.
			float memory = ShortenedMemory(max(u_Reflection.History.y, 1.0),
										   moved, slack, fewest, silhouette,
										   neighbourMotion);

			// **RT-6.3: and shortened by how much the reflection itself moved.**
			// The reflector's own normal is in the candidate, so last frame's
			// reflection direction is exact rather than guessed: the eye was
			// there, the surface faced that way, the mirror direction follows.
			//
			// The memory is scaled, not the history refused. Refusing would trade
			// a smear for the noise of a one-frame estimate on exactly the
			// surfaces that show noise worst; scaling lets the fresh rays take
			// over at the rate the reflection is actually changing. The floor is
			// `fewest`, which a mirror already sets to one.
			if (u_Reflection.PreviousEye.w > 0.5)
			{
				const vec3 wasN = DecodeSurfaceNormal(c.reflector.rg);
				const vec3 thenSight = normalize(P - u_Reflection.PreviousEye.xyz);
				const float confidence =
					DirectionConfidence(reflect(sight, N), reflect(thenSight, wasN),
										roughness);
				memory = max(mix(fewest, memory, confidence), fewest);
			}
			// RT-6.4: and by how well the reflector itself matched. Multiplied
			// rather than taken as a minimum: a candidate that is marginal on two
			// counts at once is worth less than one marginal on either.
			memory = max(mix(fewest, memory, c.matchConfidence), fewest);
			// **RT-8: how much of all that the twin keeps.** Every reduction
			// above is a property of the pixel, not of the payload -- how far
			// the picture moved, whether it sits on a silhouette, how well the
			// surface matched -- so the twin is put through the same ones from
			// its own base. `confidence` and `matchConfidence` are folded in as
			// a single ratio for the same reason: they are already multiplied
			// into `memory`, and re-deriving them would be a second copy to
			// keep in step.
			const float reduced = memory / max(ShortenedMemory(max(u_Reflection.History.y, 1.0),
															   moved, slack, fewest, silhouette,
															   neighbourMotion), 1.0e-4);
			frames = min(c.past.a + 1.0, memory);
			// **Measured change: where a share of the light is known to have
			// changed, the new frame counts for at least that share** -- and the
			// count restarts from there, so the frames after it rebuild the
			// average as a fresh one would rather than dragging the stale part
			// out at the full memory's rate. A still scene measures nothing,
			// and nothing here runs.
			vec2 measured = vec2(0.0);
			float blendFrames = frames;
#if !defined(RV_SIGNAL_PAIR) && !defined(RV_SIGNAL_DIFFUSE)
			// **And, on the reflections, the restart is the blend's alone.** The
			// alpha is also the lit shader's trust in this picture against its
			// probe, faded in over four frames for a history just begun -- right
			// after a disocclusion, where the probe is a smooth stand-in for grain,
			// and wrong after a light changed, where the probe is a capture of the
			// old light. Restarting the alpha brought that old light back for a
			// frame and the temporal resolve held it for a second. So the count
			// the blend runs on is carried in the id lane's green, and the alpha
			// keeps the trust it had.
			if (u_Reflection.Change.x > 0.5)
			{
				const float carried = texelFetch(u_HistoryIdent, c.pastTexel, 0).g;
				if (carried > 0.0)
					blendFrames = min(carried + 1.0, memory);
			}
#endif
			if (u_Reflection.Change.x > 0.5)
			{
				// **Read where the history came from.** The map belongs to last
				// frame's picture -- the record's blocks sit on last frame's grid,
				// each saying how much of what was shown there has changed -- so it
				// is read through the reprojection the history was: this texel,
				// moved by how far the picture moved. Under an eighth of a texel
				// that is the two ways of computing one point disagreeing, not
				// motion (kMotionFloor), and the texel is read where it stands --
				// which on a still camera is every texel.
				const vec2 travelled = moved < kMotionFloor
									 ? vec2(0.0)
									 : vec2(shift.x, u_Reflection.History.w > 0.5 ? -shift.y : shift.y)
									   * 0.5 * vec2(size);
				measured = MeasuredChangeAt(vec2(texel) + 0.5 + travelled);
				if (measured.x > 0.0)
					blendFrames = max(min(blendFrames, 1.0 / measured.x), 1.0);
			}
#if defined(RV_SIGNAL_PAIR) || defined(RV_SIGNAL_DIFFUSE)
			// Nothing reads these signals' alpha as trust: the count is the count.
			frames = blendFrames;
#endif
			g_BlendFrames = blendFrames;
			kept = mix(held, freshStill, 1.0 / blendFrames);
#ifdef RV_SIGNAL_PAIR
			// The twin: read where the candidate was read, bounded by its
			// own neighbourhood at the same width, blended by the same
			// frames. A specular half is sharper than its diffuse twin, so
			// the bound is its own; the memory is shared.
			{
				vec3 mean2, sd2;
				Neighbourhood2(texel, size, mean2, sd2);
				const vec4 past2 = c.bilinear ? texture(u_History2, c.pastUv)
											  : texelFetch(u_History2, c.pastTexel, 0);
				const vec3 halfWidth2 = max(sd2 * width, vec3(1.0e-4));
				// Clamped, and on a memory of its own (Tuning.w; zero shares the
				// diffuse's): the water's lesson holds on land -- a highlight is
				// what a moving view changes first, so the twin forgets faster.
				// Measured: memory 4 halves the still bias and cuts the motion
				// error on every region; the clamp off doubles the motion error.
				const vec3 held2 = clamp(past2.rgb, mean2 - halfWidth2, mean2 + halfWidth2);
				// **RT-8: its own memory, and its own count of the frames
				// behind it.** This was `min(frames, Tuning.w)`, which could
				// only ever make the twin shorter than the first half -- right
				// for the direct light, whose highlight forgets faster than its
				// diffuse, and impossible for the sea, whose glint wants
				// sixteen frames where the light entering the water wants four.
				// The sea was measured holding four (2026-09-08) and reading
				// noisier than the private pass it replaced; this is why.
				//
				// The twin's w now carries the twin's own count. Nothing else
				// reads it -- the blur copies it through untouched -- so the
				// change is confined to the two lines that write and read it.
				// **Its own memory only when it wants a *longer* one.** The
				// ceiling below -- min(frames, PairMemory) -- is exactly right
				// whenever the twin forgets faster than the first half, which
				// is the direct light's case and was the only case until the
				// sea arrived. Taking the general path there changed a shipped
				// picture for no gain, so it is taken only when the ceiling
				// cannot express what is asked: a twin whose memory is longer.
				float frames2 = u_Reflection.Tuning.w > 0.0
							  ? min(frames, u_Reflection.Tuning.w) : frames;
				if (u_Reflection.Tuning.w > max(u_Reflection.History.y, 1.0))
				{
					const float memory2 =
						max(ShortenedMemory(max(u_Reflection.Tuning.w, 1.0),
											moved, slack, fewest, silhouette,
											neighbourMotion) * reduced, fewest);
					frames2 = min(past2.a + 1.0, memory2);
				}
				// Measured change: the highlight by its own share.
				if (measured.y > 0.0)
					frames2 = max(min(frames2, 1.0 / measured.y), 1.0);
				kept2 = mix(held2, fresh2.rgb, 1.0 / frames2);
				twinFrames = frames2;
			}
#endif

			// The moments track what *arrives*, at the rate the colour
			// forgets or faster: a light that went out must not hold the
			// bound open for long.
			const float momentAlpha = max(1.0 / g_BlendFrames, 1.0 / kMomentFrames);
			momMean = mix(c.extra.g, luma, momentAlpha);
			momMeanSq = mix(c.extra.b, luma * luma, momentAlpha);
		}
#if !defined(RV_SIGNAL_PAIR) && !defined(RV_SIGNAL_DIFFUSE)
		// **RT-15: the moving layer, followed.** Where this texel's rays struck something that
		// moved, its history is where that thing's image stood last frame: the struck points'
		// travel, mirrored through the reflector and shrunk as the image is (the mirror
		// equation's 1 / (1 + 2 d k) on a curve, the lobe's dominant fraction on a rough surface),
		// taken off the image point -- through last frame's plane where the reflector moved
		// too. The still layer's tests find the reflector there; the layer is bounded by the
		// fresh moving part and remembers as a picture moving that far may.
		if (MovingLayerLive() && freshMovingLane.a > 0.0)
		{
			const vec3 seenTravel = MoverTravel(texel, size)
								  * (clamp(dominant, 0.0, 1.0) / (1.0 + 2.0 * travelled * curvature));
			const vec3 movingPoint = (haveSurface && dot(objectShift, objectShift) > 0.0 && atSurface.bilinear)
									? ImageThen(P, N, sight, image, atSurface, seenTravel)
									: P + sight * image - MirrorVector(seenTravel, N);
			// The search reports why it refused into the debug view's code; that code is the
			// still layer's, so it is kept.
			const int stillRefusal = g_Refusal;
			Candidate cm;
			const bool haveMoving = HistoryAt(movingPoint, size, P, N, roughness, eyeDistance,
											 silhouette, vec2(0.0), cm);
			g_Refusal = stillRefusal;
			const vec4 pastMoving = haveMoving ? PastMovingAt(cm) : vec4(0.0);
			if (pastMoving.a > 0.0)
			{
				vec3 stillMean, stillSd, movingMean, movingSd;
				NeighbourhoodLayers(texel, size, stillMean, stillSd, movingMean, movingSd);
				const float movingWidth = PositionLane()
										? max(u_Reflection.Probe.x, 0.0)
										: mix(12.0, max(u_Reflection.Probe.x, 0.0), smoothstep(0.08, 0.3, roughness));
				const vec3 movingHalf = max(movingSd * movingWidth, vec3(1.0e-4));
				const vec3 heldMoving = clamp(pastMoving.rgb, movingMean - movingHalf, movingMean + movingHalf);
				const vec2 movingShift = cm.thenNdc - (nowNdc - u_Scene.Jitter.xy);
				const float movingMoved = length(movingShift * 0.5 * vec2(size));
				const float movingGloss = smoothstep(0.0, 0.3, roughness);
				const float movingSlack = max(u_Reflection.Probe.y, 0.25) * mix(0.25, 1.0, movingGloss);
				const float movingFewest = mix(1.0, max(u_Reflection.History.z, 1.0), movingGloss);
				const float movingMemory = ShortenedMemory(max(u_Reflection.History.y, 1.0), movingMoved,
														   movingSlack, movingFewest, silhouette, neighbourMotion);
				framesMoving = min(pastMoving.a + 1.0, movingMemory);
				keptMoving = mix(heldMoving, freshMoving, 1.0 / framesMoving);
				// The motion lane stays the still layer's: the temporal resolve never sees this
				// layer, which the composite adds after it (reflection_composite_moving.rvshader).
			}
		}
#endif
	}

#if !defined(RV_SIGNAL_PAIR) && !defined(RV_SIGNAL_DIFFUSE)
	// **The image's motion, in the velocity lane's units.** The accumulator
	// already measures it: `shift` below is how far the picture moved since
	// last frame, both sides on the unjittered grid, which is the scene
	// shader's o_Velocity with the sign the other way round and the halving
	// left off. Zero with no history: nothing to difference, and the resolve
	// then keeps the surface's motion, which is what it did before this.
	// **RT-12: and the reflection direction itself, in the two channels
	// this attachment has always had spare.** RT-6.1 sized it RGBA16F for
	// a two-channel motion and left zw at zero; a unit vector is exactly
	// two channels octahedrally, and this pass computes the direction
	// anyway for RT-6.3's test. So the specification's §11 view costs no
	// bandwidth, no matrix and no uniform buffer -- and next frame this
	// same lane, read from the previous history, is what makes
	// `1 - dot(R_now, R_prev)` a difference of two stored vectors rather
	// than a reconstruction from two cameras.
	o_Motion = vec4(g_HaveMotion ? g_ImageMotion : vec2(0.0),
					OctEncode(reflect(sight, N)));
	// RT-6.5: who this texel was, for the next frame's fourth check.
	// RT-17: and what its ray struck, for the next frame's identity check.
	o_Ident = vec4(g_ObjectId, u_Reflection.Change.x > 0.5 ? g_BlendFrames : 0.0,
				   u_Reflection.Change.y > 0.5 ? texelFetch(u_FreshIdentity, texel, 0).rg : vec2(0.0));
#endif
	// **RT-5: the four running averages this pass keeps, rounded onto the half
	// grid here rather than by the write** -- the picture, its twin, the image
	// distance and the two moments. Left to the hardware, which rounds toward
	// zero, each lost half a step a frame, and the picture settled 1.7% dark on
	// the direct light's diffuse (include/half_float.glsl). The frame count, the
	// normal, the plane and the packed material are not averages and are not
	// touched.
	const uvec2 roundingPixel = uvec2(texel);
	const uint roundingFrame = uint(u_Scene.GlobalIllumination.y);
#if !defined(RV_SIGNAL_PAIR) && !defined(RV_SIGNAL_DIFFUSE)
	// RT-15: the picture is both layers; the moving one is kept beside it, rounded on its own
	// draw so the still layer read back from the difference stays unbiased.
	o_Accumulated = vec4(StoreAsHalf(kept + keptMoving, HalfRoundingDraw(roundingPixel, roundingFrame, 0u)),
						 frames);
	o_MovingLayer = vec4(StoreAsHalf(keptMoving, HalfRoundingDraw(roundingPixel, roundingFrame, 5u)),
						 framesMoving);
#else
	o_Accumulated = vec4(StoreAsHalf(kept, HalfRoundingDraw(roundingPixel, roundingFrame, 0u)),
						 frames);
#endif
#ifdef RV_SIGNAL_PAIR
	// RT-8: the twin's own frame count, not the first half's -- see the
	// memory block above for why the two must be able to differ.
	o_Accumulated2 = vec4(StoreAsHalf(kept2, HalfRoundingDraw(roundingPixel, roundingFrame, 1u)),
						  twinFrames);
#endif
	// For the next frame's tests: this reflector's normal as the scene
	// encodes it, the plane it lies in, how far behind it its image sat;
	// its roughness, what its estimate has been doing, and which history it
	// took -- the last for the debug view (--debug-view=reflection-choice).
	o_Surface = vec4(surface.rg, dot(N, P),
					 StoreAsHalf(image, HalfRoundingDraw(roundingPixel, roundingFrame, 2u)));
	// choice in the fraction (0 none, 0.25 the surface's history, 0.5 the
	// image's), the refusal reason in the integer part.
	// RT-6.5: the roughness with the metallic in its integer part, so the
	// next frame can tell a metal from a dielectric at the same roughness.
	// RT-15: and kMovingCurvedMark above both where the reflector is curved and moves
	// on its own, which is what reflection_blur reads to give the texel its radius.
	o_Extra = vec4(PackMaterial(roughness, g_Metallic),
				   StoreAsHalf(momMean, HalfRoundingDraw(roundingPixel, roundingFrame, 3u)),
				   StoreAsHalf(momMeanSq, HalfRoundingDraw(roundingPixel, roundingFrame, 4u)),
				   0.5 * choice + float(g_Refusal) + (g_MovingCurved ? kMovingCurvedMark : 0.0));
#ifdef RV_SIGNAL_PAIR
	CountSignal(g_Kept, g_Refusal, frames, twinFrames);
#else
	CountSignal(g_Kept, g_Refusal, frames, frames);
#endif
}
