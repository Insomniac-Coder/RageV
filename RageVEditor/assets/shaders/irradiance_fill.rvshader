// Solves an irradiance field: one cell of stored light per fragment.
//
// **Why a fragment shader and not compute.** The shading of a hit belongs to
// TraceSurface, in pbr_fragment.glsl, and a second copy of it is how two
// renderers start disagreeing about what a hit looks like -- the same argument
// rtgi_trace makes for borrowing rather than copying. That include survives
// RV_TRACE_ONLY, which drops everything needing a vertex stage, but it does not
// survive leaving the fragment stage: the shadow lookups near its top sample
// with an implicit level of detail, which is a fragment-only thing. Voxelisation
// already writes a 3D texture from a fragment shader in this engine, so the
// road exists and is paved.
//
// One fragment per cell, in a target laid out as the volume unrolled: x is the
// cell's x, and y carries its y and z stacked. Nothing is written to that
// target -- the cells go out through imageStore -- so it is a rasteriser
// driver and nothing else.

#type vertex
#version 460 core

void main()
{
	// The usual fullscreen triangle, with no varyings: this pass wants
	// gl_FragCoord and nothing else.
	vec2 uv = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(uv * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 460 core

#define RV_TRACE_ONLY
#include "include/pbr_fragment.glsl"

layout(location = 0) out vec4 o_Unused;

// The field being solved, written directly. One image with three tiles stacked
// along z -- red, then green, then blue -- because one texture is one sampler
// where it is read, and a fragment shader has thirty-two of those on OpenGL.
layout(set = 3, binding = 0, rgba16f) uniform image3D u_FillField;

layout(push_constant) uniform FillParams
{
	// The box being solved, in world space: centre and half-extents -- and in
	// their spare lanes, the two numbers that place it inside the atlas.
	//
	// **Centre.w is where this volume's slices begin inside a tile**, and
	// **Extents.w is the atlas's depth**, which is the stride from one tile to
	// the next. Several volumes share one texture because a fragment shader
	// has thirty-two samplers on OpenGL and terrain already spends thirty-one
	// of them, so a field's tile no longer starts at its own depth times the
	// tile index -- it starts at the *atlas* depth times the tile index, plus
	// this volume's offset. Every imageStore below says so.
	vec4 Centre;
	vec4 Extents;

	// xyz cells a side, w how many rays each casts.
	vec4 Grid;

	// x how far a ray may travel before it is called a miss; y a counter the
	// directions are hashed against so successive solves of the same cell do
	// not repeat one another; **z how much of this pass to keep** against the
	// previous pass's completed field.
	//
	// One on the first pass -- there is nothing to keep -- and less after it.
	// The history it blends against is the *previous sweep's* field, read
	// through the sampler (this pass writes a different texture and the two
	// swap at each sweep boundary).
	//
	// **w is the flavour switch.** With it set, each sweep's rays also read
	// that previous field at their hits -- so a pass is not merely more rays,
	// it is one more bounce of transport, and the blend walks the store
	// toward the multi-bounce fixed point: the traced flavour, matching
	// realtime RTGI. With it clear the hits shade against the probe alone and
	// every pass re-estimates the same single bounce: the screen flavour,
	// matching what the gather and the voxel form estimate.
	vec4 Trace;

	// The box's own axes, as columns: where a cell sits in the world is the
	// centre plus this applied to where it sits in the box. Identity for a
	// volume nobody turned, and three multiply-adds either way.
	vec4 Rotation[3];
} u_Fill;

// A direction on the sphere, uniformly.
//
// Uniform rather than cosine-weighted, and that is the whole reason the
// projection below comes out as simply as it does: a cell has no surface and
// therefore no normal to weight against. It is a point in the air, and light
// reaching it from below matters exactly as much as light from above.
vec3 SphereDirection(inout uint seed)
{
	const float z = GiRandom(seed) * 2.0 - 1.0;
	const float a = GiRandom(seed) * 6.28318531;
	const float r = sqrt(max(1.0 - z * z, 0.0));
	return vec3(r * cos(a), r * sin(a), z);
}

void main()
{
	o_Unused = vec4(0.0);

	// Which flavour this pass produces: with feedback the rays read the
	// previous sweep's field at their hits and passes become bounces (the
	// traced flavour); without, every pass re-estimates the same single
	// bounce (the screen flavour). See ShadeTraced's guarded block.
	g_FillFeedback = u_Fill.Trace.w > 0.5;

	// Where this volume sits in the shared texture: the first slice it owns,
	// and the distance between one tile and the next.
	const int atlasBase = int(u_Fill.Centre.w + 0.5);
	const int tileStride = int(u_Fill.Extents.w + 0.5);

	const ivec3 grid = ivec3(u_Fill.Grid.xyz + 0.5);
	const int rays = max(int(u_Fill.Grid.w + 0.5), 1);

	// The cell this fragment is: x straight from the column, y and z unstacked
	// from the row.
	const ivec2 pixel = ivec2(gl_FragCoord.xy);
	const ivec3 cell = ivec3(pixel.x, pixel.y % grid.y, pixel.y / grid.y);
	if (cell.x >= grid.x || cell.y >= grid.y || cell.z >= grid.z)
		discard;

	// Where that cell sits in the world. The first and last cells sit *on* the
	// box's faces, which is the convention the sampler's texel-centre mapping
	// is written against -- the two have to agree or the field is offset by
	// half a cell and nothing says so.
	const vec3 t = vec3(cell) / max(vec3(grid) - 1.0, vec3(1.0));
	const vec3 inBox = (t * 2.0 - 1.0) * u_Fill.Extents.xyz;
	const vec3 origin = u_Fill.Centre.xyz
					  + u_Fill.Rotation[0].xyz * inBox.x
					  + u_Fill.Rotation[1].xyz * inBox.y
					  + u_Fill.Rotation[2].xyz * inBox.z;

	// **No virtual offset here, and that is a measured decision, not an
	// omission.** The APV/DDGI-style lift -- step a cell's trace origin off
	// any surface it sits on -- was implemented and run against the sealed
	// -room fixtures on 2026-08-26. It fixed the point-light room outright
	// (8.4 levels of glow to 0.2) and made every sun-lit one *worse* (3.2
	// to 15.6 at one-metre cells): waking the on-floor cell layer from dead
	// to alive changes which cells anchor the reads above the floor, and
	// the sun fixtures lose more to that than they gain. The mechanism is
	// right -- cells on grid-coincident surfaces really are the residual
	// leak carriers -- but the lift needs to come with its own pass over
	// the alive/dead and visibility story, not ride in on a constant.
	uint seed = GiHash(uint(cell.x) * 73856093u ^ uint(cell.y) * 19349663u
					   ^ uint(cell.z) * 83492791u ^ uint(u_Fill.Trace.y));

	// **Six faces, not a constant and a lean.**
	//
	// The first version stored first-order spherical harmonics: one number and
	// one direction a channel. It is the cheapest thing that can say "brighter
	// from over there", and it was measured against the realtime bounce and
	// found wanting in exactly the place a field is supposed to earn its keep
	// -- against a wall. A surface on a wall sees a hemisphere; the cell half a
	// cell off it sees the whole sphere, half of which is the wall's dark back.
	// One lobe cannot hold that step, so the reconstruction split the
	// difference and every surface near geometry read dark: 4.6 levels of it
	// beside the red wall.
	//
	// An ambient cube holds it. Six irradiances, one per axis of the box, each
	// the answer for a surface facing that way -- so the step from "facing the
	// wall" to "facing the room" is two separate numbers rather than two ends
	// of one lobe. Three of the six answer any given normal, so a reader still
	// spends three fetches; it is the storage that grows, not the lookup.
	vec3 face[6];
	for (int f = 0; f < 6; f++)
		face[f] = vec3(0.0);

	// **How often this cell found itself looking at the back of a surface**,
	// which is how a point in the air says it is not in the air at all. A cell
	// buried in a wall or under the floor sees that wall's inside from every
	// direction; a cell in a room sees backfaces only where geometry is
	// one-sided or inside out.
	int backfaces = 0;

	// **How far the geometry is, per direction -- the shadow half of the bake.**
	//
	// The same rays that carry the light back carry how far they went, and that
	// is the whole of what a stored field needs to stop lighting the far side
	// of a wall. It is not optional and there is no flag for it: a field that
	// says where light is without saying what stands in the way is a field that
	// leaks, so the light and its visibility are solved together or not at all.
	//
	// **Sixteen directions, not four coefficients.** A first-order fit of
	// distance was tried and measured and it is not enough -- it says "about
	// nine metres, more that way", and the thing that stops a wall leaking is
	// knowing it is eight hundred millimetres off in one direction while the
	// room is twenty metres deep in another. So: an octahedral map, and every
	// ray contributes to every bin by how well it points that way, which is
	// what lets sixty-four rays fill sixteen bins without any of them being a
	// single noisy sample.
	for (int i = 0; i < rays; i++)
	{
		const vec3 direction = SphereDirection(seed);

		// A cell is a point in the air, so there is no surface to lift off:
		// the normal handed to TraceSurface is the ray's own direction, which
		// makes its offset along that normal a step forward rather than a
		// sideways nudge off a face that does not exist.
		TracedSurface hit = TraceSurface(origin, direction, direction, u_Fill.Trace.x);

		// **A miss is nothing, not the sky**, which is the same rule the bounce
		// follows (7bb) and for the same reason: every consumer of this field
		// adds the probe irradiance beside it, and the probe already integrates
		// the sky over the whole sphere. Storing the sky here too would count
		// it twice at every reader.
		//
		// So what a cell holds is the *bounced* light arriving at it -- the
		// same currency as u_Indirect, and the currency the readers are
		// written against. A cell by a window still ends up bright: the window
		// light reaches it through the probe term, not through this one.
		if (hit.Missed)
			continue;

		// Facing away from the ray that found it: the ray started inside the
		// solid this surface bounds.
		//
		// **Asked of the hit, not of its normal**, and that distinction was
		// the whole defect: TraceSurface turns the normal to face the ray
		// before returning it, so `dot(hit.Normal, direction) > 0` -- what
		// this line used to say -- can never be true. `backfaces` was always
		// nought, no cell was ever found to be inside geometry, and every
		// cell in every bake was stored as a usable one. A cell in the middle
		// of a wall then stored what it could see *through* that wall, which
		// is a sealed room's glow and a thin divider's bright edge, both.
		if (hit.Backface)
		{
			backfaces++;
			continue;
		}

		// For the traced flavour, ShadeTraced reads the previous sweep's
		// field at this hit -- the feedback that turns passes into bounces.
		// The screen flavour skips it; see g_FillFeedback at the top of main.
		const vec3 radiance = ShadeTraced(hit, ProbeIrradiance(hit.Normal, 0.0));

		// **The ray's direction in the box's frame**, because that is the frame
		// the faces are named in and the frame a reader asks in. Orthonormal,
		// so three dots and no renormalising.
		const vec3 binDirection = vec3(dot(u_Fill.Rotation[0].xyz, direction),
									   dot(u_Fill.Rotation[1].xyz, direction),
									   dot(u_Fill.Rotation[2].xyz, direction));

		// Each face takes what arrives on its side, weighted by how squarely.
		// This is the cosine integral that face's surface would do, done once
		// here so a reader never has to.
		for (int axis = 0; axis < 3; axis++)
		{
			const float along = binDirection[axis];
			if (along > 0.0)
				face[axis * 2] += radiance * along;
			else
				face[axis * 2 + 1] += radiance * (-along);
		}
	}

	// How much of this pass to keep against what the field already holds.
	// Clamped rather than trusted: a blend outside zero to one would either
	// undo the history or run away from it.
	const float blend = clamp(u_Fill.Trace.z, 0.0, 1.0);

	// **A cell inside geometry stores nothing at all.**
	//
	// Whatever it accumulated describes the inside of a wall, and the only
	// thing that ever reads it is a surface *outside* that wall being
	// interpolated toward it -- so a cell in a solid contributing anything is
	// leaking by definition. A quarter of the sphere is the threshold DDGI
	// uses and it is the right shape of number here: a cell honestly in a room
	// sees a few backfaces off one-sided geometry, never a quarter of them.
	//
	// Written flat rather than blended: this is not an estimate that gets
	// better with more rays, it is a cell that should never be read.
	if (backfaces * 4 > rays)
	{
		for (int f = 0; f < 6; f++)
			imageStore(u_FillField, cell + ivec3(0, 0, tileStride * f + atlasBase),
					   vec4(0.0));
		// And nothing visible from it, so no reader takes light from it either.
		imageStore(u_FillField, cell + ivec3(0, 0, tileStride * 6 + atlasBase),
				   vec4(0.0));
		return;
	}

	// **What each face holds, and why the four is the whole of the maths.**
	//
	// A face stores the irradiance a surface pointing that way would receive,
	// over pi -- the same quantity the readers multiply by albedo. Monte Carlo
	// over the sphere weights each sample by 4*pi/N; the cosine integral divides
	// by pi; what is left is 4/N.
	//
	// Checked against the case with an answer by hand: radiance L from every
	// direction gives each face L * 4/N * sum(cos over its hemisphere), and that
	// sum tends to N/4, so every face reads L -- which is what a uniformly lit
	// point should store, and what an unsolved field's zero means the absence of.
	const float faceScale = 4.0 / float(rays);

	// **Blended against the previous sweep's field, not this texture's own
	// bytes.** The pass writes one texture and samples the other -- see the
	// swap in Renderer3D::SolvePendingIrradiance -- so the history read here
	// has to come through the sampler too: what this texture held before the
	// swap is a sweep further back than the one being blended with. The
	// sampler and the image share a layout texel for texel, so the fetch is
	// exact.
	for (int f = 0; f < 6; f++)
	{
		const ivec3 slot = cell + ivec3(0, 0, tileStride * f + atlasBase);
		// **The alpha says the cell is worth reading**, and it rides along free
		// in a lane the faces do not use. A cell zeroed for being inside
		// geometry reads zero there, and a reader that blends it in anyway
		// drags its answer toward black -- which is exactly what was happening
		// against every wall, because a volume drawn to the walls puts its
		// outermost cells *in* them.
		imageStore(u_FillField, slot,
				   mix(texelFetch(u_IrradianceField, slot, 0),
					   vec4(face[f] * faceScale, 1.0), blend));
	}

	// **Whether this cell can see the six cells next to it.**
	//
	// This is the leak, stated as the question it actually is. A field leaks
	// when two cells on opposite sides of a wall are blended together, and no
	// amount of describing where the light *is* answers that -- what answers it
	// is whether one cell can see the other. Six rays, one per neighbour, each
	// stopping where that neighbour is: anything hit before it arrives is a wall
	// standing between them.
	//
	// **Six rays a cell, once, read by a fetch and a few bit tests.** What this
	// replaced described distance in sixty-four directions per cell and made
	// every reader weigh eight cells against it: thirty-two tiles of memory and
	// +0.6 ms a frame, which is more than the second traced bounce the whole
	// field exists to stand in for. Same truth, in the form the reader needs.
	const vec3 step = 2.0 * u_Fill.Extents.xyz / max(vec3(grid) - 1.0, vec3(1.0));
	float neighbours = 0.0;
	for (int axis = 0; axis < 3; axis++)
	{
		for (int side = 0; side < 2; side++)
		{
			vec3 towards = u_Fill.Rotation[axis].xyz;
			if (side == 1)
				towards = -towards;

			// A neighbour off the end of the grid is nobody, and nothing will ever
			// blend with it. Called visible, so the bit means "no wall between"
			// rather than "no neighbour".
			const int next = cell[axis] + (side == 0 ? 1 : -1);
			bool visible = true;
			if (next >= 0 && next < grid[axis])
			{
				// Stopping just short of the neighbour, so a neighbour sitting
				// against a surface does not report it as a wall between them.
				const TracedSurface between =
					TraceSurface(origin, towards, towards, step[axis] * 0.98);
				visible = between.Missed;
			}

			if (visible)
				neighbours += float(1 << (axis * 2 + side));
		}
	}

	// Written flat rather than blended: it is a fact about geometry, not an
	// estimate that improves with rays, and a blended bitmask is not a bitmask.
	imageStore(u_FillField, cell + ivec3(0, 0, tileStride * 6 + atlasBase),
			   vec4(neighbours, 0.0, 0.0, 0.0));
}
