// Solves an irradiance field: one cell of stored light per fragment.
//
// **Why a fragment shader and not compute.** The shading of a hit belongs to
// TraceSurface, in pbr_fragment.glsl, and a second copy of it is how two
// renderers start disagreeing about what a hit looks like -- the same argument
// rtgi_trace makes for borrowing rather than copying. That include survives
// RV_TRACE_ONLY, which drops everything needing a vertex stage, but it does not
// survive leaving the fragment stage: the shadow lookups near its top sample
// with an implicit level of detail, which is a fragment-only thing. Voxelisation
// already writes a 3D texture from a fragment shader in this engine, so the
// road exists and is paved.
//
// One fragment per cell, in a target laid out as the volume unrolled: x is the
// cell's x, and y carries its y and z stacked. Nothing is written to that
// target -- the cells go out through imageStore -- so it is a rasteriser
// driver and nothing else.

#type vertex
#version 460 core

void main()
{
	// The usual fullscreen triangle, with no varyings: this pass wants
	// gl_FragCoord and nothing else.
	vec2 uv = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(uv * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 460 core

#define RV_TRACE_ONLY
#include "include/pbr_fragment.glsl"

layout(location = 0) out vec4 o_Unused;

// The three channels of the field being solved, written directly.
layout(set = 3, binding = 0, rgba16f) uniform writeonly image3D u_FillR;
layout(set = 3, binding = 1, rgba16f) uniform writeonly image3D u_FillG;
layout(set = 3, binding = 2, rgba16f) uniform writeonly image3D u_FillB;

layout(push_constant) uniform FillParams
{
	// The box being solved, in world space: centre and half-extents.
	vec4 Centre;
	vec4 Extents;

	// xyz cells a side, w how many rays each casts.
	vec4 Grid;

	// x how far a ray may travel before it is called a miss; y a counter the
	// directions are hashed against so successive solves of the same cell do
	// not repeat one another.
	vec4 Trace;
} u_Fill;

// A direction on the sphere, uniformly.
//
// Uniform rather than cosine-weighted, and that is the whole reason the
// projection below comes out as simply as it does: a cell has no surface and
// therefore no normal to weight against. It is a point in the air, and light
// reaching it from below matters exactly as much as light from above.
vec3 SphereDirection(inout uint seed)
{
	const float z = GiRandom(seed) * 2.0 - 1.0;
	const float a = GiRandom(seed) * 6.28318531;
	const float r = sqrt(max(1.0 - z * z, 0.0));
	return vec3(r * cos(a), r * sin(a), z);
}

void main()
{
	o_Unused = vec4(0.0);

	const ivec3 grid = ivec3(u_Fill.Grid.xyz + 0.5);
	const int rays = max(int(u_Fill.Grid.w + 0.5), 1);

	// The cell this fragment is: x straight from the column, y and z unstacked
	// from the row.
	const ivec2 pixel = ivec2(gl_FragCoord.xy);
	const ivec3 cell = ivec3(pixel.x, pixel.y % grid.y, pixel.y / grid.y);
	if (cell.x >= grid.x || cell.y >= grid.y || cell.z >= grid.z)
		discard;

	// Where that cell sits in the world. The first and last cells sit *on* the
	// box's faces, which is the convention the sampler's texel-centre mapping
	// is written against -- the two have to agree or the field is offset by
	// half a cell and nothing says so.
	const vec3 t = vec3(cell) / max(vec3(grid) - 1.0, vec3(1.0));
	const vec3 origin = u_Fill.Centre.xyz + (t * 2.0 - 1.0) * u_Fill.Extents.xyz;

	uint seed = GiHash(uint(cell.x) * 73856093u ^ uint(cell.y) * 19349663u
					   ^ uint(cell.z) * 83492791u ^ uint(u_Fill.Trace.y));

	// The constant term is one number a channel; the lean is a *direction* a
	// channel, so it needs three accumulators and not one. Sharing one would
	// store a red wall's lean into green and blue as well.
	vec3 sum = vec3(0.0);
	vec3 leanR = vec3(0.0);
	vec3 leanG = vec3(0.0);
	vec3 leanB = vec3(0.0);

	for (int i = 0; i < rays; i++)
	{
		const vec3 direction = SphereDirection(seed);

		// A cell is a point in the air, so there is no surface to lift off:
		// the normal handed to TraceSurface is the ray's own direction, which
		// makes its offset along that normal a step forward rather than a
		// sideways nudge off a face that does not exist.
		TracedSurface hit = TraceSurface(origin, direction, direction, u_Fill.Trace.x);

		// A miss is the sky, which is a real answer here and not the omission
		// it is inside the bounce: a cell near a window is lit by the window.
		vec3 radiance = hit.Missed ? hit.Sky
								   : ShadeTraced(hit, ProbeIrradiance(hit.Normal, 0.0));

		sum += radiance;
		leanR += radiance.r * direction;
		leanG += radiance.g * direction;
		leanB += radiance.b * direction;
	}

	// **The projection, and it is this short for a reason worth keeping.**
	//
	// Radiance sampled uniformly over the sphere, projected to first-order
	// spherical harmonics, converted to irradiance by the standard band
	// factors, and divided by pi -- because what the shading multiplies by
	// albedo is irradiance over pi, not irradiance. Every constant in that
	// chain cancels:
	//
	//   the Monte Carlo weight is      4*pi/N
	//   the band-0 basis squared is    0.282095^2 = 1/(4*pi)   -> 1/N
	//   the band-1 basis squared is    0.488603^2 = 3/(4*pi)
	//   times the band-1 irradiance factor 2/3                 -> 2/N
	//
	// Checked against the case that has an answer by hand: radiance L from
	// every direction gives sum = N*L and every lean zero, so the constant term
	// is L and there is no lean -- which is what a uniformly lit point should
	// store, and is exactly what stage one's placeholder wrote by hand.
	const float inverse = 1.0 / float(rays);
	const vec3 constantTerm = sum * inverse;
	const float leanScale = 2.0 * inverse;

	// Negative lean is legitimate -- it is what "brighter from that side"
	// means -- and the evaluation clamps the result rather than the
	// coefficients, because nothing here can usefully second-guess a direction.
	imageStore(u_FillR, cell, vec4(constantTerm.r, leanR * leanScale));
	imageStore(u_FillG, cell, vec4(constantTerm.g, leanG * leanScale));
	imageStore(u_FillB, cell, vec4(constantTerm.b, leanB * leanScale));
}
