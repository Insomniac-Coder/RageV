// SSR, pass 2 of 2: sample the hit, blur it by roughness, and hand it on.
//
// Full resolution. The trace wrote, at half resolution, where each pixel's
// reflection landed and how much to trust it; this reads the lit colour
// there -- over a small disc whose radius follows the surface's roughness,
// the v1 stand-in for a GGX lobe a single mirror ray cannot express -- and
// writes the radiance with the confidence in alpha. It does **not** blend
// anything into the lit image: that happens next frame, inside the
// lighting, where the PBR shader swaps the probe's reflected radiance for
// this one under the exact weight the probe would have had. ENGINE-NOTES
// 7ad for the trace, 7af for why the blend moved and for the upsample below.

#type vertex
#version 450 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 450 core

layout(location = 0) in vec2 v_UV;
// RGB: the traced radiance, blurred by roughness. A: confidence, 0..1;
// zero means "no answer -- keep the probe", and the lighting reads it so.
layout(location = 0) out vec4 o_Color;

layout(set = 0, binding = 0) uniform sampler2D u_Scene;
// Half resolution: RG hit uv, B confidence. **Point sampled**, and the
// upsample is done by hand below -- see there for why a filtered read of
// this texture is wrong.
layout(set = 0, binding = 1) uniform sampler2D u_Trace;
// Full resolution: the surface description, for the roughness that sizes
// the blur.
layout(set = 0, binding = 2) uniform sampler2D u_Surface;

layout(push_constant) uniform Params
{
	float TexelX;        // PostParams' shared header: the full frame's texel
	float TexelY;
	float A;
	float B;
	float C;
	float FlipY;
} u_Params;

// A small fixed disc for the roughness blur -- fixed, no dither, so a
// frame reproduces. Radius in pixels at roughness 1.
const int kTaps = 8;
const float kGoldenAngle = 2.39996323;
const float kMaxBlurPixels = 12.0;

// The lit image around one hit, over the roughness disc.
vec3 HitRadiance(vec2 hitUv, float radius, vec2 texel)
{
	vec3 sum = vec3(0.0);
	for (int i = 0; i < kTaps; i++)
	{
		const float t = (float(i) + 0.5) / float(kTaps);
		const float r = sqrt(t) * radius;
		const float theta = float(i) * kGoldenAngle;
		const vec2 offset = vec2(cos(theta), sin(theta)) * r * texel;
		sum += texture(u_Scene, hitUv + offset).rgb;
	}
	return sum / float(kTaps);
}

void main()
{
	const bool flip = u_Params.FlipY > 0.5;
	vec2 uv = vec2(v_UV.x, flip ? 1.0 - v_UV.y : v_UV.y);

	const float roughness = texture(u_Surface, uv).b;
	const vec2 texel = vec2(u_Params.TexelX, u_Params.TexelY);
	const float radius = roughness * roughness * kMaxBlurPixels;

	// The half-resolution trace, upsampled by hand: the four nearest trace
	// texels, each resolved to a radiance at *its own* hit, then blended by
	// the bilinear weights and by confidence.
	//
	// **Not** a filtered read of the trace. A hit uv is a coordinate, and
	// the average of two coordinates is a third place that neither ray went:
	// where a texel with a hit borders one without, a bilinear read of the
	// pair returns three quarters of the hit's uv, which lands wherever
	// three quarters of the way to the corner happens to be -- and if that
	// is something bright, the border pixel gets its colour at a quarter of
	// the confidence. The first version of this pass read the trace
	// filtered, and that is exactly what it did along every reflection's
	// silhouette and at the horizon of a grazing floor: a dash of the
	// block's yellow on the far floor, on one backend only, because the two
	// backends straddle the half-resolution texels at different phases.
	// ENGINE-NOTES 7af. Radiance can be averaged; a place cannot.
	const vec2 traceSize = vec2(textureSize(u_Trace, 0));
	const vec2 tracePixel = uv * traceSize - 0.5;
	const vec2 base = floor(tracePixel);
	const vec2 f = tracePixel - base;

	vec3 radiance = vec3(0.0);
	float weight = 0.0;

	for (int y = 0; y < 2; y++)
	{
		for (int x = 0; x < 2; x++)
		{
			const ivec2 texelIndex = ivec2(clamp(base + vec2(x, y), vec2(0.0), traceSize - 1.0));
			const vec4 trace = texelFetch(u_Trace, texelIndex, 0);
			const float confidence = trace.b;
			if (confidence <= 0.001)
				continue;

			const float w = (x == 0 ? 1.0 - f.x : f.x) * (y == 0 ? 1.0 - f.y : f.y) * confidence;
			if (w <= 0.0)
				continue;

			radiance += HitRadiance(trace.rg, radius, texel) * w;
			weight += w;
		}
	}

	if (weight <= 0.0)
	{
		o_Color = vec4(0.0);
		return;
	}

	// The radiance is the confidence-weighted mean of what the rays found;
	// the confidence is the bilinear mean of theirs -- a border pixel whose
	// neighbours half found something is half trusted, and the probe fills
	// the rest.
	o_Color = vec4(radiance / weight, weight);
}
