// Camera-facing (or flat) textured quads, expanded in the vertex shader from
// per-particle instance data.
//
// Unlit on purpose: a particle is usually a picture of light -- fire, smoke lit
// from within, a magic wisp -- and running it through the PBR pipe would make
// the effect depend on the sun. Tinting is the emitter's job, via the
// per-particle colour the simulation computed.
//
// The same shader serves the CPU and GPU simulations: both leave instances in
// a storage buffer of the same layout, and the draw cannot tell who wrote it.
//
// particle_weighted.rvshader shares the vertex stage and differs only in what
// it writes -- see include/particle_vertex.glsl.

#type vertex
#version 450 core

#include "include/particle_vertex.glsl"

#type fragment
#version 450 core

layout(location = 0) in vec4 v_Color;
layout(location = 1) in vec2 v_UV;

layout(set = 0, binding = 2) uniform sampler2D u_Texture;

layout(location = 0) out vec4 o_Color;

void main()
{
	o_Color = texture(u_Texture, v_UV) * v_Color;
}
