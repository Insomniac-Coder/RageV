// The sky, as one fullscreen triangle at the far plane.
//
// Not a cube. A cube costs six times the vertices to describe the same thing,
// needs its faces inverted so they are seen from inside, and has to be moved
// with the camera every frame -- and none of that buys anything, because what
// is actually wanted is a direction per pixel, which a fullscreen pass gives
// for free by running the clip position backwards through the camera.
//
// Drawn after opaque geometry, with the depth test on and depth writes off, so
// the pixels the scene already covered are rejected before this shader runs.

#type vertex
#version 450 core

layout(location = 0) out vec2 v_NDC;

void main()
{
	vec2 uv = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	v_NDC = uv * 2.0 - 1.0;

	// z = 0 puts every fragment exactly on the far plane. Both backends clip
	// depth to [0, 1] here, and **the far plane is 0 under reverse-Z** -- see
	// RHITypes.h -- which is also what the depth buffer was cleared to. With
	// GreaterOrEqual that means "wherever nothing was drawn", exactly as z = w
	// against LessOrEqual used to.
	gl_Position = vec4(v_NDC, 0.0, 1.0);
}

#type fragment
#version 450 core

const float SKY_GRADIENT = 1.0;
const float SKY_CUBEMAP  = 2.0;

layout(location = 0) in vec2 v_NDC;
layout(location = 0) out vec4 o_Color;
// Where this piece of sky was last frame, in the same units everything else
// writes.
//
// The sky is infinitely far away, so it has no motion of its own -- but it
// sweeps across the screen when the camera turns, and a temporal filter told
// otherwise reprojects it onto itself and smears it. It reported zero for as
// long as it did because the fix does not fit here: the push-constant block
// below is 112 bytes of the 128 every implementation guarantees, and a
// previous view-projection is 64 more. It comes from a uniform buffer
// instead. ENGINE-NOTES 7r.
layout(location = 1) out vec2 o_Velocity;
// The surface-description attachment SSR reads. Zero decodes to "no
// surface", which the resolve reads as "no reflection" -- so this never
// reflects, which is right for what it draws. ENGINE-NOTES 7ad.
layout(location = 2) out vec4 o_Surface;
// The scene target's fourth attachment (ENGINE-NOTES 7av): traced indirect
// diffuse. This pass has none, and writes zero -- an attachment a pipeline
// declares and does not write is undefined, and the resolve reads it as light.
layout(location = 3) out vec4 o_Indirect;


layout(set = 0, binding = 0) uniform samplerCube u_Sky;

layout(push_constant) uniform SkyParams
{
	// Clip space back to a world direction, with the camera's translation
	// already removed and the sky's own rotation already folded in. Doing both
	// on the CPU keeps this shader to one matrix multiply.
	mat4 InvViewRotationProjection;
	vec4 Horizon;   // rgb, a = intensity
	vec4 Zenith;    // rgb, a = mode
	vec4 Ground;    // rgb
} u_Params;

layout(set = 0, binding = 1) uniform SkyMotion
{
	// Direction to clip, last frame, rotation only.
	mat4 PreviousViewRotationProjection;
	// xy = this frame's sub-pixel offset in NDC, zw = last frame's.
	vec4 Jitter;
} u_Motion;

// WR-1's shaped-sky terms. A uniform buffer for the same reason SkyMotion is
// one and not four more push constants: SkyParams above is already 112 of
// the 128 guaranteed bytes.
layout(set = 0, binding = 2) uniform SkyExtra
{
	// x = SkyCurve, y = CityAzimuthK, z = CityElevationK, w unused.
	vec4 Shape;
	vec4 CityGlowColor;   // rgb, a unused
	// xyz normalized, y = 0 (a bearing, not an elevation); w unused.
	vec4 CityDirection;
	// xyz normalized (the world direction the moon stands in), w = its
	// angular radius in radians. Both zero when there is no moon.
	vec4 MoonDirection;
	vec4 MoonColor;       // rgb, a unused
} u_Extra;

void main()
{
	// The sky is not a surface. First and unconditionally, for the reason
	// the PBR fragment writes its velocity first.
	o_Surface = vec4(0.0);
	o_Indirect = vec4(0.0);

	vec4 farPoint = u_Params.InvViewRotationProjection * vec4(v_NDC, 1.0, 1.0);
	vec3 direction = normalize(farPoint.xyz / farPoint.w);

	// This pixel's motion: where the direction it shows sat on screen last
	// frame, differenced against where it sits now.
	//
	// A direction rather than a point, so w = 0 -- which is exactly what a
	// point at infinity is, and is why the matrix needs no translation. The
	// normalize above does not matter here either: scaling a direction scales
	// the whole clip vector, and the perspective divide cancels it.
	//
	// Both terms have a jitter folded in -- this frame's into the matrix that
	// produced `direction`, last frame's into the matrix below -- and both
	// come back out, because a camera dithered by half a pixel has not moved
	// the sky. Same expression as the one in pbr_fragment.glsl, deliberately:
	// the sky and the geometry in front of it have to agree about what a
	// velocity means or the filter sees a discontinuity at every silhouette.
	// **TAA cannot currently see this, and it is here anyway.** Measured on a
	// yawing camera against a supersampled reference: computing this velocity
	// and forcing it to zero produce *byte-identical* frames, and so does
	// forcing it to a wild constant seventy-five pixels long. The reason is
	// the resolve's neighbourhood clip -- a sky is smooth from one pixel to
	// the next, so the 3x3 box around any sky pixel is nearly a point, and
	// history fetched from anywhere at all gets collapsed back onto the
	// current value. The defence was already preventing the smear this was
	// written to fix.
	//
	// It earns its place on 9.5 rather than on 7.10: motion blur reads this
	// same attachment and has **no** neighbourhood clip to save it. A sky
	// reporting no motion is a sky that stays sharp while everything else
	// blurs, which is not subtle. Better a velocity that is right and unused
	// than one that is wrong and waiting.
	vec4 previousClip = u_Motion.PreviousViewRotationProjection * vec4(direction, 0.0);

	if (previousClip.w > 1e-6)
	{
		vec2 previousNDC = previousClip.xy / previousClip.w;
		o_Velocity = ((v_NDC - u_Motion.Jitter.xy)
					- (previousNDC - u_Motion.Jitter.zw)) * 0.5;
	}
	else
	{
		// Behind the camera last frame, so it had no position on screen and
		// there is no history to point at. Zero says "do not reproject",
		// which is what the resolve does with it.
		o_Velocity = vec2(0.0);
	}

	vec3 colour;

	if (u_Params.Zenith.a >= SKY_CUBEMAP - 0.5)
	{
		colour = texture(u_Sky, direction).rgb;
	}
	else
	{
		// Raised to a fractional power so the transition crowds towards the
		// horizon. A linear ramp puts the interesting half of the gradient
		// above the part of the sky anyone is looking at. SkyCurve replaced
		// the fixed 0.45 this used to be (WR-1) -- still the default, so an
		// untouched scene draws the same pow() it always did.
		float height = clamp(abs(direction.y), 0.0, 1.0);
		float t = pow(height, u_Extra.Shape.x);

		colour = direction.y >= 0.0
			? mix(u_Params.Horizon.rgb, u_Params.Zenith.rgb, t)
			: mix(u_Params.Horizon.rgb, u_Params.Ground.rgb, t);

		// The city glow and the moon are both above-horizon-only and additive
		// -- light arriving on top of the gradient, not replacing it.
		if (direction.y >= 0.0)
		{
			// direction.xz is not unit length on its own (some of the length
			// is in y), and a degenerate looking-straight-up ray leaves it
			// exactly zero -- normalize() of that is NaN, silently, so the
			// fallback direction matters even though its azimuth term is
			// killed a line later by (1 - height)^K going to zero.
			float horizontalLength = length(direction.xz);
			vec2 azimuth = horizontalLength > 1e-4
				? direction.xz / horizontalLength : vec2(0.0, 1.0);

			float azimuthTerm = clamp(dot(azimuth, u_Extra.CityDirection.xz), 0.0, 1.0);
			colour += u_Extra.CityGlowColor.rgb
				* pow(azimuthTerm, u_Extra.Shape.y)
				* pow(1.0 - height, u_Extra.Shape.z);

			// The moon: an analytic disc, limb-darkened, additive. A radius of
			// zero (no moon set) can never satisfy `cosAngle > discCosine`
			// because a real direction's cosine similarity to itself tops out
			// at 1.0 and cos(0) is also 1.0 -- so this is inert rather than a
			// special case.
			float cosAngle = dot(direction, u_Extra.MoonDirection.xyz);
			float discCosine = cos(u_Extra.MoonDirection.w);
			if (cosAngle > discCosine)
			{
				float edge = clamp((cosAngle - discCosine) / max(1e-5, 1.0 - discCosine), 0.0, 1.0);
				colour += u_Extra.MoonColor.rgb * sqrt(edge);
			}
		}
	}

	// Linear and unbounded, like every other shader that writes the scene
	// target. The tone curve belongs to the tonemap pass.
	o_Color = vec4(colour * u_Params.Horizon.a, 1.0);
}
