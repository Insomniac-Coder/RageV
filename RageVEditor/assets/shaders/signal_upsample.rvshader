// RT-3.1: a reduced-resolution signal, brought up to the lit pass's grid.
//
// The last stage of any signal the contract filtered at its own resolution --
// the traced bounce and the ambient occlusion both. It was RT-3's *first*
// stage, upsampling before the contract so that the contract's surface tests
// could run on the G-buffer's own grid; RT-3.1 moved the filtering down to the
// signal's resolution, where every real-time denoiser does it, and left this
// pass here as the one cheap full-resolution step at the end.
//
// **A joint bilateral upsample, not a bilinear one.** The four source texels
// around a pixel are weighted by their bilinear weight *and* by how well each
// one's depth agrees with this pixel's, so a tap looking past a silhouette at
// the surface behind gets almost no vote. A plain bilinear upsample of indirect
// light bleeds a bright floor's bounce onto the dark object standing on it, one
// full-resolution texel out from every silhouette in the frame.
//
// **A normal term was tried here and measured out** (RT-3.1). Weighting each
// tap by how nearly it faces the way this pixel does moved the occlusion's
// error against a full-resolution contract from 0.081 levels mean to 0.079,
// left p99 at 2.00, and cost 0.28 ms. The thin lines along beam and pillar
// edges that prompted it are the *contract* validating history on the coarser
// grid, not this pass choosing badly -- and those edges are edges in depth,
// which the term below already sees. Recorded because it is an obvious idea.
//
// **The tap depths are read from the full-resolution depth buffer, not carried
// in the signal.** SSAO's compute writes its own linear depth into the G
// channel of a scalar buffer, which it can afford; this buffer's four channels
// are three of value and one of validity, and there is no fifth. Putting depth
// in the alpha would also arm a trap this codebase has paid for once: the alpha
// of the indirect buffer is read as validity, and a distance in metres arriving
// there measured +6.93 against a correct +1.27 (ENGINE-NOTES 7ay). Four extra
// depth fetches in one pass is the cheaper of the two prices.
//
// The tap is read at the source texel's centre, which is the point the trace
// snapped its own ray origin to and the point the guidance downsample selected
// its surface from -- so all three agree on which full-resolution texel a given
// low-resolution one is about.

#type vertex
#version 450 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 450 core

layout(location = 0) in vec2 v_UV;
layout(location = 0) out vec4 o_Color;

// The signal at its own resolution, as the contract left it: RGB the value
// (albedo-free irradiance for the bounce, a scalar replicated for the
// occlusion), A the frames standing behind it -- zero where the accumulate
// found no surface, which this pass carries through as the validity the lit
// shader reads.
layout(set = 0, binding = 0) uniform sampler2D u_Signal;
// The G-buffer's depth, at this pass's resolution -- read both for this
// pixel's own surface and at each tap's centre.
layout(set = 0, binding = 1) uniform sampler2D u_Depth;

layout(push_constant) uniform Params
{
	float TexelX;        // PostParams' shared header: the source's texel
	float TexelY;
	float A;             // unused
	float NearClip;      // the header's B
	float FarClip;       // the header's C
	float FlipY;
} u_Params;

#include "include/view_reconstruction.glsl"

void main()
{
	const bool flip = u_Params.FlipY > 0.5;
	const vec2 uv = vec2(v_UV.x, flip ? 1.0 - v_UV.y : v_UV.y);

	const vec2 texel = vec2(u_Params.TexelX, u_Params.TexelY);
	const float z = LinearDepth(texture(u_Depth, uv).r,
								u_Params.NearClip, u_Params.FarClip);

	const vec2 f = uv / texel - 0.5;
	const vec2 b = floor(f);
	const vec2 fr = f - b;

	vec3 sum = vec3(0.0);
	float alpha = 0.0;
	float weight = 0.0;
	for (int i = 0; i < 4; i++)
	{
		const vec2 o = vec2(float(i & 1), float(i >> 1));
		const vec2 tapUv = (b + o + 0.5) * texel;
		const vec4 tap = texture(u_Signal, tapUv);

		// The bilinear weight this tap would have had.
		const float bw = mix(1.0 - fr.x, fr.x, o.x) * mix(1.0 - fr.y, fr.y, o.y);
		// And how much it is talking about this surface. Relative to the depth
		// itself, so the tolerance grows with distance the way a depth buffer's
		// own error does; the epsilon stops a tap that agrees exactly from
		// taking the whole vote.
		const float tapZ = LinearDepth(texture(u_Depth, tapUv).r,
									   u_Params.NearClip, u_Params.FarClip);
		const float dw = 1.0 / (1.0e-3 + abs(tapZ - z) / max(z, 1.0e-3));

		sum += tap.rgb * bw * dw;
		alpha += tap.a * bw * dw;
		weight += bw * dw;
	}

	// No tap agreed -- a pixel on a surface the low-resolution buffer never
	// sampled at all. Bilinear is the least-wrong answer there, and it is what
	// this pass did everywhere before there was a depth test in it.
	const vec4 bilinear = texture(u_Signal, uv);
	const vec3 value = weight > 1.0e-6 ? sum / weight : bilinear.rgb;
	const float valid = weight > 1.0e-6 ? alpha / weight : bilinear.a;

	// Negative irradiance is not a thing, and a weighted sum of taps can
	// produce one from a half float's low end; it would darken the surface
	// below unlit.
	o_Color = vec4(max(value, vec3(0.0)), max(valid, 0.0));
}
