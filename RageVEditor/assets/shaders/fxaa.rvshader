// FXAA 3.11, the quality path, condensed.
//
// Runs on the tone-mapped image, not the linear one. FXAA finds edges by
// comparing perceived brightness, and perceived brightness is what the transfer
// function produces -- run on linear values it misses edges in dark regions and
// over-blurs bright ones.
//
// Why this one first, of the three obvious choices:
//
//   - **FXAA** is one pass over one texture and nothing else. No history, no
//     extra buffers, no prerequisites. It softens the image slightly, which is
//     its well-known cost.
//   - **SMAA** is sharper for the same idea, and needs two precomputed lookup
//     textures and three passes.
//   - **TAA** is better than either and needs motion vectors, which means every
//     mesh carrying its previous transform and the renderer writing a velocity
//     target. That is a renderer feature, not a post pass.
//
// See docs/ENGINE-NOTES.md section 5.

#type vertex
#version 450 core

layout(location = 0) out vec2 v_UV;

void main()
{
	v_UV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	gl_Position = vec4(v_UV * 2.0 - 1.0, 0.0, 1.0);
}

#type fragment
#version 450 core

layout(location = 0) in vec2 v_UV;
layout(location = 0) out vec4 o_Color;

layout(set = 0, binding = 0) uniform sampler2D u_Source;

layout(push_constant) uniform Params
{
	vec2  TexelSize;
	// Below this contrast, an edge is not worth touching. Too low and flat
	// areas get softened for nothing.
	float ContrastThreshold;
	// Absolute floor, so near-black areas -- where contrast is tiny but banding
	// is most visible -- are left alone rather than smeared.
	float RelativeThreshold;
} u_Params;

// Perceived brightness. The green channel alone is the usual approximation and
// is what the reference implementation uses; the eye takes most of its
// luminance from green, and sampling one channel costs nothing.
float Luma(vec3 color)
{
	return dot(color, vec3(0.299, 0.587, 0.114));
}

void main()
{
	vec2 texel = u_Params.TexelSize;

	vec3 middle = texture(u_Source, v_UV).rgb;

	float lumaM = Luma(middle);
	float lumaN = Luma(texture(u_Source, v_UV + vec2(0.0, -texel.y)).rgb);
	float lumaS = Luma(texture(u_Source, v_UV + vec2(0.0,  texel.y)).rgb);
	float lumaW = Luma(texture(u_Source, v_UV + vec2(-texel.x, 0.0)).rgb);
	float lumaE = Luma(texture(u_Source, v_UV + vec2( texel.x, 0.0)).rgb);

	float lumaMin = min(lumaM, min(min(lumaN, lumaS), min(lumaW, lumaE)));
	float lumaMax = max(lumaM, max(max(lumaN, lumaS), max(lumaW, lumaE)));
	float range = lumaMax - lumaMin;

	// Flat enough to leave alone. This early out is most of why FXAA is cheap:
	// most of a frame is not an edge.
	if (range < max(u_Params.ContrastThreshold, lumaMax * u_Params.RelativeThreshold))
	{
		o_Color = vec4(middle, 1.0);
		return;
	}

	// The diagonal neighbours, needed to tell a horizontal edge from a vertical
	// one and to weight the blend.
	float lumaNW = Luma(texture(u_Source, v_UV + vec2(-texel.x, -texel.y)).rgb);
	float lumaNE = Luma(texture(u_Source, v_UV + vec2( texel.x, -texel.y)).rgb);
	float lumaSW = Luma(texture(u_Source, v_UV + vec2(-texel.x,  texel.y)).rgb);
	float lumaSE = Luma(texture(u_Source, v_UV + vec2( texel.x,  texel.y)).rgb);

	float edgeHorizontal =
		abs(lumaNW - 2.0 * lumaN + lumaNE) +
		abs(lumaW  - 2.0 * lumaM + lumaE ) * 2.0 +
		abs(lumaSW - 2.0 * lumaS + lumaSE);

	float edgeVertical =
		abs(lumaNW - 2.0 * lumaW + lumaSW) +
		abs(lumaN  - 2.0 * lumaM + lumaS ) * 2.0 +
		abs(lumaNE - 2.0 * lumaE + lumaSE);

	bool horizontal = edgeHorizontal >= edgeVertical;

	// Step perpendicular to the edge, towards whichever side is more different.
	float luma1 = horizontal ? lumaN : lumaW;
	float luma2 = horizontal ? lumaS : lumaE;

	float gradient1 = abs(luma1 - lumaM);
	float gradient2 = abs(luma2 - lumaM);

	float stepLength = horizontal ? texel.y : texel.x;
	if (gradient1 < gradient2)
		stepLength = -stepLength;

	// Subpixel blending: how much this pixel differs from the average of its
	// neighbours, which is what catches single-pixel detail that edge-walking
	// alone leaves crawling.
	float average = (2.0 * (lumaN + lumaS + lumaW + lumaE) +
					 lumaNW + lumaNE + lumaSW + lumaSE) / 12.0;

	float subpixel = clamp(abs(average - lumaM) / max(range, 1e-5), 0.0, 1.0);
	subpixel = smoothstep(0.0, 1.0, subpixel);
	subpixel = subpixel * subpixel * 0.75;

	vec2 offset = horizontal ? vec2(0.0, stepLength * 0.5)
							 : vec2(stepLength * 0.5, 0.0);

	vec3 blended = texture(u_Source, v_UV + offset).rgb;

	o_Color = vec4(mix(middle, blended, subpixel), 1.0);
}
